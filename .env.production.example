# Copy to .env.production (ignored by git). Never commit real values.
# These are Worker RUNTIME variables/secrets, not frontend/build credentials.
SINALOA_PUBLIC_URL=https://www.envoi-agents.com
SINALOA_CORS_ORIGIN=https://www.envoi-agents.com,https://beta.sinaloa-inbox.com,https://sinaloa-inbox.com,https://www.sinaloa-inbox.com
SINALOA_EDGE_ALLOWED_HOSTS=www.envoi-agents.com,beta.sinaloa-inbox.com
SINALOA_AGENT_DOMAIN=agents.envoi-agents.com
DATABASE_URL=
SINALOA_DB_SSL_MODE=verify-full
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=https://www.envoi-agents.com/api/auth/workos/callback
SINALOA_BETA_INVITED_EMAILS=
SINALOA_DATA_ENCRYPTION_KEY=
SINALOA_POLICY_ACTIVE_KEY_ID=primary
SINALOA_POLICY_SIGNING_KEY=
SINALOA_OBJECT_STORAGE_PROVIDER=s3
SINALOA_S3_ENDPOINT=
SINALOA_S3_BUCKET=
SINALOA_S3_REGION=auto
SINALOA_S3_ACCESS_KEY_ID=
SINALOA_S3_SECRET_ACCESS_KEY=
SINALOA_MALWARE_SCANNER_URL=
# Optional override; default GET /health on scanner origin must return {"ready":true}.
SINALOA_MALWARE_SCANNER_HEALTH_URL=
# Required in production; must match the scanner Worker secret SINALOA_SCANNER_TOKEN.
SINALOA_MALWARE_SCANNER_TOKEN=
SINALOA_ENABLE_EXTERNAL_EMAIL=false
SINALOA_ENABLE_CALENDAR_WRITES=false
SINALOA_ENABLE_CONSEQUENTIAL_ACTIONS=false

# Optional for legacy staging; scripts/promote-release.mjs supplies the recorded commit SHA.
# SINALOA_RELEASE_SHA=
