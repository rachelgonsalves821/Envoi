# Copy to .env.production (ignored by git). Never commit real values.
# These are Worker RUNTIME variables/secrets, not frontend/build credentials.
ENVOI_PUBLIC_URL=https://www.envoi-agents.com
ENVOI_CORS_ORIGIN=https://www.envoi-agents.com
ENVOI_EDGE_ALLOWED_HOSTS=www.envoi-agents.com
ENVOI_AGENT_DOMAIN=agents.envoi-agents.com
DATABASE_URL=
ENVOI_DB_SSL_MODE=verify-full
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=https://www.envoi-agents.com/api/auth/workos/callback
ENVOI_BETA_INVITED_EMAILS=
ENVOI_DATA_ENCRYPTION_KEY=
ENVOI_POLICY_ACTIVE_KEY_ID=primary
ENVOI_POLICY_SIGNING_KEY=
ENVOI_OBJECT_STORAGE_PROVIDER=s3
ENVOI_S3_ENDPOINT=
ENVOI_S3_BUCKET=
ENVOI_S3_REGION=auto
ENVOI_S3_ACCESS_KEY_ID=
ENVOI_S3_SECRET_ACCESS_KEY=
ENVOI_MALWARE_SCANNER_URL=
# Optional override; default GET /health on scanner origin must return {"ready":true}.
ENVOI_MALWARE_SCANNER_HEALTH_URL=
# Required in production; must match the scanner Worker secret ENVOI_SCANNER_TOKEN.
ENVOI_MALWARE_SCANNER_TOKEN=
ENVOI_ENABLE_EXTERNAL_EMAIL=false
ENVOI_ENABLE_CALENDAR_WRITES=false
ENVOI_ENABLE_CONSEQUENTIAL_ACTIONS=false

# Optional for legacy staging; scripts/promote-release.mjs supplies the recorded commit SHA.
# ENVOI_RELEASE_SHA=
