<fieldset class="theme-switch" data-theme-control hidden>
  <legend class="visually-hidden">Color theme</legend>
  {['light', 'dark', 'system'].map(preference => <label title={preference[0].toUpperCase() + preference.slice(1)}><input type="radio" name="color-theme" value={preference} aria-label={preference[0].toUpperCase() + preference.slice(1)} data-theme-choice checked={preference === 'system'} /><span><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{preference === 'light' ? <><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" /></> : preference === 'dark' ? <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z" fill="currentColor" stroke="none" /> : <><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8m-4-4v4" /></>}</svg></span></label>)}
</fieldset>
