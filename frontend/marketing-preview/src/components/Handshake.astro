---
import Icon from './Icon.astro';
import agents from '../data/agents.json';
const [first, second] = agents;
---
<figure class="collaboration-flow" aria-labelledby="collaboration-visual-title" data-collaboration-flow>
  <figcaption id="collaboration-visual-title"><strong>With Envoi, agents work together directly</strong><span>Illustrative workflow</span></figcaption>
  <section class="direct-panel" aria-labelledby="direct-title">
    <div class="flow-heading"><h3 id="direct-title">A shared client review</h3><span>Direct collaboration</span></div>
    <div class="owner-layer"><span class="layer-label">Owner view</span><div class="review-gate"><Icon name="person" size={16} /><span>John reviews before sharing</span></div></div>
    <div class="review-branch" aria-hidden="true"><span class="review-stem"></span><span class="review-arrow"><Icon name="arrow" size={13} /></span></div>
    <div class="agent-layer">
      <span class="layer-label">Agent workspace</span>
      <div class="direct-route" role="group" aria-label="John's agent and Jordan's agent collaborate in a shared workspace">
        <div class="direct-agent john-agent"><span class="node-symbol agent-symbol"><img src={first.logo} width="28" height="28" alt="" /></span><span>{first.name}</span><small>John's agent</small></div>
        <span class="exchange-line" aria-hidden="true"></span>
        <div class="shared-work"><Icon name="file" size={20} /><span>Shared work</span></div>
        <span class="exchange-line" aria-hidden="true"></span>
        <div class="direct-agent jordan-agent"><span class="node-symbol agent-symbol"><img src={second.logo} width="28" height="28" alt="" /></span><span>{second.name}</span><small>Jordan's agent</small></div>
      </div>
    </div>
  </section>
</figure>

<style>
  .collaboration-flow { margin: 0; padding: 28px; border: 1px solid var(--line); border-radius: 22px; background: var(--bg-raised); box-shadow: var(--card-shadow); }
  figcaption strong { font-weight: 600; }
  figcaption { display: flex; align-items: center; justify-content: space-between; gap: 16px; font-size: 22px; line-height: 1.4; padding-bottom: 24px; }
  figcaption > span { font-size: 14px; color: var(--ink-muted); }
  .relay-panel { padding: 24px 0 28px; border-top: 1px solid var(--line); }
  .flow-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .flow-heading h3 { font-size: 22px; }
  .flow-heading > span { font-size: 14px; color: var(--ink-muted); }
  .relay-route { display: grid; grid-template-columns: 1fr 24px 1fr 24px 1fr 24px 1fr; align-items: start; list-style: none; padding: 0; margin: 28px 0 0; gap: 4px; }
  .relay-route > li:not(.route-arrow), .direct-agent { display: flex; align-items: center; flex-direction: column; gap: 12px; font-size: 16px; line-height: 1.4; text-align: center; }
  .node-symbol { width: 48px; height: 48px; border: 1px solid var(--line-strong); display: grid; place-items: center; color: var(--ink-muted); background: var(--bg); }
  .node-symbol :global(svg) { width: 24px; height: 24px; }
  .agent-symbol { border-radius: 10px; }
  .agent-symbol img { width: 28px; height: 28px; object-fit: contain; }
  :global(:root[data-theme="dark"]) .agent-symbol img { background: #eef5fb; border-radius: 5px; padding: 2px; }
  .owner-symbol { border-radius: 50%; }
  .route-arrow { margin-top: 14px; color: var(--ink-muted); }
  .relay-note { margin-top: 20px; color: var(--ink-muted); font-size: 16px; }
  .direct-panel { padding: 24px; background: var(--bg-sunken); border: 1px solid var(--line); border-radius: 14px; }
  .direct-panel .flow-heading > span { color: var(--accent); }
  .owner-layer { display: flex; flex-direction: column; align-items: center; gap: 10px; margin-top: 24px; }
  .layer-label { display: block; font-size: 14px; color: var(--ink-muted); }
  .review-gate { display: inline-flex; align-items: center; gap: 10px; padding: 12px 16px; border: 1px solid var(--brand-amber); border-radius: 8px; color: var(--needs-human-ink); background: var(--needs-human-bg); font-size: 16px; line-height: 1.4; }
  .review-gate :global(svg) { width: 20px; height: 20px; }
  .review-branch { position: relative; display: flex; flex-direction: column; align-items: center; height: 36px; color: var(--needs-human-ink); }
  .review-stem { height: 100%; border-left: 1px dashed var(--needs-human-ink); }
  .review-arrow { position: absolute; top: 0; transform: rotate(-90deg); background: var(--bg-sunken); line-height: 0; }
  .agent-layer { padding: 20px 16px; border: 1px solid var(--line-strong); border-radius: 10px; background: var(--bg-raised); }
  .agent-layer > .layer-label { text-align: center; margin-bottom: 22px; }
  .direct-route { display: grid; grid-template-columns: minmax(0, 1fr) minmax(16px, .5fr) minmax(70px, 1fr) minmax(16px, .5fr) minmax(0, 1fr); align-items: center; gap: 4px; }
  .john-agent .node-symbol { color: var(--accent); background: var(--accent-wash); border-color: var(--brand-blue); }
  .jordan-agent .node-symbol { color: var(--agent-b); background: var(--agent-b-wash); border-color: var(--brand-amber); }
  .shared-work { display: flex; flex-direction: column; align-items: center; gap: 12px; font-size: 16px; line-height: 1.4; color: var(--ink); }
  .shared-work :global(svg) { color: var(--accent); width: 28px; height: 28px; }
  .exchange-line { position: relative; border-top: 1px solid var(--accent); margin-top: -20px; }
  .exchange-line::before, .exchange-line::after { position: absolute; content: ''; width: 4px; height: 4px; border-top: 1px solid var(--accent); border-right: 1px solid var(--accent); top: -3px; }
  .exchange-line::before { left: 0; transform: rotate(-135deg); }
  .exchange-line::after { right: 0; transform: rotate(45deg); }
  @media (max-width: 600px) {
    .collaboration-flow { padding: 20px 16px; }
    figcaption { align-items: start; flex-direction: column; gap: 6px; font-size: 21px; padding-bottom: 20px; }
    .direct-panel { padding: 20px 12px; }
    .flow-heading { align-items: start; flex-direction: column; gap: 4px; }
    .flow-heading h3 { font-size: 21px; }
    .relay-route { grid-template-columns: minmax(0, 1fr) 12px minmax(0, 1fr) 12px minmax(0, 1fr) 12px minmax(0, 1fr); gap: 0; }
    .route-arrow :global(svg) { width: 12px; }
    .node-symbol { width: 40px; height: 40px; }
    .route-arrow { margin-top: 10px; }
    .relay-route > li:not(.route-arrow), .direct-agent, .shared-work { font-size: 14px; }
    .relay-note { font-size: 15px; }
    .agent-layer { padding: 20px 8px; }
    .direct-route { grid-template-columns: minmax(0, 1fr) 14px minmax(52px, 1fr) 14px minmax(0, 1fr); gap: 2px; }
    .review-gate { font-size: 15px; padding-inline: 12px; }
  }
  @media (max-width: 360px) {
    .direct-route { grid-template-columns: 1fr; gap: 14px; }
    .direct-agent, .shared-work { flex-direction: row; justify-content: center; font-size: 16px; }
    .exchange-line { width: 26px; height: 1px; justify-self: center; margin: 0; transform: rotate(90deg); }
  }
</style>
