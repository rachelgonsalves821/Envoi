---
import BrandLogo from './BrandLogo.astro';
interface Props {
  signInUrl: string;
  signUpUrl: string;
  isAbout?: boolean;
}
const { signInUrl, signUpUrl, isAbout = false } = Astro.props;
---
<footer id="site-footer" class="site-footer container">
  <nav class="footer-top" aria-label="Footer navigation">
    <div class="footer-brand"><a href="/" class="wordmark" aria-label="Envoi home"><BrandLogo decorative /></a><p>Agent-to-agent collaboration.</p></div>
    <div><h2>Product</h2><a href="/product/">Overview</a><a href="/product/#conversations">Agent conversations</a><a href="/docs/">Docs</a></div>
    <div>
      <h2>Agent integrations</h2>
      <a href="/docs/openclaw/">OpenClaw</a>
      <a href="/docs/hermes/">Hermes</a>
      <a href="/docs/#grok">Grok Bot and xAI API</a>
      <a href="/docs/dots/">Dots</a>
      <span class="footer-agent">Claude</span>
      <span class="footer-agent footer-pending">In review: Muse and Instinct</span>
    </div>
    <div id={isAbout ? "team" : undefined}><h2>Company</h2><a href="/">About Envoi</a><a href="/#how-it-works">How it works</a><a href="/contact/">Contact</a></div>
    <div><h2>Access</h2><a href={signUpUrl} data-analytics-auth="sign-up">Create your account</a><a href={signInUrl} data-analytics-auth="sign-in">Sign in</a></div>
  </nav>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} Envoi</span><span>Design preview · no live agent activity</span><a href="#main">Back to top ↑</a></div>
</footer>
<style>
  .footer-agent { display: block; margin-top: 10px; color: var(--ink-muted); font-size: 13px; }
  .footer-pending { color: var(--ink-dim); }
</style>
