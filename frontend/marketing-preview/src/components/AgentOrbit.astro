---
import agents from '../data/agents.json';
interface Props { ambient?: boolean; }
const { ambient = false } = Astro.props;
---
{ambient ? (
  <div class="ambient-agents">
    {agents.map((agent, index) => <div class={`ambient-agent ambient-agent-${index + 1}`}><span class="agent-tile"><img src={agent.logo} width="32" height="32" alt="" /></span><span class="agent-label">{agent.name}</span></div>)}
  </div>
) : (
  <section class="agent-orbit" aria-labelledby="orbit-title">
    <div class="orbit-caption">Agent ecosystem <span>Integration previews</span></div>
    <div class="orbit-stage">
      <div class="orbit-halo" aria-hidden="true"></div>
      <div class="orbit-ring" aria-hidden="true">
        {agents.map((agent, index) => <div class={`orbit-position orbit-position-${index + 1}`}><div class="orbit-agent"><span class="agent-tile"><img src={agent.logo} width="42" height="42" alt="" /></span><span class="agent-label">{agent.name}</span></div></div>)}
      </div>
      <div class="orbit-center"><h2 id="orbit-title">Connect the agents your team already uses</h2><a href="#join">Join the waitlist <span aria-hidden="true">↗</span></a></div>
    </div>
    <ul class="visually-hidden" aria-label="Example agent platforms">{agents.map(agent => <li>{agent.name}, integration preview</li>)}</ul>
  </section>
)}
<style>
  .agent-tile { display: grid; place-items: center; width: 76px; height: 76px; border: 1px solid var(--line); border-radius: 20px; background: var(--bg-raised); box-shadow: 0 14px 28px -17px var(--shadow-ink), 0 2px 6px rgba(15,42,67,.08); }
  .agent-tile img { width: 42px; height: 42px; object-fit: contain; }
  :global(:root[data-theme="dark"]) .agent-tile img { background: #eef5fb; border-radius: 8px; padding: 3px; }
  .agent-label { margin-top: 8px; color: var(--ink-muted); font-size: 14px; line-height: 1.2; text-align: center; }
  .agent-orbit { max-width: 1040px; margin: 0 auto; padding: 28px 0 4px; text-align: center; }
  .orbit-caption { color: var(--accent); font-size: 12px; letter-spacing: .13em; text-transform: uppercase; }
  .orbit-caption span { display: block; margin-top: 5px; color: var(--ink-dim); font-size: 11px; letter-spacing: .04em; text-transform: none; }
  .orbit-stage { position: relative; height: 540px; display: grid; place-items: center; isolation: isolate; overflow: hidden; }
  .orbit-halo { position: absolute; inset: 8% 12%; z-index: -1; border-radius: 50%; background: radial-gradient(ellipse at center, rgba(47,134,198,.13), rgba(242,163,58,.09) 35%, transparent 68%); filter: blur(20px); }
  .orbit-ring { position: absolute; width: min(72vw, 680px); height: 380px; border: 1px dashed var(--line-strong); border-radius: 50%; }
  .orbit-position { position: absolute; }
  .orbit-position-1 { top: -34px; left: calc(50% - 38px); }
  .orbit-position-2 { top: calc(50% - 45px); right: -35px; }
  .orbit-position-3 { bottom: -34px; left: calc(50% - 38px); }
  .orbit-position-4 { top: calc(50% - 45px); left: -35px; }
  .orbit-agent { display: flex; align-items: center; flex-direction: column; min-width: 76px; }
  .orbit-center { position: relative; z-index: 2; width: min(440px, 52%); padding: 32px; border: 1px solid var(--line); border-radius: 24px; background: var(--bg-raised); box-shadow: 0 20px 55px -32px var(--shadow-ink); }
  .orbit-center h2 { font-size: clamp(28px, 3.2vw, 42px); line-height: 1.14; letter-spacing: -.035em; }
  .orbit-center a { display: inline-flex; align-items: center; gap: 12px; margin-top: 22px; padding: 10px 17px; border-radius: var(--pill); background: var(--action-bg); color: var(--action-ink); font-size: 14px; }
  .orbit-center a:hover { filter: brightness(1.08); }
  .ambient-agents { position: absolute; inset: 0; pointer-events: none; }
  .ambient-agent { position: absolute; display: flex; flex-direction: column; align-items: center; opacity: .58; }
  .ambient-agent .agent-tile { width: 60px; height: 60px; border-radius: 18px; }
  .ambient-agent .agent-tile img { width: 30px; height: 30px; }
  .ambient-agent .agent-label { font-size: 12px; }
  .ambient-agent-1 { left: 6%; top: 14%; }
  .ambient-agent-2 { right: 10%; top: 8%; }
  .ambient-agent-3 { left: 14%; bottom: 11%; }
  .ambient-agent-4 { right: 7%; bottom: 18%; }
  @media (prefers-reduced-motion: no-preference) {
    .orbit-ring { animation: orbit-turn 90s linear infinite; }
    .orbit-agent { animation: orbit-counterturn 90s linear infinite; }
    .ambient-agent { animation: ambient-drift 20s ease-in-out infinite alternate; }
    .ambient-agent-2 { animation-delay: -7s; }
    .ambient-agent-3 { animation-delay: -13s; }
    .ambient-agent-4 { animation-delay: -4s; }
    :global(body.page-hidden) .orbit-ring, :global(body.page-hidden) .orbit-agent, :global(body.page-hidden) .ambient-agent { animation-play-state: paused; }
    @keyframes orbit-turn { to { transform: rotate(360deg); } }
    @keyframes orbit-counterturn { to { transform: rotate(-360deg); } }
    @keyframes ambient-drift { to { transform: translate(18px, -22px); } }
  }
  @media (max-width: 680px) {
    .agent-orbit { padding-top: 10px; }
    .orbit-stage { height: 440px; }
    .orbit-ring { width: min(84vw, 390px); height: 295px; }
    .orbit-center { width: min(65%, 280px); padding: 22px 16px; }
    .orbit-center h2 { font-size: clamp(21px, 5vw, 29px); }
    .orbit-center a { margin-top: 14px; font-size: 12px; padding: 8px 12px; }
    .agent-tile { width: 56px; height: 56px; border-radius: 16px; }
    .agent-tile img { width: 30px; height: 30px; }
    .orbit-agent { min-width: 56px; }
    .orbit-position-1, .orbit-position-3 { left: calc(50% - 28px); }
    .orbit-position-2 { right: -20px; }
    .orbit-position-4 { left: -20px; }
    .orbit-position-2, .orbit-position-4 { top: calc(50% - 34px); }
    .agent-label { font-size: 12px; }
    .ambient-agent-2, .ambient-agent-3 { display: none; }
    .ambient-agent-1 { left: 3%; top: 18%; }
    .ambient-agent-4 { right: 3%; bottom: 13%; }
    .ambient-agent .agent-tile { width: 42px; height: 42px; }
    .ambient-agent .agent-tile img { width: 24px; height: 24px; }
  }
  @media (prefers-reduced-motion: reduce) { .orbit-ring { border-style: solid; } }
</style>
