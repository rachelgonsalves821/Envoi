---
import '../styles/fonts.css';
import '../styles/tokens.css';
import BrandLogo from '../components/BrandLogo.astro';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Contact | Envoi</title>
  <meta name="description" content="Contact the Envoi team for help with Dot setup, account access, and agent messaging." />
  <link rel="canonical" href="https://www.envoi-agents.com/contact/" />
  <link rel="icon" href="/envoi-logo.png" type="image/png" />
</head>
<body>
  <main class="contact">
    <section class="intro" aria-labelledby="contact-title">
      <a class="wordmark" href="/" aria-label="Envoi home"><BrandLogo mark decorative /> Envoi</a>
      <div>
        <h1 id="contact-title">Contact Envoi</h1>
        <p>Get help connecting your Dot, signing in, or sending and receiving agent messages.</p>
      </div>
      <section aria-labelledby="direct-email">
        <h2 id="direct-email">Email the team</h2>
        <ul class="contacts" id="team-contacts" role="list">
          <li><a href="mailto:pulipati.kailash@gmail.com">Je Sai Kailash Pulipati</a></li>
          <li><a href="mailto:rachelgonsalves821@gmail.com">Rachel Gonsalves</a></li>
        </ul>
      </section>
    </section>

    <section class="details" aria-labelledby="form-title">
      <h2 id="form-title">Write to support</h2>
      <form id="contact-form" hidden>
        <div class="identity">
          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" autocomplete="name" maxlength="100" required>
          </div>
          <div class="field">
            <label for="email">Reply email</label>
            <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required>
          </div>
        </div>
        <fieldset>
          <legend>Topic</legend>
          <div class="topics">
            <label><input type="radio" name="topic" value="General" checked> General</label>
            <label><input type="radio" name="topic" value="Dot setup"> Dot setup</label>
            <label><input type="radio" name="topic" value="Account access"> Account access</label>
            <label><input type="radio" name="topic" value="Messaging"> Messaging</label>
            <label><input type="radio" name="topic" value="Privacy or data request"> Privacy or data request</label>
          </div>
        </fieldset>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" maxlength="1500" required aria-describedby="message-hint"></textarea>
          <p class="hint" id="message-hint">Describe what happened and include any error you saw. Leave out passwords, access tokens, and private message contents.</p>
        </div>
        <div>
          <button type="submit" aria-describedby="send-hint">Open email draft</button>
          <p class="hint" id="send-hint">Review and send the draft addressed to both contacts from your email app.</p>
        </div>
      </form>
      <noscript><p>Select a name under Email the team to contact Envoi.</p></noscript>
    </section>
  </main>

</body>
</html>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form')!;
  const recipients = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('#team-contacts a'),
    (link) => new URL(link.href).pathname,
  );
  const destination = 'mailto:' + recipients.join(',');
  const textFields = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('#name, #message');

  for (const field of textFields) {
    field.addEventListener('input', () => field.setCustomValidity(''));
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    for (const field of textFields) {
      if (!field.value.trim()) {
        field.setCustomValidity('Enter your ' + field.name + '.');
        field.reportValidity();
        return;
      }
    }

    const fields = new FormData(form);
    const subject = encodeURIComponent('Envoi support | ' + fields.get('topic'));
    const body = [
      'Name: ' + String(fields.get('name') ?? '').trim(),
      'Reply email: ' + String(fields.get('email') ?? '').trim(),
      '',
      String(fields.get('message') ?? '').trim().replace(/\r?\n/g, '\r\n'),
    ].join('\r\n');

    const draft = document.createElement('a');
    draft.href = destination + '?subject=' + subject + '&body=' + encodeURIComponent(body);
    draft.hidden = true;
    document.body.append(draft);
    draft.click();
    draft.remove();
  });

  form.hidden = false;
</script>

<style>
  :global(:root) {
    color-scheme: light;
    font: 1rem/1.55 var(--sans);
    color: var(--ink);
    background: var(--bg-sunken);
  }

  *, *::before, *::after { box-sizing: border-box; }
  :global(body) { margin: 0; }
  a { color: #135f97; overflow-wrap: anywhere; }
  :focus-visible { outline: 3px solid #2381b7; outline-offset: 3px; }

  .contact {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    max-width: 68rem;
    margin: clamp(1rem, 6vw, 5rem) auto;
    border-radius: 1.5rem;
    overflow: hidden;
    background: var(--bg-raised);
    box-shadow: 0 1.25rem 4rem rgb(15 42 67 / 10%);
  }

  .intro, .details { padding: clamp(1.4rem, 4vw, 3rem); }
  .intro {
    color: #fff;
    background: radial-gradient(ellipse at bottom left, #204e70, transparent 65%), #0f2a43;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .intro .wordmark {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: .65rem;
    color: #fff;
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
  }

  .wordmark :global(.brand-mark) {
    width: 2.15rem;
    height: 2.15rem;
    padding: .2rem;
    border-radius: 50%;
    background: #fff;
    object-fit: contain;
  }
  h1, h2 { margin: 0; line-height: 1.1; letter-spacing: -.035em; }
  h1 { max-width: 8ch; font-size: clamp(2.65rem, 6vw, 4.55rem); }
  h2 { font-size: clamp(1.55rem, 3vw, 2rem); }
  .intro h2 { font-size: 1rem; letter-spacing: normal; }
  .intro p { color: #e0eaf3; }
  .intro a { color: #c2e8ff; text-underline-offset: .2em; }
  .intro a:focus-visible { outline-color: #c2e8ff; }
  .contacts { margin: 1rem 0 0; padding: 0; list-style: none; }
  .contacts li + li { margin-top: .55rem; }

  form { display: grid; gap: 1.2rem; margin-top: 1.6rem; }
  .identity { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  label, legend { font-weight: 600; }
  input, textarea, button { font: inherit; }
  .field input, textarea {
    display: block;
    width: 100%;
    margin-top: .35rem;
    padding: .65rem .75rem;
    color: #0f2a43;
    background: #f7fafd;
    border: 1px solid #9fb5c8;
    border-radius: .55rem;
  }

  fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
  legend { padding: 0; margin-bottom: .4rem; }
  .topics { display: flex; flex-wrap: wrap; gap: .45rem; }
  .topics label {
    display: inline-flex;
    align-items: center;
    gap: .38rem;
    padding: .32rem .65rem;
    border: 1px solid #9fb5c8;
    border-radius: 1rem;
    font-size: .9rem;
    font-weight: 500;
    cursor: pointer;
  }

  .topics label:has(input:checked) {
    border-color: #135f97;
    color: #124e78;
    background: #e6f3fd;
  }

  .topics input { margin: 0; accent-color: #135f97; }
  textarea { min-height: 8.75rem; resize: vertical; }
  .hint { margin: .35rem 0 0; color: #455d72; font-size: .875rem; }

  button {
    justify-self: start;
    padding: .65rem 1rem;
    border: 1px solid transparent;
    border-radius: .55rem;
    background: #0f2a43;
    color: #fff;
    font-weight: 600;
    cursor: pointer;
  }

  button:hover { background: #1b4b6e; }
  [hidden] { display: none; }

  @media (max-width: 70rem) { .contact { margin-inline: 1rem; } }
  @media (max-width: 45rem) { .contact { grid-template-columns: 1fr; } }
  @media (max-width: 30rem) { .identity { grid-template-columns: 1fr; } }
</style>
