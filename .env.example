SINALOA_HOST=127.0.0.1
SINALOA_PORT=8787
SINALOA_DATA_DIR=./data
SINALOA_CORS_ORIGIN=http://localhost:3000
SINALOA_MAX_BODY_BYTES=10485760
DATABASE_URL=
SINALOA_DB_POOL_SIZE=10
SINALOA_DB_SSL=false
SINALOA_DB_SSL_MODE=disable
SINALOA_DB_CA=
SINALOA_DB_CONNECT_TIMEOUT_MS=10000
SINALOA_DB_STATEMENT_TIMEOUT_MS=30000
SINALOA_DB_QUERY_TIMEOUT_MS=30000
SINALOA_DELIVERY_MAX_ATTEMPTS=5
SINALOA_DELIVERY_POLL_MS=250
SINALOA_DELIVERY_LEASE_MS=30000
SINALOA_DELIVERY_RETRY_BASE_MS=1000
SINALOA_DELIVERY_RETRY_MAX_MS=60000
SINALOA_REQUEST_TIMEOUT_MS=30000
SINALOA_READINESS_TIMEOUT_MS=5000
SINALOA_MAX_SSE_PER_PRINCIPAL=10
SINALOA_AGENT_DOMAIN=sinaloa.mail
SINALOA_AGENT_ACCESS_TOKEN_TTL_SECONDS=900
SINALOA_AGENT_REFRESH_TOKEN_TTL_DAYS=30
# Public email transport. sinaloa.mail remains an internal identity domain because .mail is not delegated publicly.
SINALOA_ENABLE_EXTERNAL_EMAIL=false
SINALOA_EMAIL_PROVIDER=disabled
SINALOA_PUBLIC_EMAIL_DOMAIN=
SINALOA_EMAIL_DOMAIN_VERIFIED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_API_BASE_URL=
SINALOA_EXTERNAL_EMAIL_AGENT_HOURLY_LIMIT=100
SINALOA_EXTERNAL_EMAIL_RECIPIENT_HOURLY_LIMIT=20
SINALOA_ENABLE_CALENDAR_WRITES=false
SINALOA_ENABLE_CONSEQUENTIAL_ACTIONS=false
# Production object storage and scanning
SINALOA_OBJECT_STORAGE_PROVIDER=local
SINALOA_OBJECT_MAX_BYTES=26214400
SINALOA_WORKSPACE_OBJECT_QUOTA_BYTES=1073741824
SINALOA_OBJECT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,text/plain,text/csv,application/json
SINALOA_S3_ENDPOINT=
SINALOA_S3_BUCKET=
SINALOA_S3_REGION=ca-central-1
SINALOA_S3_ACCESS_KEY_ID=
SINALOA_S3_SECRET_ACCESS_KEY=
SINALOA_S3_SESSION_TOKEN=
SINALOA_MALWARE_SCANNER_URL=
SINALOA_MALWARE_SCANNER_TOKEN=
SINALOA_OBJECT_QUOTA_REAPER_INTERVAL_MS=300000
SINALOA_AUTH_MODE=development
SINALOA_HUMAN_AUTH_PROVIDER=local
SINALOA_PUBLIC_URL=http://127.0.0.1:8787
SINALOA_OTP_EXPIRY_MINUTES=10
SINALOA_SESSION_HOURS=24
SINALOA_DATA_ENCRYPTION_KEY=
# Production human authentication (required when SINALOA_AUTH_MODE=production)
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=https://example.com/api/auth/workos/callback
WORKOS_ISSUER=
WORKOS_COOKIE_NAME=sinaloa_session
SINALOA_CSRF_COOKIE_NAME=sinaloa_csrf
WORKOS_COOKIE_DOMAIN=
SINALOA_COOKIE_SAMESITE=Lax
SINALOA_COOKIE_SECURE=true
