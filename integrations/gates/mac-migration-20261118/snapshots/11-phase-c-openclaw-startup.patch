+    ];
+    const schemaRejectedAttempt = { events: await pin('fourth', fourth, true), previousJournal: threeAttempts.interruptedJournal,
+      transcript: await pin('transcript', transcript), dispatch: await pin('dispatch', dispatch), outcome: await pin('outcome', outcome) };
+    const fourAttempts = { ...threeAttempts, schemaRejectedAttempt,
+      interruptedJournal: await pin('journal-fourth', { ...journal, providerCalls: 4 }),
+      retryInventory: await pin('inventory-fourth', wrap({ ...inventory, attempts: 4, sessions: [...inventory.sessions,
