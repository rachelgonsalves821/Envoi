+    const thirdEvents = events.map(event => ({ ...event, atUtc: event.atUtc.replace('01:34:', '01:37:').replace('01:35:', '01:38:').replace('01:36:', '01:39:') }));
+    const subsequentStartupOnlyAttempt = { events: await pin('third', thirdEvents, true), previousJournal: retry.interruptedJournal };
+    const threeAttempts = { ...retry, subsequentStartupOnlyAttempt, interruptedJournal: await pin('journal-third', { ...journal, providerCalls: 3 }),
+      retryInventory: await pin('inventory-third', wrap({ ...inventory, attempts: 3, sessions: [...inventory.sessions, ended('2026-11-13T01:39:00Z', 'ended_by_host')] })) };
+    await expect(inspectAcceptedOpenClawRetry({ ...input, retry: threeAttempts })).resolves.toMatchObject({ workId });
+    await expect(inspectAcceptedOpenClawRetry({ ...input, retry: { ...threeAttempts, startupOnlyAttempt: undefined } }))
