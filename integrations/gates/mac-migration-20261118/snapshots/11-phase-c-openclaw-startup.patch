+    await expect(inspectAcceptedOpenClawRetry({ ...input, retry: { ...retry, startupOnlyAttempt: { ...retry.startupOnlyAttempt, events: forwarded } } }))
+      .rejects.toThrow('EXACT_STARTUP_ONLY_ATTEMPT_REQUIRED');
+    const replied = await pin('replied', wrap({ ...inventory, replyCount: 1 }));
