+    const request = { requestId, idempotencyKey, caseId, senderAgentId, recipientAgentId, text: 'Fixture',
+      intent: 'request', sendLimit: 1, origin: 'https://sinaloa-staging.rachelgonsalves821.workers.dev' };
+    const ended = (endedAt: string, endedReason = 'work_settled') => ({ status: 'ended', endedReason, endedAt });
+    const inventory = { checkedAt, database: 'sinaloa_staging', readOnly: 'on', workId, attempts: 2, claimStatus: 'retryable',
+      failureCode: 'HANDLER_FAILED', messageStatus: 'acknowledged', retryAt: '2026-11-13T01:36:10Z', activeSessions: 0,
+      activeWorkLeases: 0, activeCaseSessions: 0, protectedCaseState: 'paused', originalDispositionMatches: true,
+      leaseExpiresAt: null, processedAt: null, replyCount: 0, previousStatus: 'failed', originalStatus: 'failed',
+      sessions: [ended('2026-11-13T01:20:00Z'), ended('2026-11-13T01:36:00Z', 'ended_by_host')] };
+    const wrap = (row: unknown) => [{ phase_c_r2_accepted_work_readonly: row }];
+    const journal = { workId, model: 'openclaw:http://127.0.0.1:41234:main', providerCalls: 2, completed: false, pending: [] };
+    const settlement = (atUtc: string) => ({ atUtc, window, workId, kind: 'canonical_settlement', role: 'openclaw', operation: 'fail', status: 'retryable' });
+    const events = [
+      { window, workId, kind: 'actual_canonical_context', atUtc: '2026-11-13T01:34:00Z' },
+      { window, kind: 'receiver_startup_transport_failure', atUtc: '2026-11-13T01:35:59Z', method: 'POST', path: '/v1/responses',
+        causes: [{ name: 'Error', code: 'OWNED_NATIVE_BOOTSTRAP_TIMEOUT' }] },
+      settlement('2026-11-13T01:36:01Z'),
+    ];
+    const retry = {
+      sendReceipt: await pin('send', { requestId, workId, caseId }), retryInventory: await pin('inventory', wrap(inventory)),
+      interruptedJournal: await pin('journal', journal), attemptEvents: await pin('first', [settlement('2026-11-13T01:20:01Z')], true),
+      startupOnlyAttempt: { events: await pin('second', events, true), previousJournal: await pin('backup', { ...journal, providerCalls: 1 }) },
+    };
+    const input = { retry, caseId, senderAgentId, recipientAgentId, window, now: Date.parse(checkedAt) + 1000,
+      requestApproval: await pin('approval', { request, preservedCheckpoint: { workId: 'msg_failed' } }) };
+    await expect(inspectAcceptedOpenClawRetry(input)).resolves.toMatchObject({ workId, journalIdentity: journal.model });
+    await expect(inspectAcceptedOpenClawRetry({ ...input, retry: { ...retry, startupOnlyAttempt: undefined } })).rejects.toThrow();
+    const premature = await pin('premature-host-end', wrap({ ...inventory,
