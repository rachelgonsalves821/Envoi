@@ -0,0 +1,85 @@
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import type { RequestBudgetLedger } from './request-budget';
+import type { ProgressPin } from './stopped-progress';
+
+export type R2CloseoutPins = Readonly<{
+  accepted: ProgressPin;
+  settlement: ProgressPin;
+  ownerReadback: ProgressPin;
+  queueReadback: ProgressPin;
+  actionLedger: ProgressPin;
+  requestLedgerSha256: string;
+}>;
+
+const sha = (bytes: string | Buffer) => createHash('sha256').update(bytes).digest('hex');
+const digest = /^[a-f0-9]{64}$/;
+export const r3FileRequestId = 'fa6ff3d3-e4e1-4dcc-b6e1-a6f32c66a912';
+
+async function readPin(pin: ProgressPin) {
+  assert(path.isAbsolute(pin.path) && digest.test(pin.sha256), 'R3_CLOSEOUT_PIN_REQUIRED');
+  const stat = await fs.lstat(pin.path);
+  assert(stat.isFile() && !stat.isSymbolicLink() && stat.size > 0 && stat.size < 2_000_000, 'R3_BOUNDED_CLOSEOUT_REQUIRED');
+  const raw = await fs.readFile(pin.path);
+  assert.equal(sha(raw), pin.sha256, 'R3_CLOSEOUT_PIN_CHANGED');
+  return raw.toString('utf8');
+}
+
+export async function inspectR2Closeout(pins: R2CloseoutPins, ledger: RequestBudgetLedger, releaseRoot: string) {
+  assert.equal(path.resolve(pins.actionLedger.path), path.resolve(releaseRoot, 'phase-c-cumulative-actions.jsonl'));
+  const [accepted, settlement, owner, queue] = await Promise.all(
+    [pins.accepted, pins.settlement, pins.ownerReadback, pins.queueReadback].map(async pin => JSON.parse(await readPin(pin))),
+  );
+  assert.equal(accepted.workId, 'msg_4ecc398cb4c68c59afc11e8476678103');
+  assert.equal(owner.replyId, 'msg_tool_ef60c1cd8536df43bda64ff9f3268b3f69ab12f2');
+  assert.equal(owner.state, 'r2_reply_settlement_and_owner_readback_verified');
+  assert.equal(settlement.state, 'r2_accepted_work_reply_and_settlement_verified');
+  assert.equal(owner.ownerInboxReadback, 'verified');
+  assert.equal(owner.ownerWebsiteReadback, 'verified');
+  assert.equal(settlement.ownerWebsiteReadback, 'pending');
+  assert.deepEqual(owner, { ...settlement, state: owner.state, ownerWebsiteReadback: 'verified' });
+  assert.deepEqual(accepted, { requestId: owner.requestId, workId: owner.workId, caseId: owner.caseId });
+  assert.match(owner.settlementSha256, digest);
+  assert.equal(owner.modelCallsAdded, 2);
+  assert.equal(queue.state, 'r3_testowner_marker_settlement_readback_verified');
+  assert.equal(queue.roles.testowner.status, 'processed');
+  assert.equal(queue.roles.testowner.derivedReplies, 0);
+  assert.equal(queue.roles.openclaw.status, 'delivered');
+  assert.equal(queue.budgetsUnchanged, true);
+
+  const usage = ledger.snapshot();
+  assert.equal(ledger.contentSha256, pins.requestLedgerSha256, 'R3_REQUEST_LEDGER_CHANGED');
+  const requestBytes = await ledger.readInspectionBytes();
+  assert.equal(sha(requestBytes), pins.requestLedgerSha256, 'R3_REQUEST_LEDGER_CHANGED');
+  assert.deepEqual([usage.chargedAttempts, usage.knownOpenClawDispatches, usage.pending, usage.unresolvedDispatches, usage.modelCap], [41, 6, 0, 0, 64]);
+  const openClaw = requestBytes.toString('utf8').trimEnd().split('\n').map(line => JSON.parse(line))
+    .filter(row => row.kind === 'attempt' && row.flow === 'openclaw');
+  assert.equal(openClaw.length, 6);
+  assert(openClaw.every(row => row.canonicalWorkHash === sha(accepted.workId)));
+  const actionBytes = await readPin(pins.actionLedger);
+  const lines = actionBytes.trimEnd().split('\n');
+  const actions = lines.map(line => JSON.parse(line));
+  assert.equal(actions[0].kind, 'seed');
+  const anchor = JSON.parse(await fs.readFile(path.join(releaseRoot, 'phase-c-action-ledger.anchor'), 'utf8'));
+  assert.equal(anchor.seedSha256, sha(lines[0] + '\n'));
+  assert.equal(actions[0].previous, '0'.repeat(64));
+  assert(actions.slice(1).every((row, index) => row.previous === sha(lines[index] + '\n')));
+  assert.equal(actions[0].prior.possibleHostMessageEffects, 22);
+  assert.equal(actions.length, 19);
+  assert(actions.slice(1).every(row => row.kind === 'operation'));
+  const r2 = actions.filter(row => row.workId === accepted.workId);
+  assert.equal(r2.length, 6);
+  assert.equal(r2[0].operationKind, 'message');
+  assert(r2.every(row => row.caseId === accepted.caseId));
+  assert(r2.slice(1).every(row => row.operationKind === 'tool' && row.tool === 'envoi_case_reply'));
+  return {
+    caseId: accepted.caseId as string,
+    serverSource: owner.retainedControllerServerSource as string,
+    operationsUsed: actions[0].prior.possibleHostMessageEffects + actions.length - 1,
+    assetShareWorkId: 'msg_' + sha(ledger.reviewedPlan!.actorIds.openclaw + ':phase-c-followup:' + r3FileRequestId).slice(0, 32),
+    blockedWorkIds: [accepted.workId, owner.replyId, 'msg_dd4b760932c0f1c070f0caf89c3482a8',
+      'msg_61043afbde307cce0aff61d5bdd1452f', 'msg_instruction_4f4363f79a3587cf0a473047a024f016be94abbc'] as string[],
+  };
+}
