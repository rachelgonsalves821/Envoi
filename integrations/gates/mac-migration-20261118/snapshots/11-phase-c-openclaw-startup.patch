+    await expect(inspectAcceptedOpenClawRetry({ ...input, retry: { ...retry, retryInventory: premature } }))
+      .rejects.toThrow('R2_HOST_END_MUST_FOLLOW_STARTUP_FAILURE');
+    const unrelated = await pin('unrelated-end', wrap({ ...inventory,
+      sessions: [inventory.sessions[0], ended('2026-11-13T01:36:00Z', 'agent_paused')] }));
+    await expect(inspectAcceptedOpenClawRetry({ ...input, retry: { ...retry, retryInventory: unrelated } }))
