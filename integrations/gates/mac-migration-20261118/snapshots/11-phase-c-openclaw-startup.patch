+    const window = 'a'.repeat(64), checkedAt = '2026-11-13T01:40:00Z';
+    const requestId = randomUUID(), idempotencyKey = 'phase-c-followup:' + requestId;
+    const caseId = 'case_fixture', senderAgentId = 'agent_sender', recipientAgentId = 'agent_recipient';
