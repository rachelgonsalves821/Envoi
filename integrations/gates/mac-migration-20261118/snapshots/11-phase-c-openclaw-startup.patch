+const sha = (input: string) => createHash('sha256').update(input).digest('hex');
+
+it('admits only the pinned startup-only attempt after the original retryable settlement', async () => {
+  const dir = await fs.mkdtemp(path.join(os.tmpdir(), 'envoi-r2-admission-'));
+  try {
