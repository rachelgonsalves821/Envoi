+    await expect(inspectAcceptedOpenClawRetry({ ...input, retry: { ...threeAttempts, subsequentStartupOnlyAttempt: { ...subsequentStartupOnlyAttempt, events: retry.startupOnlyAttempt.events } } })).rejects.toThrow();
+    const sessionId = 'case_session_schema_failure', processIdentity = 'fixture-process';
+    const authority = { window, workId, caseId, processIdentity, caseSessionId: sessionId };
+    const requestRawBytes = JSON.stringify({ tools: [{ name: 'envoi_case_list_assets', parameters: { allOf: [{}] } }] });
+    const responseRawBytes = JSON.stringify({ error: { message: 'input_schema does not support oneOf, allOf, or anyOf at the top level' } });
+    const transcript = { workId, caseId, pins: authority, path: '/v1/responses', httpStatus: 400,
+      requestRawBytes, responseRawBytes, requestSha256: sha(requestRawBytes), responseSha256: sha(responseRawBytes) };
+    const dispatch = { ...authority, kind: 'actual_native_physical_dispatch', physicalSequence: 2, intentId: 'fixture',
+      bodySha256: sha('fixture') };
+    const outcome = { ...dispatch, kind: 'actual_native_physical_outcome', stage: 'body_drained', httpStatus: 400 };
+    const fourth = [
+      { window, workId, caseId, kind: 'actual_canonical_context', role: 'openclaw', atUtc: '2026-11-13T01:39:20Z',
