@@ -0,0 +1,312 @@
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import type { ContinuationWorkflowReceipt } from './continuation-controller';
+import type { ProgressPin, StoppedProgressPreflight } from './stopped-progress';
+
+const sha = (bytes: string | Buffer) => createHash('sha256').update(bytes).digest('hex');
+const digest = /^[a-f0-9]{64}$/;
+const requestId = /^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/;
+
+export type TerminalOpenClawEvidence = Readonly<{
+  requestApproval: ProgressPin;
+  operationApproval: ProgressPin;
+  allocation: ProgressPin;
+  actionLedger: ProgressPin;
+  requestLedgerSha256: string;
+  execution: ProgressPin;
+  events: ProgressPin;
+  journal: ProgressPin;
+  inventory: ProgressPin;
+}>;
+
+export type AcceptedOpenClawRetryEvidence = Readonly<{
+  sendReceipt: ProgressPin;
+  retryInventory: ProgressPin;
+  interruptedJournal: ProgressPin;
+  attemptEvents: ProgressPin;
+  startupOnlyAttempt?: Readonly<{ events: ProgressPin; previousJournal: ProgressPin }>;
+  subsequentStartupOnlyAttempt?: Readonly<{ events: ProgressPin; previousJournal: ProgressPin }>;
+  schemaRejectedAttempt?: Readonly<{
+    events: ProgressPin;
+    previousJournal: ProgressPin;
+    transcript: ProgressPin;
+    dispatch: ProgressPin;
+    outcome: ProgressPin;
+  }>;
+}>;
+
+async function read(pin: ProgressPin) {
+  assert(path.isAbsolute(pin.path) && digest.test(pin.sha256), 'EXACT_TERMINAL_CONTINUATION_PIN_REQUIRED');
+  const stat = await fs.lstat(pin.path);
+  assert(stat.isFile() && !stat.isSymbolicLink() && stat.size <= 2_000_000, 'BOUNDED_TERMINAL_CONTINUATION_PIN_REQUIRED');
+  const bytes = await fs.readFile(pin.path);
+  assert.equal(sha(bytes), pin.sha256, 'TERMINAL_CONTINUATION_BYTES_CHANGED');
+  return bytes.toString('utf8');
+}
+
+export async function inspectTerminalOpenClaw({ receipt, preflight, flowCases, actorIds, terminal }: {
+  receipt: ContinuationWorkflowReceipt;
+  preflight: StoppedProgressPreflight;
+  flowCases: Readonly<Record<string, string>>;
+  actorIds: Readonly<Record<string, string>>;
+  terminal: TerminalOpenClawEvidence;
+}) {
+  const [approval, operation, allocation, execution, inventory] = await Promise.all(
+    [terminal.requestApproval, terminal.operationApproval, terminal.allocation, terminal.execution, terminal.inventory]
+      .map(async pin => JSON.parse(await read(pin))),
+  );
+  const { request, preservedCheckpoint } = approval;
+  assert.equal(approval.purpose, 'phase-c-one-approved-synthetic-reply-request');
+  assert.equal(approval.state, 'approved_unsent');
+  assert.equal(approval.pending.stagingRelease, receipt.serverSource);
+  assert.equal(request.origin, 'https://sinaloa-staging.rachelgonsalves821.workers.dev');
+  assert.equal(request.caseId, flowCases.openclaw);
+  assert.equal(request.senderAgentId, actorIds.testowner);
+  assert.equal(request.recipientAgentId, actorIds.openclaw);
+  assert.equal(request.intent, 'request');
+  assert.equal(request.sendLimit, 1);
+  assert(typeof request.text === 'string' && request.text.length > 0 && request.text.length <= 2000);
+  assert(requestId.test(request.requestId));
+  assert.equal(request.idempotencyKey, 'phase-c-followup:' + request.requestId);
+  const workId = 'msg_' + sha(request.senderAgentId + ':' + request.idempotencyKey).slice(0, 32);
+  const failedWorkId = preservedCheckpoint.workId;
+  assert(/^msg_[A-Za-z0-9_-]+$/.test(failedWorkId) && failedWorkId !== workId);
+  assert.equal(preservedCheckpoint.status, 'failed');
+  assert.equal(terminal.events.sha256, preservedCheckpoint.terminalEventsSha256);
+  assert.equal(terminal.journal.sha256, preservedCheckpoint.journalSha256);
+  assert.equal(execution.purpose, 'actual-controlled-checkpoint-recovery');
+  assert.deepEqual(execution.receipt, receipt);
+  assert.equal(execution.window, sha(JSON.stringify(receipt)));
+  assert.equal(execution.actualStartedAtUtc, receipt.startUtc);
+  const [events] = await Promise.all([read(terminal.events), read(terminal.journal), read(terminal.actionLedger)]);
+  const settlements = events.trimEnd().split(/\r?\n/).map(line => JSON.parse(line)).filter(event =>
+    event.kind === 'canonical_settlement' && event.workId === failedWorkId);
+  assert.equal(settlements.length, 1);
+  const [settlement] = settlements;
+  assert.equal(settlement.window, execution.window);
+  assert.equal(settlement.role, 'openclaw');
+  assert.equal(settlement.operation, 'fail');
+  assert.equal(settlement.status, 'failed');
+  assert(Date.parse(settlement.atUtc) >= Date.parse(receipt.startUtc), 'CURRENT_TERMINAL_SETTLEMENT_REQUIRED');
+
+  assert.equal(operation.purpose, 'phase-c-openclaw-successor-operation-approval');
+  assert.equal(operation.state, 'approved_for_one_send');
+  assert.equal(operation.requestApprovalSha256, terminal.requestApproval.sha256);
+  assert.equal(operation.allocationReviewSha256, terminal.allocation.sha256);
+  assert.equal(operation.actionLedgerSha256, terminal.actionLedger.sha256);
+  assert.equal(allocation.currentActionLedgerSha256, terminal.actionLedger.sha256);
+  assert.equal(allocation.requestApprovalSha256, terminal.requestApproval.sha256);
+  assert.deepEqual([operation.operationCap, operation.normalCeiling, operation.cleanupReserve, operation.modelCap], [63, 55, 8, 64]);
+  assert.equal(allocation.allocation.recordedOperations, preflight.conservativeMessages);
+  assert.equal(allocation.allocation.newSendOperations, 1);
+  assert.equal(allocation.allocation.remainingApprovedOperations + 1 + preflight.conservativeMessages, operation.normalCeiling);
+
+  assert.equal(inventory.database, 'sinaloa_staging');
+  assert.equal(inventory.readOnly, 'on');
+  assert.equal(Date.parse(inventory.checkedAt), preflight.checkedAtMs);
+  assert(Date.parse(inventory.checkedAt) >= Date.parse(settlement.atUtc), 'POST_SETTLEMENT_INVENTORY_REQUIRED');
+  assert.equal(inventory.caseState, 'inProgress');
+  assert.equal(inventory.activeWorkLeases, 0);
+  assert.equal(inventory.activeCaseSessions, 0);
+  assert.deepEqual(inventory.approvedMessage, { id: workId, copies: [] });
+  const rows = inventory.failedWork.filter((row: { work_id: string }) => row.work_id === failedWorkId);
+  assert.equal(rows.length, 1);
+  const [failed] = rows;
+  assert.equal(failed.case_id, request.caseId);
+  assert.equal(failed.recipient_agent_id, request.recipientAgentId);
+  assert.equal(failed.claim_status, 'failed');
+  assert.equal(failed.message_status, 'failed');
+  assert.equal(failed.retryable, false);
+  assert.equal(failed.reason_code, 'HANDLER_FAILED');
+  assert.equal(failed.lease_expires_at, null);
+  assert.equal(failed.retry_at, null);
+  assert.equal(failed.processed_at, null);
+  assert(inventory.failedWorkSessions.every((session: { status: string }) => session.status === 'ended'));
+
+  return { workId, failedWorkId, request: {
+    caseId: request.caseId as string, text: request.text as string, intent: 'request' as const,
+    senderAgentId: request.senderAgentId as string, recipientAgentId: request.recipientAgentId as string,
+  } };
+}
+
+export async function inspectAcceptedOpenClawRetry(input: {
+  requestApproval: ProgressPin;
+  retry: AcceptedOpenClawRetryEvidence;
+  caseId: string;
+  senderAgentId: string;
+  recipientAgentId: string;
+  window: string;
+  now?: number;
+}) {
+  const { retry, window } = input;
+  const [approvalRaw, receiptRaw, inventoryRaw, journalRaw, eventsRaw] = await Promise.all(
+    [input.requestApproval, retry.sendReceipt, retry.retryInventory, retry.interruptedJournal, retry.attemptEvents].map(read),
+  );
+  assert(!retry.subsequentStartupOnlyAttempt || retry.startupOnlyAttempt, 'R2_STARTUP_ATTEMPT_CHAIN_REQUIRED');
+  const startupOnlyAttempts = [retry.startupOnlyAttempt, retry.subsequentStartupOnlyAttempt].filter(attempt => attempt !== undefined);
+  assert(!retry.schemaRejectedAttempt || startupOnlyAttempts.length === 2, 'R2_STARTUP_ATTEMPT_CHAIN_REQUIRED');
+  const expectedAttempts = 1 + startupOnlyAttempts.length + Number(!!retry.schemaRejectedAttempt);
+  const { request, preservedCheckpoint } = JSON.parse(approvalRaw);
+  assert.equal(request.origin, 'https://sinaloa-staging.rachelgonsalves821.workers.dev');
+  assert.equal(request.caseId, input.caseId);
+  assert.equal(request.senderAgentId, input.senderAgentId);
+  assert.equal(request.recipientAgentId, input.recipientAgentId);
+  assert.equal(request.intent, 'request');
+  assert.equal(request.sendLimit, 1);
+  assert(requestId.test(request.requestId));
+  assert.equal(request.idempotencyKey, 'phase-c-followup:' + request.requestId);
+  const workId = 'msg_' + sha(request.senderAgentId + ':' + request.idempotencyKey).slice(0, 32);
+  assert.notEqual(workId, preservedCheckpoint.workId);
+  assert.deepEqual(JSON.parse(receiptRaw), { requestId: request.requestId, workId, caseId: request.caseId });
+  const rows = JSON.parse(inventoryRaw);
+  assert(Array.isArray(rows) && rows.length === 1 && Object.keys(rows[0]).join() === 'phase_c_r2_accepted_work_readonly',
+    'EXACT_R2_ACCEPTED_WORK_INVENTORY_REQUIRED');
+  const entry = rows[0].phase_c_r2_accepted_work_readonly;
+  const inventory = typeof entry === 'string' ? JSON.parse(entry) : entry;
+  const checkedAt = Date.parse(inventory.checkedAt), now = input.now ?? Date.now();
+  assert(Number.isFinite(checkedAt) && checkedAt <= now && now - checkedAt < 300_000, 'FRESH_R2_ACCEPTED_WORK_INVENTORY_REQUIRED');
+  assert.equal(inventory.database, 'sinaloa_staging');
+  assert.equal(inventory.readOnly, 'on');
+  assert.equal(inventory.workId, workId);
+  assert.equal(inventory.claimStatus, 'retryable');
+  assert.equal(inventory.failureCode, 'HANDLER_FAILED');
+  assert.equal(inventory.messageStatus, 'acknowledged');
+  assert.equal(inventory.attempts, expectedAttempts);
+  assert(Number.isFinite(Date.parse(inventory.retryAt)) && Date.parse(inventory.retryAt) <= checkedAt);
+  assert.equal(inventory.activeSessions, 0);
+  assert.equal(inventory.activeWorkLeases, 0);
+  assert.equal(inventory.activeCaseSessions, 0);
+  assert.equal(inventory.protectedCaseState, 'paused');
+  assert.equal(inventory.originalDispositionMatches, true);
+  assert.equal(inventory.leaseExpiresAt, null);
+  assert.equal(inventory.processedAt, null);
+  assert.equal(inventory.replyCount, 0);
+  assert.equal(inventory.previousStatus, 'failed');
+  assert.equal(inventory.originalStatus, 'failed');
+  assert.equal(inventory.sessions.length, expectedAttempts);
+  const ended = inventory.sessions.map((session: { status: string; endedReason: string; endedAt: string }, index: number) => {
+    assert.equal(session.status, 'ended');
+    // A failed native startup can end its session explicitly before the work
+    // failure is recorded. Only the pinned startup-only attempt may do this.
+    assert(session.endedReason === 'work_settled' || (index > 0 && session.endedReason === 'ended_by_host'),
+      'R2_UNEXPECTED_SESSION_END_REASON');
+    const at = Date.parse(session.endedAt);
+    assert(Number.isFinite(at) && at <= checkedAt);
+    return at;
+  });
+  assert(ended.every((at: number, index: number) => index === 0 || ended[index - 1] < at), 'R2_ATTEMPT_ORDER_REQUIRED');
+  const journal = JSON.parse(journalRaw);
+  assert.equal(journal.workId, workId);
+  assert.equal(journal.completed, false);
+  assert.deepEqual(journal.pending, []);
+  // The local journal counts an attempted response even if startup prevents
+  // dispatch. The controller separately pins the unchanged physical-call ledger.
+  assert.equal(journal.providerCalls, expectedAttempts);
+  assert(/^openclaw:http:\/\/127\.0\.0\.1:\d{1,5}:[A-Za-z0-9_-]{1,128}$/.test(journal.model));
+  const parseEvents = (raw: string) => raw.trimEnd().split(/\r?\n/).map(line => JSON.parse(line));
+  const assertSettlement = (events: ReturnType<typeof parseEvents>, index: number) => {
+    const settlements = events.filter(event => event.kind === 'canonical_settlement' && event.workId === workId);
+    assert.equal(settlements.length, 1);
+    const [settlement] = settlements;
+    assert.equal(settlement.window, window);
+    assert.equal(settlement.role, 'openclaw');
+    assert.equal(settlement.operation, 'fail');
+    assert.equal(settlement.status, 'retryable');
+    const at = Date.parse(settlement.atUtc);
+    assert(at <= checkedAt && at >= ended[index] && (index + 1 === ended.length || at < ended[index + 1]));
+    return at;
+  };
+  let previousSettlementAt = assertSettlement(parseEvents(eventsRaw), 0);
+  for (const [offset, startupOnly] of startupOnlyAttempts.entries()) {
+    const index = offset + 1;
+    const [raw, prior] = await Promise.all([read(startupOnly.events), read(startupOnly.previousJournal)]);
+    const previous = JSON.parse(prior);
+    assert.equal(previous.workId, workId);
+    assert.equal(previous.model, journal.model);
+    assert.equal(previous.completed, false);
+    assert.deepEqual(previous.pending, []);
+    assert.equal(previous.providerCalls, index);
+    const events = parseEvents(raw);
+    const settlementAt = assertSettlement(events, index);
+    assert(events.every(event => event.window === window && [
+      'actual_session_started_awaiting_personal_gateway_addresses', 'owned_native_factory_ready', 'existing_receiver_ready',
+      'actual_canonical_context', 'actual_bounded_case_snapshot', 'receiver_startup_transport_failure', 'canonical_settlement',
+    ].includes(event.kind)), 'EXACT_STARTUP_ONLY_ATTEMPT_REQUIRED');
+    assert(events.some(event => event.kind === 'actual_canonical_context' && event.workId === workId));
+    const failure = events.filter(event => event.kind === 'receiver_startup_transport_failure');
+    assert.equal(failure.length, 1);
+    const [timeout] = failure;
+    assert.equal(timeout.method, 'POST');
+    assert.equal(timeout.path, '/v1/responses');
+    assert.deepEqual(timeout.causes, [{ name: 'Error', code: 'OWNED_NATIVE_BOOTSTRAP_TIMEOUT' }]);
+    const timeoutAt = Date.parse(timeout.atUtc);
+    assert(timeoutAt > previousSettlementAt && timeoutAt <= settlementAt);
+    if (inventory.sessions[index].endedReason === 'ended_by_host') {
+      assert(timeoutAt <= ended[index], 'R2_HOST_END_MUST_FOLLOW_STARTUP_FAILURE');
+    }
+    previousSettlementAt = settlementAt;
+  }
+  if (retry.schemaRejectedAttempt) {
+    const { events, previousJournal, transcript, dispatch, outcome } = retry.schemaRejectedAttempt;
+    const index = expectedAttempts - 1;
+    const [raw, previous, exchange, sent, drained] = await Promise.all([
+      read(events),
+      ...[previousJournal, transcript, dispatch, outcome].map(async pin => JSON.parse(await read(pin))),
+    ]);
+    const attempt = parseEvents(raw);
+    const settlementAt = assertSettlement(attempt, index);
+    assert.equal(previous.workId, workId);
+    assert.equal(previous.model, journal.model);
+    assert.equal(previous.completed, false);
+    assert.deepEqual(previous.pending, []);
+    assert.equal(previous.providerCalls, index);
+    const contexts = attempt.filter(event => event.kind === 'actual_canonical_context');
+    const boots = attempt.filter(event => event.kind === 'owned_native_bootstrap_admitted');
+    assert.equal(contexts.length, 1);
+    assert.equal(boots.length, 1);
+    const context = contexts[0], boot = boots[0], sessionId = context.session?.id;
+    assert(typeof sessionId === 'string' && sessionId.startsWith('case_session_'));
+    assert(attempt.every(event => event.window === window));
+    assert.equal(context.role, 'openclaw');
+    assert.equal(context.session.agentId, input.recipientAgentId);
+    assert.equal(context.session.caseId, input.caseId);
+    assert.equal(context.session.workId, workId);
+    assert(Date.parse(context.atUtc) > previousSettlementAt && Date.parse(context.atUtc) <= Date.parse(boot.atUtc)
+      && Date.parse(boot.atUtc) <= settlementAt, 'R2_SCHEMA_REJECTION_ORDER_REQUIRED');
+    assert.equal(boot.workId, workId);
+    for (const proof of [context, exchange, sent, drained]) {
+      assert.equal(proof.workId, workId);
+      assert.equal(proof.caseId, input.caseId);
+    }
+    for (const proof of [exchange.pins, sent, drained]) {
+      assert.equal(proof.window, window);
+      assert.equal(proof.caseSessionId, sessionId);
+      assert.deepEqual(proof.processIdentity, boot.processIdentity);
+    }
+    assert.equal(sent.kind, 'actual_native_physical_dispatch');
+    assert.equal(drained.kind, 'actual_native_physical_outcome');
+    assert.equal(drained.stage, 'body_drained');
+    assert(Number.isSafeInteger(sent.physicalSequence) && sent.physicalSequence > 0);
+    assert.equal(drained.physicalSequence, sent.physicalSequence);
+    assert.equal(drained.intentId, sent.intentId);
+    assert(digest.test(sent.bodySha256) && drained.bodySha256 === sent.bodySha256);
+    assert.equal(drained.httpStatus, 400);
+    assert.equal(exchange.httpStatus, 400);
+    assert.equal(exchange.path, '/v1/responses');
+    const requestBytes = Buffer.from(exchange.requestRawBytes, 'utf8');
+    const responseBytes = Buffer.from(exchange.responseRawBytes, 'utf8');
+    assert.equal(sha(requestBytes), exchange.requestSha256);
+    assert.equal(sha(responseBytes), exchange.responseSha256);
+    const tools = JSON.parse(requestBytes.toString('utf8')).tools;
+    assert(tools.some((tool: { name: string; parameters: { allOf?: unknown[] } }) =>
+      tool.name === 'envoi_case_list_assets' && Array.isArray(tool.parameters?.allOf)), 'R2_REJECTED_TOOL_SCHEMA_REQUIRED');
+    assert(JSON.parse(responseBytes.toString('utf8')).error?.message?.includes(
+      'input_schema does not support oneOf, allOf, or anyOf at the top level'), 'R2_REJECTED_TOOL_SCHEMA_REQUIRED');
+  }
+  return { workId, checkedAt, priorWorkId: preservedCheckpoint.workId, journalIdentity: journal.model as string, request: {
+    caseId: request.caseId as string, text: request.text as string, intent: 'request' as const,
+    senderAgentId: request.senderAgentId as string, recipientAgentId: request.recipientAgentId as string,
+  } };
+}
