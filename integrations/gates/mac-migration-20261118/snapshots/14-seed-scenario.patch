+const startedAt = Date.now();
+const scenarios = { personal: personalScenario, enterprise: enterpriseScenario, crossorg: crossOrgScenario };
+const { people, protagonist: lead, alsoSignIn = [], pending } = await scenarios[SCENARIO]();
+const logins = [lead, ...alsoSignIn];
+await writeFile(LOGIN_FILE, JSON.stringify(logins.map(who => ({ name: who.name, phone: who.phone, totpSecret: who.totpSecret }))), 'utf8');
+
+// Let every agent mark its queued messages processed so delivery receipts look complete.
+for (const who of people) await drain(who);
+
+// The local sign-in allows one verification code per phone per minute; wait it out so the first on-camera sign-in works.
+await pause(Math.max(0, 61_000 - (Date.now() - startedAt)));
+
+log('\n================ Demo ready ================');
+log(`Scenario: ${SCENARIO}`);
+log(`Open ${baseUrl}`);
+for (const who of logins) log(`Sign in as ${who.name}: phone ${who.phone}, then the one-time code shown on screen, then an authenticator code.`);
+log('Get fresh authenticator codes with:  node scripts/demo-scenario.mjs --code   (or press Enter here)');
+const printCode = () => { for (const who of logins) log(`Authenticator code for ${who.name}: ${generateSync({ secret: who.totpSecret })}  (valid ~30s)`); };
+printCode();
+if (SCENARIO === 'crossorg' && MONAD === 'local') {
+  log('\nNOTE: Monad is running against a local stand-in chain. Its transaction hashes and explorer links are not real;');
+  log('rehearse with it, but record the published video with --monad testnet.');
