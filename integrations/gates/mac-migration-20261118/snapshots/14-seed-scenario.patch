+// The UI's Approve Once needs a policy evaluation, which negotiated cases do not create, so the
+// approval is sent as the person's real signed-in session when you type "approve" here.
+let approvalSent = false;
+async function approvePending() {
+  if (approvalSent) return log('Already approved.');
+  approvalSent = true;
+  await approve(pending.who, pending.caseId, pending.result, `${pending.key}-human-approve`);
+  log(`${lead.name} approved ${pending.label}.`);
+}
+log(`Type "approve" here to record ${lead.name} approving ${pending.label}.`);
+readline.createInterface({ input: process.stdin }).on('line', line => {
+  if (line.trim().toLowerCase() === 'approve') approvePending().catch(error => log('Approve failed:', error.message));
+  else printCode();
+});
+
+// Once the approval lands, the agent completes the case so the receipt appears live.
+async function watchForApproval() {
+  while (!stopping) {
+    await pause(1000);
+    const current = await readCase(pending.who, pending.caseId).catch(() => null);
+    const action = current?.payload?.events?.find(event => event.type === 'humanAction' && event.payload?.action?.actionKey === 'approveOnce')?.payload?.action;
+    if (!action) continue;
+    await pause(2500);
+    const result = action.externalRefs?.result || pending.result;
+    await say(pending.who, pending.counterparty, pending.caseId, `${pending.key}-complete`, {
+      type: 'completion', intent: 'receipt', text: result,
+      payload: { completion: { result, authorityBasis: action.id } }
+    });
+    await drain(pending.counterparty);
+    log(`Approved: the agent completed ${pending.label}.`);
+    return;
+  }
+}
+if (WATCH) {
+  log(`Watching for ${lead.name}'s approval; the agent will then file the receipt.`);
+  watchForApproval().catch(error => log('Approval watcher stopped:', error.message));
+}
