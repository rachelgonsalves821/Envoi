+#!/usr/bin/env node
+// Seeds a local, disposable Envoi with a scripted story for screen recording.
+//   personal   (default): scheduling (completed), bargaining (waiting on Alex), file sharing (in progress)
+//   enterprise: expert discovery (completed), expert outreach with a shared postmortem and a booked
+//               session (completed), and a governed data-access request (waiting on Maya)
+//   crossorg:   a CFO's finance agent and an outside recruiting agency agree a hiring plan (waiting on Elena),
+//               a consultant's agent gathers steering-committee updates from three client teams (completed),
+//               and an investment bank's request where Envoi blocks the CFO's agent from sharing files and
+//               records the denied attempt on Monad
+// Usage: node scripts/demo-scenario.mjs [--scenario personal|enterprise|crossorg] [--monad local|testnet] [--no-watch]
+//        (Ctrl+C stops the server). --monad applies to crossorg: "local" (default) runs a stand-in chain for
+//        rehearsal only; "testnet" uses ENVOI_MONAD_ISSUER_PRIVATE_KEY/ADDRESS from your environment.
+//        node scripts/demo-scenario.mjs --code   prints each sign-in's current authenticator code
+import { spawn } from 'node:child_process';
+import crypto from 'node:crypto';
+import http from 'node:http';
+import { once } from 'node:events';
+import { mkdir, readFile, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import readline from 'node:readline';
+import { Transaction, Wallet } from 'ethers';
+import { generateSync } from 'otplib';
+import { BrowserSession } from '../test/browser-session.js';
+
+const PORT = Number(process.env.DEMO_PORT || 8787);
+const DATA_DIR = path.resolve(process.env.DEMO_DATA_DIR || path.join(tmpdir(), 'envoi-demo-data'));
+const WATCH = !process.argv.includes('--no-watch');
+const scenarioFlag = process.argv.indexOf('--scenario');
+const SCENARIO = scenarioFlag === -1 ? 'personal' : process.argv[scenarioFlag + 1];
+const pause = ms => new Promise(resolve => setTimeout(resolve, ms));
+const log = (...items) => console.log(...items);
+
+const monadFlag = process.argv.indexOf('--monad');
+const MONAD = monadFlag === -1 ? 'local' : process.argv[monadFlag + 1];
+
+if (!['personal', 'enterprise', 'crossorg'].includes(SCENARIO)) throw new Error('--scenario must be personal, enterprise or crossorg');
+if (!['local', 'testnet'].includes(MONAD)) throw new Error('--monad must be local or testnet');
+if (SCENARIO === 'crossorg' && MONAD === 'testnet' && !(process.env.ENVOI_MONAD_ISSUER_PRIVATE_KEY && process.env.ENVOI_MONAD_ISSUER_ADDRESS)) {
+  throw new Error('--monad testnet needs ENVOI_MONAD_ISSUER_PRIVATE_KEY and ENVOI_MONAD_ISSUER_ADDRESS (a funded testnet issuer) in your environment');
+}
+if (!path.basename(DATA_DIR).startsWith('envoi-demo-data')) throw new Error('DEMO_DATA_DIR must be named envoi-demo-data*');
+const LOGIN_FILE = path.join(DATA_DIR, 'demo-login.json');
+if (process.argv.includes('--code')) {
+  for (const login of [JSON.parse(await readFile(LOGIN_FILE, 'utf8'))].flat()) {
+    console.log(`Authenticator code for ${login.name}: ${generateSync({ secret: login.totpSecret })}`);
+  }
+  process.exit(0);
+}
+await rm(DATA_DIR, { recursive: true, force: true });
+await mkdir(DATA_DIR, { recursive: true });
+
+// A stand-in malware scanner so shared files can be marked clean locally.
+const scanner = http.createServer((req, res) => {
+  req.resume();
+  req.on('end', () => { res.setHeader('content-type', 'application/json'); res.end(JSON.stringify({ status: 'clean', engine: 'demo-scanner' })); });
+});
+scanner.listen(0, '127.0.0.1');
+await once(scanner, 'listening');
+
+// A stand-in Monad testnet RPC for rehearsals: it accepts and "finalizes" every transaction instantly.
+// Its hashes are never on chain, so footage recorded with it must not be published as Monad evidence.
+let fakeChain = null;
+async function startFakeChain() {
+  const transactions = new Map();
+  const blockHash = `0x${'b'.repeat(64)}`;
+  const chain = http.createServer(async (req, res) => {
+    let raw = '';
+    for await (const chunk of req) raw += chunk;
+    const { id, method, params } = JSON.parse(raw);
+    let result;
+    if (method === 'eth_chainId') result = '0x279f';
+    else if (method === 'eth_gasPrice') result = '0x3b9aca00';
+    else if (method === 'eth_getTransactionCount') result = `0x${transactions.size.toString(16)}`;
+    else if (method === 'eth_sendRawTransaction') { const tx = Transaction.from(params[0]); transactions.set(tx.hash, tx); result = tx.hash; }
+    else if (method === 'eth_getTransactionByHash') { const tx = transactions.get(params[0]); result = tx ? { from: tx.from, to: tx.to, input: tx.data, value: '0x0', blockHash } : null; }
+    else if (method === 'eth_getTransactionReceipt') result = transactions.has(params[0]) ? { blockNumber: '0x1', blockHash, status: '0x1' } : null;
+    else if (method === 'eth_getBlockByNumber') result = { number: '0x1', hash: blockHash, timestamp: `0x${Math.floor(Date.now() / 1000).toString(16)}` };
+    res.setHeader('content-type', 'application/json');
+    res.end(JSON.stringify({ jsonrpc: '2.0', id, result }));
+  });
+  chain.listen(0, '127.0.0.1');
+  await once(chain, 'listening');
+  return chain;
+}
+
+// Monad's paid-organization list is read at startup, so crossorg restarts the server once the CFO's
+// organization exists. Everything lives in DATA_DIR, so sessions and agent tokens survive the restart.
+async function monadEnv(paidOrganizationId) {
+  if (MONAD === 'testnet') return { ENVOI_MONAD_PERMISSIONS: 'true', ENVOI_MONAD_PAID_ORGANIZATION_IDS: paidOrganizationId };
+  fakeChain ||= await startFakeChain();
+  const issuer = Wallet.createRandom();
+  return {
+    ENVOI_MONAD_PERMISSIONS: 'true', ENVOI_MONAD_PAID_ORGANIZATION_IDS: paidOrganizationId,
+    ENVOI_MONAD_RPC_URL: `http://127.0.0.1:${fakeChain.address().port}`,
+    ENVOI_MONAD_ISSUER_PRIVATE_KEY: issuer.privateKey, ENVOI_MONAD_ISSUER_ADDRESS: issuer.address
+  };
+}
+
+let server = null;
+async function startServer(extraEnv = {}) {
+  const child = spawn(process.execPath, ['src/server.js'], {
+    cwd: process.cwd(),
+    env: {
+      ...process.env,
+      DATABASE_URL: '',
+      ENVOI_HOST: '127.0.0.1',
+      ENVOI_PORT: String(PORT),
+      ENVOI_AUTH_MODE: 'development',
+      ENVOI_HUMAN_AUTH_PROVIDER: 'local',
+      ENVOI_OBJECT_STORAGE_PROVIDER: 'local',
+      ENVOI_MALWARE_SCANNER_URL: `http://127.0.0.1:${scanner.address().port}/scan`,
+      ENVOI_ENABLE_EXTERNAL_EMAIL: 'false',
+      ENVOI_ENABLE_CALENDAR_WRITES: 'false',
+      ENVOI_ENABLE_CONSEQUENTIAL_ACTIONS: 'false',
+      ENVOI_DATA_DIR: DATA_DIR,
+      ...extraEnv
+    },
+    stdio: ['ignore', 'pipe', 'pipe']
+  });
+  let serverError = '';
+  child.stderr.on('data', chunk => { serverError += chunk.toString(); });
+  const url = await new Promise((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error(`Server start timed out: ${serverError.slice(-600)}`)), 15_000);
+    child.once('exit', code => { clearTimeout(timer); reject(new Error(`Server exited ${code}: ${serverError.slice(-600)}`)); });
+    child.stdout.on('data', chunk => {
+      const match = chunk.toString().match(/http:\/\/127\.0\.0\.1:(\d+)/);
+      if (match) { clearTimeout(timer); resolve(`http://127.0.0.1:${match[1]}`); }
+    });
+  });
+  child.removeAllListeners('exit');
+  server = child;
+  return url;
+}
+
+async function restartServer(extraEnv) {
+  const exited = once(server, 'exit');
+  server.kill('SIGTERM');
+  await exited;
+  return startServer(extraEnv);
+}
+
+const baseUrl = await startServer();
+
+let stopping = false;
+async function shutdown(code = 0) {
+  if (stopping) return;
+  stopping = true;
+  server.kill('SIGTERM');
+  scanner.close();
+  fakeChain?.close();
+  await pause(300);
+  process.exit(code);
+}
+process.on('SIGINT', () => shutdown(0));
+process.on('SIGTERM', () => shutdown(0));
+
+async function api(route, { token, session, body, key } = {}) {
+  const method = body === undefined ? 'GET' : 'POST';
+  const response = await fetch(`${baseUrl}${route}`, {
+    method,
+    headers: {
+      ...(body === undefined ? {} : { 'content-type': 'application/json' }),
+      ...(token ? { authorization: `Bearer ${token}` } : {}),
+      ...(session ? session.headers(baseUrl, method) : {}),
+      ...(key ? { 'idempotency-key': key } : {})
+    },
+    body: body === undefined ? undefined : JSON.stringify(body),
+    signal: AbortSignal.timeout(30_000)
+  });
+  session?.capture(response);
+  const text = await response.text();
+  return { status: response.status, payload: text ? JSON.parse(text) : null };
+}
+
+function expect(result, statuses, label) {
+  if (!statuses.includes(result.status)) throw new Error(`${label} failed (${result.status}): ${JSON.stringify(result.payload)}`);
+  return result.payload;
+}
+
+// `runtime` is one of the connector runtimes the server records (openclaw, hermes, grok); omit it for
+// agents that connect another way, such as a Dot over the remote MCP plugin. The UI does not show it, so
+// names carry the type. Only use types the in-app catalog onboards (frontend/src/onboarding/agent-catalog.ts).
+const FULL_PERMISSIONS = ['send_agent_messages', 'receive_agent_messages', 'create_assets', 'execute_cases'];
+async function enrollAgent(person, { agentName, slug, runtime, permissions = FULL_PERMISSIONS }) {
+  const enrollment = expect(await api(`/api/inboxes/${person.workspace.id}/agent-enrollment-tokens`, {
+    session: person.session, body: { permissions, ...(runtime ? { runtime } : {}) }
+  }), [201], 'enrollment token');
+  const agent = expect(await api('/api/agent-enroll', { body: { enrollmentToken: enrollment.enrollmentToken, name: agentName, slug } }), [201], 'agent enroll');
+  return { ...person, ...agent };
+}
+
+async function onboard({ phone, name, workspace, ...agentProfile }) {
+  const session = new BrowserSession();
+  const started = expect(await api('/api/auth/phone/start', { session, body: { phoneNumber: phone, displayName: name } }), [201], 'phone start');
+  const verified = expect(await api('/api/auth/phone/verify', { session, body: { challengeId: started.challengeId, code: started.developmentCode } }), [200], 'phone verify');
+  const totp = expect(await api('/api/auth/totp/setup', { session, body: {} }), [201], 'totp setup');
+  expect(await api('/api/auth/totp/verify', { session, body: { code: generateSync({ secret: totp.secret }) } }), [200], 'totp verify');
+  const root = expect(await api('/api/inboxes', { session, body: { name: workspace } }), [201], 'workspace');
+  return enrollAgent({ session, phone, name, totpSecret: totp.secret, human: verified.human, workspace: root }, agentProfile);
+}
+
+const readCase = (who, caseId) => api(`/api/inboxes/${who.inbox.id}/cases/${caseId}`, { token: who.agentApiToken });
+
+async function converged(who, caseId, messageId) {
+  for (let attempt = 0; attempt < 200; attempt += 1) {
+    const result = await readCase(who, caseId);
+    if (result.status === 200 && result.payload.events.some(event => event.id === `evt_${messageId}`)) return result.payload;
+    await pause(50);
+  }
+  throw new Error(`Message ${messageId} never reached ${who.agent.address}`);
+}
+
+// Sends one protocol message and waits until the other side's case contains it.
+async function say(from, to, caseId, key, { type, intent, text, payload = {}, authority }) {
+  const sent = expect(await api(`/api/inboxes/${from.inbox.id}/messages`, {
+    token: from.agentApiToken, key,
+    body: { senderAgentId: from.agent.id, recipientEmail: to.agent.address, caseId, type, intent, text, payload, ...(authority ? { authority } : {}) }
+  }), [200, 202], `send ${key}`);
+  await converged(to, caseId, sent.id);
+  await pause(350);
+  return sent;
+}
+
+const approve = async (who, caseId, result, key) => expect(await api(`/api/inboxes/${who.inbox.id}/cases/${caseId}/actions`, {
+  session: who.session, key, body: { actionKey: 'approveOnce', externalRefs: { requestedAction: 'case.complete', result }, reasonCode: 'reviewed' }
+}), [201], `approve ${key}`);
+
+// An accepted proposal, approved by `approver`, then completed by `closer` with the approved result.
+async function closeWithApproval({ approver, closer, counterparty, caseId, result, key }) {
+  const approval = await approve(approver, caseId, result, `${key}-human-approve`);
+  await say(closer, counterparty, caseId, `${key}-complete`, {
+    type: 'completion', intent: 'receipt', text: result,
+    payload: { completion: { result, authorityBasis: approval.action.id } }
+  });
+}
+
+// Claims queued work for an agent, marking each native item processed; returns the item matching `until`.
+async function drain(who, until = null) {
+  for (let attempt = 0; attempt < 60; attempt += 1) {
+    const claimed = expect(await api('/api/agent/work/claim', { token: who.agentApiToken, body: { acceptHumanInstructions: true } }), [200], 'claim');
+    const work = claimed.work;
+    if (!work) { if (!until) return null; await pause(100); continue; }
+    if (until && work.workId === until) return work;
+    expect(await api(`/api/agent/work/${work.workId}/complete`, { token: who.agentApiToken, key: `demo-complete-${work.workId}`, body: { leaseToken: work.leaseToken } }), [200, 201], 'complete work');
+  }
+  return null;
+}
+
+// A person gives their own agent a private instruction on a case, and the agent acknowledges it.
+async function instruct(who, caseId, key, text, reply) {
+  const instruction = expect(await api(`/api/inboxes/${who.inbox.id}/cases/${caseId}/instructions`, {
+    session: who.session, key, body: { text }
+  }), [201], 'human instruction');
+  const work = await drain(who, instruction.id);
+  if (!work) return log('  (instruction reply skipped: instruction work item not claimable)');
+  expect(await api(`/api/agent/instructions/${work.workId}/reply`, {
+    token: who.agentApiToken, key: `${key}-reply`, body: { text: reply, leaseToken: work.leaseToken }
+  }), [200, 201], 'instruction reply');
+}
+
+// Uploads a small document as `owner`'s agent, lets the scanner clear it, and shares it on the case.
+async function shareFile(owner, recipient, caseId, key, filename, summary) {
+  const pdf = Buffer.from(
+    '%PDF-1.4\n1 0 obj<</Type/Catalog/Pages 2 0 R>>endobj\n2 0 obj<</Type/Pages/Kids[3 0 R]/Count 1>>endobj\n'
+    + '3 0 obj<</Type/Page/Parent 2 0 R/MediaBox[0 0 300 144]>>endobj\ntrailer<</Root 1 0 R>>\n%%EOF\n'
+    + `${summary}\n`);
+  const upload = expect(await api(`/api/inboxes/${owner.inbox.id}/asset-uploads`, {
+    token: owner.agentApiToken, key: `${key}-upload`,
+    body: { filename, mimeType: 'application/pdf', size: pdf.length, checksumSha256: crypto.createHash('sha256').update(pdf).digest('base64'), caseId }
+  }), [201], 'asset upload');
+  const put = await fetch(upload.upload.url, { method: 'PUT', headers: upload.upload.headers, body: pdf });
+  if (put.status !== 204) throw new Error(`Asset PUT failed (${put.status})`);
+  expect(await api(`/api/inboxes/${owner.inbox.id}/assets/${upload.object.id}/complete`, { token: owner.agentApiToken, body: {} }), [200], 'asset scan');
+  expect(await api(`/api/inboxes/${owner.inbox.id}/assets/${upload.object.id}/grants`, {
+    token: owner.agentApiToken, key: `${key}-grant`, body: { caseId, recipientAgentId: recipient.agent.id }
+  }), [200, 201], 'asset grant');
+}
+
