{
  "contract": "provider-event-wake-discovery",
  "version": 1,
  "id": "discover-events-capability",
  "kind": "http",
  "description": "Discovery amendment: a qualifying OAuth installation at MCP 2026-07-28 receives a complete result and supportedVersions. Existing authorization and version gates still apply.",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": true,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_HTTP_WAKE_V1": true,
    "ENVOI_REMOTE_MCP_OAUTH": true,
    "ENVOI_PROVIDER_CONNECTORS": false,
    "ENVOI_MCP_EVENTS_V1": true,
    "ENVOI_GROK_TRIGGER_V1": false
  },
  "context": {
    "profile": "mcp_events",
    "route": "remote_mcp_oauth",
    "agentStatus": "active",
    "callbackOriginAllowlist": [
      "https://dots.callbacks.example"
    ],
    "dns": {
      "host": "dots.callbacks.example",
      "addresses": [
        "192.0.43.11"
      ]
    }
  },
  "request": {
    "method": "POST",
    "path": "/mcp",
    "auth": "bearer",
    "headers": {
      "content-type": "application/json",
      "accept": "application/json, text/event-stream",
      "mcp-protocol-version": "2026-07-28",
      "authorization": "Bearer envoi_agent_access_PLACEHOLDER_oauth_1"
    },
    "body": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "server/discover",
      "params": {}
    }
  },
  "response": {
    "status": 200,
    "schema": "rpcResult",
    "headers": {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "no-store"
    },
    "body": {
      "jsonrpc": "2.0",
      "id": 1,
      "result": {
        "resultType": "complete",
        "supportedVersions": [
          "2026-07-28"
        ],
        "capabilities": {
          "tools": {},
          "events": {}
        }
      }
    }
  },
  "client": {
    "surface": "host",
    "lifecycle": "UNCHANGED",
    "retry": "none",
    "guidance": "none",
    "next": "See the row for this outcome in the contract tables."
  }
