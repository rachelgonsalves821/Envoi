        "request": {
          "$ref": "#/definitions/fixtureRequest"
        },
        "response": {
          "$ref": "#/definitions/fixtureResponse"
        },
        "client": {
          "$ref": "#/definitions/fixtureClient"
        },
        "evidence": {
          "$ref": "#/definitions/fixtureEvidence"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "http"
              }
            }
          },
          "then": {
            "required": [
              "request",
              "response",
              "client"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "evidence"
              }
            }
          },
          "then": {
            "required": [
              "evidence"
            ],
            "not": {
              "required": [
                "request"
              ]
            }
          }
        }
      ]
