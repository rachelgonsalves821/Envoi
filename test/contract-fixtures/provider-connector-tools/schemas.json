        },
        "unproven": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gate",
              "claim",
              "owner"
            ],
            "properties": {
              "gate": {
                "type": "string"
              },
              "claim": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              }
            }
          }
        }
