        },
        "id": {
          "type": "integer"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tools"
          ],
          "properties": {
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
