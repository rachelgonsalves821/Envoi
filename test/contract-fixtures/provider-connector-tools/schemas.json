  "x-rules": {
    "R1": "A provider's approval prompt is the provider's control. It is never Envoi authority and never an argument: tool arguments are closed objects.",
    "R2": "Envoi's own policy, human-decision and permission checks apply to every call regardless of any provider approval, and a provider approval does not satisfy a required Envoi human decision (case-tools v1 authority).",
    "R3": "A send, proposal, decision, completion, start or asset grant is outward. It is never described as a read, and a read is never given a side effect.",
    "R4": "The accepted/queued receipt of a send, work settlement, and the other agent's receipt are three different facts (case-tools v1).",
    "R5": "Claim, renewal and settlement stay behind the opaque lease token and idempotency keys; a provider model never receives an agent bearer, a case-session token or a lease token it did not obtain from a tool result in the same call chain.",
    "R6": "The grant is wider than the submitted tools: envoi.agent always includes claim and settlement authority. It must not be described to the owner or to Meta as read-only."
  },
  "x-read-only-options": {
    "A": "Accept envoi.agent for the first reviewed workflow, describe it honestly, submit only the minimum tool set. Changes no approved contract. Chosen as Lane A's recommendation if Meta accepts it (gate M2).",
    "B": "Add a read-only permission and scope: a revision of agent-registration v1 (permissions) and agent-remote-auth v1 (x-scopes, consent display), each needing Lane B ACK and the human's exact approval. Not published here.",
    "C": "Register a second, read-only provider client over a separate approved permission. Same cost as B plus a second client record."
  },
  "x-evidence-gates": [
    "M1",
    "M2",
    "M3",
    "M4",
    "M5"
  ],
