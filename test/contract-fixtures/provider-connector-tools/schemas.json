    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "version",
        "id",
        "description",
        "kind"
      ],
      "properties": {
        "contract": {
          "const": "provider-connector-tools"
        },
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
