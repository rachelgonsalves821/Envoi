  "x-effect-classes": {
    "read": "retrieves without changing state",
    "write": "changes Envoi state for this installation only (a lease, work state, an asset reservation)",
    "sensitive_write": "sends content to another party or shares a file; Meta decides its own class and requires approval on every use"
  },
