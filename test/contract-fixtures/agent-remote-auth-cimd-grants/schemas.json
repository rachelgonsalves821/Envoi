{
  "$id": "agent-remote-auth-cimd-grants/schemas.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Human-approved additive CIMD grant-capability amendment; does not enable any new server grant.",
  "x-amends": {
    "contract": "agent-remote-auth",
    "version": 1,
    "revision": 4,
    "section": "3.1 client metadata grant types"
  },
  "x-limits": {
    "grantsMax": 16,
    "grantLengthMax": 256
  },
  "x-server-grants": [
    "authorization_code",
    "refresh_token"
  ],
  "definitions": {
    "clientGrantMetadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "grant_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[!-~]+$"
          },
          "contains": {
            "const": "authorization_code"
          }
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "version",
        "id",
        "description",
        "kind",
        "document",
        "expected"
      ],
      "properties": {
        "contract": {
          "const": "agent-remote-auth-cimd-grants"
        },
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "client-metadata"
        },
        "document": {
          "type": "object"
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "valid"
              ],
              "properties": {
                "valid": {
                  "const": true
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "valid",
                "rejection"
              ],
              "properties": {
                "valid": {
                  "const": false
                },
                "rejection": {
                  "const": "grant_types_invalid"
                }
              }
            }
          ]
        }
      }
    }
  }
}
