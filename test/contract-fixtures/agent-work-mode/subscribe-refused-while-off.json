{
  "contract": "agent-work-mode",
  "version": 1,
  "id": "subscribe-refused-while-off",
  "description": "While the mode is off, events/subscribe for envoi.work_available is refused with a JSON-RPC error and nothing is stored or verified, so a host renewal cannot silently undo Off.",
  "kind": "http",
  "flags": {
    "ENVOI_WORK_MODE": true
  },
  "context": {
    "deliveryMode": "on_demand",
    "modeBefore": "off",
    "subscriptionsBefore": []
  },
  "request": {
    "method": "POST",
    "path": "/mcp",
    "auth": "bearer",
    "headers": {
      "content-type": "application/json",
      "accept": "application/json, text/event-stream",
      "authorization": "Bearer envoi_agent_access_PLACEHOLDER_oauth_1",
      "mcp-protocol-version": "2026-07-28"
    },
    "body": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "events/subscribe",
      "params": {
        "name": "envoi.work_available",
        "arguments": {},
        "delivery": {
          "mode": "webhook",
          "url": "https://dots.callbacks.example/envoi/events",
          "secret": "whsec_UExBQ0VIT0xERVItRklYVFVSRS1TRUNSRVQtMDAwMQ=="
        }
      }
    }
  },
  "response": {
    "status": 200,
    "schema": "mcpResult",
    "body": {
      "jsonrpc": "2.0",
      "id": 1,
      "error": {
        "code": -32016,
        "message": "BackgroundReceivingOff",
        "data": {
          "reason": "owner_turned_off"
        }
      }
    }
  },
  "client": {
    "surface": "host",
    "next": "Tell the owner background receiving is off in Envoi; do not retry until workMode is routine or ask."
  }
}
