{
  "contract": "mcp-wake",
  "version": 1,
  "id": "create-revoked",
  "kind": "http",
  "description": "§6: a revoked connection is rejected at /mcp; its subscriptions already ended with credential_ended.",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": true,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_HTTP_WAKE_V1": true,
    "ENVOI_PROVIDER_CONNECTORS": true,
    "ENVOI_REMOTE_MCP_OAUTH": false,
    "ENVOI_MCP_WAKE_V1": true
  },
  "context": {
    "route": "provider_connector",
    "clientKind": "pre_registered",
    "wakeOrigins": [
      "https://hooks.provider.example"
    ],
    "dns": {
      "host": "hooks.provider.example",
      "addresses": [
        "192.0.43.11"
      ]
    },
    "agentStatus": "active"
  },
  "request": {
    "method": "POST",
    "path": "/mcp",
    "auth": "bearer",
    "headers": {
      "content-type": "application/json",
      "accept": "application/json, text/event-stream",
      "authorization": "Bearer envoi_agent_access_PLACEHOLDER_oauth_1"
    },
    "body": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "tools/call",
      "params": {
        "name": "envoi_wake_create",
        "arguments": {
          "url": "https://hooks.provider.example/envoi/wake"
        }
      }
    }
  },
  "response": {
    "status": 401,
    "schema": "errorEnvelope",
    "headers": {
      "www-authenticate": "Bearer resource_metadata=\"https://www.envoi-agents.com/.well-known/oauth-protected-resource/mcp\", scope=\"envoi.agent\", error=\"invalid_token\""
    },
    "body": {
      "code": "CREDENTIAL_REVOKED",
      "error": "CREDENTIAL_REVOKED",
      "message": "This connection was revoked.",
      "requestId": "req_example",
      "reason": "revoked"
    }
  },
  "client": {
    "surface": "backend",
    "lifecycle": "REVOKED",
    "retry": "none",
    "guidance": "owner_reconnect",
    "next": "See the row for this code in x-tool-errors or x-codes."
  }
}
