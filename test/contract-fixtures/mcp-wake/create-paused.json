{
  "contract": "mcp-wake",
  "version": 1,
  "id": "create-paused",
  "kind": "http",
  "description": "§6: /mcp answers HTTP 409 for every tool while the agent is paused, wake tools included. Subscriptions that already exist stay and receive wake.control_changed.",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": true,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_HTTP_WAKE_V1": true,
    "ENVOI_PROVIDER_CONNECTORS": true,
    "ENVOI_REMOTE_MCP_OAUTH": false,
    "ENVOI_MCP_WAKE_V1": true
  },
  "context": {
    "route": "provider_connector",
    "clientKind": "pre_registered",
    "wakeOrigins": [
      "https://hooks.provider.example"
    ],
    "dns": {
      "host": "hooks.provider.example",
      "addresses": [
        "192.0.43.11"
      ]
    },
    "agentStatus": "paused"
  },
  "request": {
    "method": "POST",
    "path": "/mcp",
    "auth": "bearer",
    "headers": {
      "content-type": "application/json",
      "accept": "application/json, text/event-stream",
      "authorization": "Bearer envoi_agent_access_PLACEHOLDER_oauth_1"
    },
    "body": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "tools/call",
      "params": {
        "name": "envoi_wake_create",
        "arguments": {
          "url": "https://hooks.provider.example/envoi/wake"
        }
      }
    }
  },
  "response": {
    "status": 409,
    "schema": "errorEnvelope",
    "body": {
      "code": "AGENT_PAUSED",
      "error": "AGENT_PAUSED",
      "message": "This agent is paused by its owner.",
      "requestId": "req_example"
    }
  },
  "client": {
    "surface": "backend",
    "lifecycle": "PAUSED",
    "retry": "none",
    "guidance": "wait_for_resume",
    "next": "See the row for this code in x-tool-errors or x-codes."
  }
}
