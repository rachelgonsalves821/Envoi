    "body": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "tools/call",
      "params": {
        "name": "envoi_wake_create",
        "arguments": {
          "url": "https://hooks.provider.example/envoi/wake"
        }
      }
    }
  },
  "response": {
    "status": 200,
    "schema": "mcpRpcError",
