{
  "contract": "agent-owner-permissions",
  "version": 1,
  "id": "consent-approve-owner-choice",
  "description": "Flag on: the owner grants Send although the assistant requested envoi.agent only. effectivePermissions is the owner's choice.",
  "kind": "http",
  "flags": {
    "ENVOI_OWNER_PERMISSIONS": true,
    "ENVOI_REMOTE_MCP_OAUTH": true
  },
  "context": {
    "authorizationRequestScope": "envoi.agent"
  },
  "request": {
    "method": "POST",
    "path": "/api/oauth/authorization-requests/PLACEHOLDER_authorization_request_handle_1/approve",
    "auth": "human_session",
    "headers": {
      "cookie": "envoi_session=PLACEHOLDER_session; envoi_csrf=PLACEHOLDER_csrf",
      "x-envoi-csrf": "PLACEHOLDER_csrf",
      "origin": "https://www.envoi-agents.com"
    },
    "schema": "agent-remote-auth/consentApproveRequest",
    "body": {
      "target": {
        "kind": "new_agent",
        "workspaceInboxId": "inbox_workspace_example",
        "name": "Milo",
        "localPart": "milo"
      },
      "grantedPermissions": [
        "receive_agent_messages",
        "send_agent_messages"
      ],
      "policyProfile": "default"
    }
  },
  "response": {
    "status": 200,
    "schema": "agent-remote-auth/consentApproved",
    "headers": {
      "cache-control": "no-store"
    },
    "body": {
      "redirectTo": "https://assistant.example.com/oauth/callback?code=envoi_oauth_code_PLACEHOLDER_1&state=example-state&iss=https%3A%2F%2Fwww.envoi-agents.com",
      "registrationId": "registration_oauth_example",
      "target": "new_agent",
      "workspaceName": "Example workspace",
      "agent": {
        "name": "Milo",
        "address": "milo@envoi-agents.com"
      },
      "effectivePermissions": [
        "receive_agent_messages",
        "send_agent_messages"
      ],
      "policyProfile": "default",
      "codeExpiresAt": "2026-11-12T18:01:00.000Z"
    }
  },
  "client": {
    "surface": "owner_ui",
    "next": "Navigate to redirectTo, as today."
  }
}
