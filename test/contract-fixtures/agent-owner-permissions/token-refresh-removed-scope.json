{
  "contract": "agent-owner-permissions",
  "version": 1,
  "id": "token-refresh-removed-scope",
  "description": "§4, any flag state: the owner removed Send and the assistant still sends envoi.agent envoi.send. Refresh succeeds with the narrower current scopes; it never issues more than the agent holds.",
  "kind": "http",
  "flags": {
    "ENVOI_OWNER_PERMISSIONS": false,
    "ENVOI_REMOTE_MCP_OAUTH": true
  },
  "context": {
    "familyCurrentScopes": "envoi.agent"
  },
  "request": {
    "method": "POST",
    "path": "/oauth/token",
    "auth": "public_client",
    "headers": {
      "content-type": "application/x-www-form-urlencoded"
    },
    "form": {
      "grant_type": "refresh_token",
      "refresh_token": "envoi_agent_refresh_PLACEHOLDER_oauth_1",
      "scope": "envoi.agent envoi.send",
      "client_id": "https://assistant.example.com/oauth/envoi-client.json"
    }
  },
  "response": {
    "status": 200,
    "schema": "agent-remote-auth/tokenResponse",
    "headers": {
      "cache-control": "no-store",
      "pragma": "no-cache"
    },
    "body": {
      "access_token": "envoi_agent_access_PLACEHOLDER_oauth_2",
      "token_type": "Bearer",
      "expires_in": 900,
      "refresh_token": "envoi_agent_refresh_PLACEHOLDER_oauth_2",
      "scope": "envoi.agent"
    }
  },
  "client": {
    "surface": "host",
    "next": "Replace both stored tokens atomically."
  }
}
