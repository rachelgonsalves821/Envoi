{
  "contract": "agent-owner-permissions",
  "version": 1,
  "id": "consent-view-owner-choice",
  "description": "Flag on: the assistant asked for envoi.agent only, and the page may grant any OAuth permission within the organization maximum.",
  "kind": "http",
  "flags": {
    "ENVOI_OWNER_PERMISSIONS": true,
    "ENVOI_REMOTE_MCP_OAUTH": true
  },
  "context": {
    "authorizationRequestScope": "envoi.agent"
  },
  "request": {
    "method": "GET",
    "path": "/api/oauth/authorization-requests/PLACEHOLDER_authorization_request_handle_1",
    "auth": "human_session",
    "headers": {
      "cookie": "envoi_session=PLACEHOLDER_session"
    }
  },
  "response": {
    "status": 200,
    "schema": "agent-remote-auth/consentView",
    "headers": {
      "cache-control": "no-store"
    },
    "body": {
      "client": {
        "name": "Example Assistant",
        "clientIdHost": "assistant.example.com",
        "redirectHost": "assistant.example.com",
        "loopbackRedirect": false,
        "registration": "metadata_document"
      },
      "connectionRoute": "remote_mcp_oauth",
      "requestedPermissions": [
        "receive_agent_messages"
      ],
      "grantablePermissions": [
        "receive_agent_messages",
        "send_agent_messages",
        "create_assets",
        "execute_cases"
      ],
      "expiresAt": "2026-11-12T18:10:00.000Z"
    }
  },
  "client": {
    "surface": "owner_ui",
    "next": "Offer every grantable permission. Pre-tick the saved setup's choice, else what was requested. Mark each ticked permission the assistant did not request, for example \"Your assistant didn't ask for Send. It will get it.\""
  }
}
