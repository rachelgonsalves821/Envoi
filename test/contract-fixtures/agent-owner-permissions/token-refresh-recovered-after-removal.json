{
  "contract": "agent-owner-permissions",
  "version": 1,
  "id": "token-refresh-recovered-after-removal",
  "description": "§4: recovery re-delivers, it does not issue. A retry inside the recovery window gets the identical earlier response, even after the owner removed Send; the next refresh with a successor token reports the current scopes.",
  "kind": "http",
  "flags": {
    "ENVOI_OWNER_PERMISSIONS": true,
    "ENVOI_REMOTE_MCP_OAUTH": true
  },
  "context": {
    "familyScopesAtStep0": "envoi.agent envoi.send",
    "recoveryWindowSeconds": 60
  },
  "steps": [
    {
      "note": "Refresh while Send is held. The 200 is lost on the way to the client.",
      "request": {
        "method": "POST",
        "path": "/oauth/token",
        "auth": "public_client",
        "headers": {
          "content-type": "application/x-www-form-urlencoded"
        },
        "form": {
          "grant_type": "refresh_token",
          "refresh_token": "envoi_agent_refresh_PLACEHOLDER_oauth_1",
          "scope": "envoi.agent envoi.send",
          "client_id": "https://assistant.example.com/oauth/envoi-client.json"
        }
      },
      "response": {
        "status": 200,
        "schema": "agent-remote-auth/tokenResponse",
        "headers": {
          "cache-control": "no-store",
          "pragma": "no-cache"
        },
        "body": {
          "access_token": "envoi_agent_access_PLACEHOLDER_oauth_2",
          "token_type": "Bearer",
          "expires_in": 900,
          "refresh_token": "envoi_agent_refresh_PLACEHOLDER_oauth_2",
          "scope": "envoi.agent envoi.send"
        }
      },
      "client": {
        "surface": "host",
        "next": "Nothing arrived; retry the same request."
      }
    },
    {
      "note": "Within the window, the owner removes Send.",
      "request": {
        "method": "POST",
        "path": "/api/inboxes/inbox_agent_example/agents/agent_example/permissions",
        "auth": "human_session",
        "headers": {
          "cookie": "envoi_session=PLACEHOLDER_session; envoi_csrf=PLACEHOLDER_csrf",
          "x-envoi-csrf": "PLACEHOLDER_csrf",
          "origin": "https://www.envoi-agents.com"
        },
        "schema": "permissionsUpdateRequest",
        "body": {
          "permissions": [
            "receive_agent_messages"
          ],
          "expectedPermissions": [
            "receive_agent_messages",
            "send_agent_messages"
          ]
        }
      },
      "response": {
        "status": 200,
        "schema": "permissionsUpdated",
        "body": {
          "agent": {
            "id": "agent_example",
            "permissions": [
              "receive_agent_messages"
            ]
          }
        }
      },
      "client": {
        "surface": "owner_ui",
        "next": "Show Receive only."
      }
    },
    {
      "note": "Within the window, before either successor is used: the identical form gets the identical step-0 response.",
      "request": {
        "method": "POST",
        "path": "/oauth/token",
        "auth": "public_client",
        "headers": {
          "content-type": "application/x-www-form-urlencoded"
        },
        "form": {
          "grant_type": "refresh_token",
          "refresh_token": "envoi_agent_refresh_PLACEHOLDER_oauth_1",
          "scope": "envoi.agent envoi.send",
          "client_id": "https://assistant.example.com/oauth/envoi-client.json"
        }
      },
      "response": {
        "status": 200,
        "schema": "agent-remote-auth/tokenResponse",
        "headers": {
          "cache-control": "no-store",
          "pragma": "no-cache"
        },
        "body": {
          "access_token": "envoi_agent_access_PLACEHOLDER_oauth_2",
          "token_type": "Bearer",
          "expires_in": 900,
          "refresh_token": "envoi_agent_refresh_PLACEHOLDER_oauth_2",
          "scope": "envoi.agent envoi.send"
        }
      },
      "client": {
        "surface": "host",
        "next": "Store both tokens. /mcp already enforces Receive only: a send tool gets 403 INSUFFICIENT_SCOPE."
      }
    },
    {
      "note": "The successor refresh token renews with the current scopes.",
      "request": {
        "method": "POST",
        "path": "/oauth/token",
        "auth": "public_client",
        "headers": {
          "content-type": "application/x-www-form-urlencoded"
        },
        "form": {
          "grant_type": "refresh_token",
          "refresh_token": "envoi_agent_refresh_PLACEHOLDER_oauth_2",
          "scope": "envoi.agent envoi.send",
          "client_id": "https://assistant.example.com/oauth/envoi-client.json"
        }
      },
      "response": {
        "status": 200,
        "schema": "agent-remote-auth/tokenResponse",
        "headers": {
          "cache-control": "no-store",
          "pragma": "no-cache"
        },
        "body": {
          "access_token": "envoi_agent_access_PLACEHOLDER_oauth_3",
          "token_type": "Bearer",
          "expires_in": 900,
          "refresh_token": "envoi_agent_refresh_PLACEHOLDER_oauth_3",
          "scope": "envoi.agent"
        }
      },
      "client": {
        "surface": "host",
        "next": "Replace both stored tokens atomically. The granted scope is now envoi.agent."
      }
    }
  ]
}
