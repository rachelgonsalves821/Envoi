{
  "contract": "case-tools",
  "version": 1,
  "id": "revision-3-tool-not-in-session",
  "kind": "http",
  "description": "A revision 3 tool on a server that implements revisions 1 and 2 is absent from the session, even when permissions would allow it.",
  "context": {
    "sessionRef": "A",
    "caseRef": "case-a",
    "workKind": "agent_message",
    "allowedTools": [
      "envoi_case_snapshot",
      "envoi_case_reply",
      "envoi_case_propose",
      "envoi_case_decide",
      "envoi_authority_check",
      "envoi_request_human",
      "envoi_case_list_assets",
      "envoi_case_share_asset",
      "envoi_case_complete"
    ]
  },
  "request": {
    "method": "POST",
    "path": "/mcp",
    "auth": "case_session",
    "headers": {
      "authorization": "Bearer envoi_case_session_PLACEHOLDER_case_a",
      "content-type": "application/json",
      "accept": "application/json, text/event-stream",
      "mcp-protocol-version": "2025-11-25"
    },
    "schema": "jsonRpcRequest",
    "body": {
      "jsonrpc": "2.0",
      "id": 10,
      "method": "tools/call",
      "params": {
        "name": "envoi_case_complete",
        "arguments": {
          "idempotencyKey": "complete-1"
        }
      }
    }
  },
  "response": {
    "status": 200,
    "schema": "jsonRpcError",
    "headers": {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "no-store"
    },
    "body": {
      "jsonrpc": "2.0",
      "id": 10,
      "error": {
        "code": -32602,
        "message": "Tool not available in this case session",
        "data": {
          "code": "TOOL_NOT_IN_SESSION"
        }
      }
    }
  },
  "client": {
    "surface": "tool_channel",
    "lifecycle": "UNCHANGED",
    "retry": "none",
    "guidance": "none",
    "turn": "continue",
    "next": "Use only the tools in allowedActions."
  }
}
