{
  "contract": "case-tools",
  "version": 1,
  "id": "reply-not-in-session",
  "kind": "http",
  "description": "A receive-only agent's session does not carry the reply tool (case-session §6.4).",
  "context": {
    "sessionRef": "R",
    "caseRef": "case-a",
    "workKind": "agent_message",
    "allowedTools": [
      "envoi_case_snapshot",
      "envoi_case_list_assets"
    ]
  },
  "request": {
    "method": "POST",
    "path": "/mcp",
    "auth": "case_session",
    "headers": {
      "authorization": "Bearer envoi_case_session_PLACEHOLDER_receive_only",
      "content-type": "application/json",
      "accept": "application/json, text/event-stream",
      "mcp-protocol-version": "2025-11-25"
    },
    "schema": "jsonRpcRequest",
    "body": {
      "jsonrpc": "2.0",
      "id": 22,
      "method": "tools/call",
      "params": {
        "name": "envoi_case_reply",
        "arguments": {
          "text": "No liftgate needed; the dock has a ramp.",
          "idempotencyKey": "reply-1"
        }
      }
    }
  },
  "response": {
    "status": 200,
    "schema": "jsonRpcError",
    "headers": {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "no-store"
    },
    "body": {
      "jsonrpc": "2.0",
      "id": 22,
      "error": {
        "code": -32602,
        "message": "Tool not available in this case session",
        "data": {
          "code": "TOOL_NOT_IN_SESSION"
        }
      }
    }
  },
  "client": {
    "surface": "tool_channel",
    "lifecycle": "UNCHANGED",
    "retry": "none",
    "guidance": "none",
    "turn": "continue",
    "next": "The host never sends the reply itself."
  }
}
