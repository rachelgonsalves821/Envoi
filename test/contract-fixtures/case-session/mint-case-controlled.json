{
  "contract": "case-session",
  "version": 1,
  "id": "mint-case-controlled",
  "kind": "http",
  "description": "The case is paused or revoked.",
  "request": {
    "method": "POST",
    "path": "/api/agent/work/msg_example/session",
    "auth": "agent_access",
    "headers": {
      "authorization": "Bearer envoi_agent_access_PLACEHOLDER_example",
      "content-type": "application/json"
    },
    "schema": "mintRequest",
    "body": {
      "leaseToken": "lease_PLACEHOLDER_example"
    }
  },
  "response": {
    "status": 409,
    "schema": "errorEnvelope",
    "headers": {
      "cache-control": "no-store"
    },
    "body": {
      "code": "CASE_CONTROLLED",
      "error": "CASE_CONTROLLED",
      "message": "This case is paused or revoked by a human.",
      "requestId": "req_example",
      "caseId": "case_example"
    }
  },
  "client": {
    "surface": "host",
    "lifecycle": "UNCHANGED",
    "retry": "after_case_resume",
    "guidance": "case_paused",
    "turn": "cancel",
    "next": "Skip this case until it resumes."
  }
}
