{
  "contract": "case-session",
  "version": 1,
  "id": "session-tool-not-in-session",
  "kind": "http",
  "description": "Insufficient scope: a receive-only session calls the reply tool. Nothing changes and the turn may continue.",
  "context": {
    "workKind": "agent_message",
    "permissions": [
      "receive_agent_messages"
    ],
    "allowedTools": [
      "envoi_case_snapshot",
      "envoi_case_list_assets"
    ],
    "ended": {
      "credential_ended": false,
      "agent_paused": false,
      "case_controlled": false,
      "work_ineligible": false,
      "work_settled": false,
      "ended_by_host": false,
      "superseded": false,
      "lease_lost": false
    }
  },
  "request": {
    "method": "POST",
    "path": "/mcp",
    "auth": "case_session",
    "headers": {
      "authorization": "Bearer envoi_case_session_PLACEHOLDER_example",
      "content-type": "application/json",
      "accept": "application/json, text/event-stream",
      "mcp-protocol-version": "2025-11-25"
    },
    "schema": "jsonRpcRequest",
    "body": {
      "jsonrpc": "2.0",
      "id": 6,
      "method": "tools/call",
      "params": {
        "name": "envoi_case_reply",
        "arguments": {
          "text": "Example reply",
          "idempotencyKey": "reply-1"
        }
      }
    }
  },
  "response": {
    "status": 200,
    "schema": "jsonRpcError",
    "headers": {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "no-store"
    },
    "body": {
      "jsonrpc": "2.0",
      "id": 6,
      "error": {
        "code": -32602,
        "message": "Tool not available in this case session",
        "data": {
          "code": "TOOL_NOT_IN_SESSION"
        }
      }
    }
  },
  "client": {
    "surface": "tool_channel",
    "lifecycle": "UNCHANGED",
    "retry": "none",
    "guidance": "none",
    "turn": "continue",
    "next": "Tell the model the tool is unavailable. The host never sends the reply itself."
  }
}
