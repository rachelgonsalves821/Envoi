{
  "contract": "case-session",
  "version": 1,
  "id": "session-token-on-claim",
  "kind": "http",
  "description": "A session token cannot claim work (§6.1).",
  "request": {
    "method": "POST",
    "path": "/api/agent/work/claim",
    "auth": "case_session",
    "headers": {
      "authorization": "Bearer envoi_case_session_PLACEHOLDER_example",
      "content-type": "application/json"
    },
    "schema": "claimRequest",
    "body": {}
  },
  "response": {
    "status": 401,
    "schema": "errorEnvelope",
    "headers": {
      "cache-control": "no-store"
    },
    "body": {
      "code": "AUTHENTICATION_REQUIRED",
      "error": "AUTHENTICATION_REQUIRED",
      "message": "Authentication is required.",
      "requestId": "req_example"
    }
  },
  "client": {
    "surface": "tool_channel",
    "lifecycle": "UNCHANGED",
    "retry": "none",
    "guidance": "none",
    "turn": "cancel",
    "next": "Leases are host-only."
  }
}
