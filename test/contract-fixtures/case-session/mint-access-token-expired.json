{
  "contract": "case-session",
  "version": 1,
  "id": "mint-access-token-expired",
  "kind": "http",
  "description": "The host's access token expired; its family is valid (a3).",
  "request": {
    "method": "POST",
    "path": "/api/agent/work/msg_example/session",
    "auth": "agent_access",
    "headers": {
      "authorization": "Bearer envoi_agent_access_PLACEHOLDER_example",
      "content-type": "application/json"
    },
    "schema": "mintRequest",
    "body": {
      "leaseToken": "lease_PLACEHOLDER_example"
    }
  },
  "response": {
    "status": 401,
    "schema": "errorEnvelope",
    "headers": {
      "cache-control": "no-store"
    },
    "body": {
      "code": "ACCESS_TOKEN_EXPIRED",
      "error": "ACCESS_TOKEN_EXPIRED",
      "message": "The access token has expired.",
      "requestId": "req_example"
    }
  },
  "client": {
    "surface": "host",
    "lifecycle": "UNCHANGED",
    "retry": "refresh_then_retry_once",
    "guidance": "none",
    "turn": "continue",
    "next": "Refresh once, then retry the mint once."
  }
}
