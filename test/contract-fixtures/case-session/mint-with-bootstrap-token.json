{
  "contract": "case-session",
  "version": 1,
  "id": "mint-with-bootstrap-token",
  "kind": "http",
  "description": "A registration bootstrap token cannot mint (agent-registration §2).",
  "request": {
    "method": "POST",
    "path": "/api/agent/work/msg_example/session",
    "auth": "bootstrap",
    "headers": {
      "authorization": "Bearer envoi_reg_PLACEHOLDER_example",
      "content-type": "application/json"
    },
    "schema": "mintRequest",
    "body": {
      "leaseToken": "lease_PLACEHOLDER_example"
    }
  },
  "response": {
    "status": 401,
    "schema": "errorEnvelope",
    "headers": {
      "cache-control": "no-store"
    },
    "body": {
      "code": "AUTHENTICATION_REQUIRED",
      "error": "AUTHENTICATION_REQUIRED",
      "message": "Authentication is required.",
      "requestId": "req_example"
    }
  },
  "client": {
    "surface": "tool_channel",
    "lifecycle": "UNCHANGED",
    "retry": "none",
    "guidance": "none",
    "turn": "cancel",
    "next": "Only the host mints, with its access token."
  }
}
