{
  "$id": "https://envoi.example/contracts/case-session/v1/schemas.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "case-session v1 (docs/architecture/agent-native-v2/handoffs.md#case-session-v1). Lane A owns this file; Lane B reports MISMATCH instead of editing it.",
  "x-codes": {
    "FEATURE_DISABLED": {
      "status": 404,
      "when": "§1 / §3 row 1 / §8: ENVOI_CASE_SESSIONS_V1 is off on the mint or end route.",
      "bySurface": {
        "host": {
          "lifecycle": "UNCHANGED",
          "retry": "none",
          "guidance": "sessions_unavailable",
          "turn": "none"
        }
      }
    },
    "CASE_SESSION_REQUEST_INVALID": {
      "status": 400,
      "when": "§3 row 6: the mint or end body is not exactly its schema.",
      "bySurface": {
        "host": {
          "lifecycle": "UNCHANGED",
          "retry": "none",
          "guidance": "update_connector",
          "turn": "none"
        }
      }
    },
    "WORK_NOT_FOUND": {
      "status": 404,
      "when": "§3 row 7, §7.3: the workId is unknown or not addressed to this agent; identical in both cases.",
      "bySurface": {
        "host": {
          "lifecycle": "UNCHANGED",
          "retry": "none",
          "guidance": "none",
          "turn": "none"
        }
      }
    },
    "WORK_NOT_ELIGIBLE": {
      "status": 409,
      "when": "§3 row 9: the claim eligibility checks no longer pass.",
      "bySurface": {
        "host": {
          "lifecycle": "UNCHANGED",
          "retry": "reclaim",
          "guidance": "none",
          "guidanceByReason": {
            "counterparty_unavailable": "none",
            "relationship_blocked": "none",
            "instruction_authority_lost": "none",
            "permission_removed": "none"
          },
          "turn": "none"
        }
      }
    },
    "WORK_LEASE_STALE": {
      "status": 409,
      "when": "§3 row 10 and §7.3: the lease token does not hold this host's live lease.",
      "bySurface": {
        "host": {
          "lifecycle": "UNCHANGED",
          "retry": "reclaim",
          "guidance": "none",
          "guidanceByReason": {
            "other_installation": "none",
            "superseded": "none",
            "settled": "none",
            "released": "none",
            "expired": "none"
          },
          "turn": "cancel"
        }
      }
    },
    "CASE_CONTROLLED": {
      "status": 409,
      "when": "a3 meaning: a human paused or revoked the case (§3 row 8).",
      "bySurface": {
        "host": {
          "lifecycle": "UNCHANGED",
          "retry": "after_case_resume",
          "guidance": "case_paused",
          "turn": "cancel"
        }
      }
    },
    "CASE_SESSION_NOT_FOUND": {
      "status": 404,
      "when": "§8: the session is unknown, belongs to other work or another lease, or is older than the sessions epoch; identical in every case.",
      "bySurface": {
        "host": {
          "lifecycle": "UNCHANGED",
          "retry": "none",
          "guidance": "none",
          "turn": "none"
        }
      }
    },
    "CASE_SESSION_ENDED": {
      "status": 401,
      "when": "§6.2 steps 3 and 5: the recorded end reason, or with nothing recorded and expiresAt not passed, the first holding condition in x-ended-precedence.",
      "bySurface": {
        "tool_channel": {
          "lifecycle": "UNCHANGED",
          "turn": "cancel",
          "retryByReason": {
            "credential_ended": "none",
            "agent_paused": "after_resume",
            "case_controlled": "after_case_resume",
            "work_ineligible": "reclaim",
            "work_settled": "none",
            "ended_by_host": "none",
            "superseded": "mint_again_once",
            "lease_lost": "reclaim"
          },
          "guidanceByReason": {
            "credential_ended": "check_host_credential",
            "agent_paused": "wait_for_resume",
            "case_controlled": "case_paused",
            "work_ineligible": "none",
            "work_settled": "none",
            "ended_by_host": "none",
            "superseded": "none",
            "lease_lost": "none"
          }
        }
      }
    },
    "CASE_SESSION_EXPIRED": {
      "status": 401,
      "when": "§6.2 step 4: the recorded reason is expired, or nothing is recorded and expiresAt has passed. Expiry outranks every condition derived after it.",
      "bySurface": {
        "tool_channel": {
          "lifecycle": "UNCHANGED",
          "retry": "mint_again_once",
          "guidance": "none",
          "turn": "cancel"
        }
      }
    },
    "AUTHENTICATION_REQUIRED": {
      "status": 401,
      "when": "a3 meaning. A session token on any route but /mcp; a session, mcp_read or bootstrap token on the mint or end route; an unknown token; a session older than the sessions epoch; or the flag off.",
      "bySurface": {
        "host": {
          "lifecycle": "UNCHANGED",
          "retry": "refresh_then_retry_once",
          "guidance": "none",
          "turn": "cancel"
        },
        "tool_channel": {
          "lifecycle": "UNCHANGED",
          "retry": "none",
          "guidance": "none",
          "turn": "cancel"
        }
      }
    },
    "ACCESS_TOKEN_EXPIRED": {
      "status": 401,
      "when": "a3 meaning, on the mint and end routes (§3 row 4). A running session does not depend on the access token that minted it.",
      "bySurface": {
        "host": {
          "lifecycle": "UNCHANGED",
          "retry": "refresh_then_retry_once",
          "guidance": "none",
          "turn": "continue"
        }
      }
    },
    "CREDENTIAL_EXPIRED": {
      "status": 401,
      "when": "a3 meaning, on the mint and end routes (§3 row 4).",
      "bySurface": {
        "host": {
          "lifecycle": "NEEDS_RECONNECT",
          "retry": "none",
          "guidance": "owner_reconnect",
          "turn": "cancel"
        }
      }
    },
    "AGENT_PAUSED": {
      "status": 409,
      "when": "a3 meaning, on the mint and settlement routes (§3 row 5, §10). Not on the end route.",
      "bySurface": {
        "host": {
          "lifecycle": "PAUSED",
          "retry": "after_resume",
          "guidance": "wait_for_resume",
          "turn": "cancel"
        }
      }
    },
    "CREDENTIAL_REVOKED": {
      "status": 401,
      "when": "a3 meaning.",
      "bySurface": {
        "host": {
          "lifecycle": "REVOKED",
          "retry": "none",
          "guidanceByReason": {
            "revoked": "owner_reenroll",
            "replaced": "replaced_by_reconnect",
            "refresh_replay": "owner_reenroll"
          },
          "turn": "cancel"
        }
      }
    },
    "RATE_LIMITED": {
      "status": 429,
      "when": "a3 meaning.",
      "bySurface": {
        "host": {
          "lifecycle": "DEGRADED",
          "retry": "after_retry_after",
          "guidance": "service_busy",
          "turn": "continue"
        },
        "tool_channel": {
          "lifecycle": "UNCHANGED",
          "retry": "after_retry_after",
          "guidance": "service_busy",
          "turn": "continue"
        }
      }
    },
    "AUTH_UNAVAILABLE": {
      "status": 503,
      "when": "a3 meaning: never an authorization decision.",
      "bySurface": {
        "host": {
          "lifecycle": "DEGRADED",
          "retry": "backoff",
          "guidance": "service_unavailable",
          "turn": "continue"
        },
        "tool_channel": {
          "lifecycle": "UNCHANGED",
          "retry": "backoff",
          "guidance": "service_unavailable",
          "turn": "continue"
        }
      }
    },
    "INTERNAL_SERVER_ERROR": {
      "status": 500,
      "when": "a3 meaning: never an authorization decision.",
      "bySurface": {
        "host": {
          "lifecycle": "DEGRADED",
          "retry": "backoff",
          "guidance": "service_unavailable",
          "turn": "continue"
        },
        "tool_channel": {
          "lifecycle": "UNCHANGED",
          "retry": "backoff",
          "guidance": "service_unavailable",
          "turn": "continue"
        }
      }
    }
  },
  "x-rpc-codes": [
    {
      "code": -32602,
      "dataCode": "TOOL_NOT_IN_SESSION",
      "turn": "continue",
      "when": "tools/call for a name outside the effective set (§6.4), including every legacy and lease tool."
    },
    {
      "code": -32602,
      "dataCode": "TOOL_ARGUMENTS_INVALID",
      "turn": "continue",
      "when": "tools/call whose arguments fail the tool schema, including any x-scope-fields argument (§6.3)."
    },
    {
      "code": -32601,
      "dataCode": null,
      "turn": "continue",
      "when": "Unknown method."
    }
  ],
  "x-limits": {
    "sessionTtlSeconds": 900,
    "hostRenewIntervalMaxSeconds": 20,
    "defaultLeaseSeconds": 60,
    "liveSessionsPerLease": 1,
    "leaseTokenMaxLength": 256,
    "sessionRecordRetentionHours": 24
  },
  "x-case-tools": [
    {
      "name": "envoi_case_snapshot",
      "needs": "read",
      "workKinds": [
        "agent_message",
        "human_instruction"
      ]
    },
    {
      "name": "envoi_case_reply",
      "needs": "send_agent_messages",
      "workKinds": [
        "agent_message",
        "human_instruction"
      ]
    },
    {
      "name": "envoi_case_propose",
      "needs": "send_agent_messages",
      "workKinds": [
        "agent_message"
      ]
    },
    {
      "name": "envoi_case_decide",
      "needs": "execute_cases",
      "workKinds": [
        "agent_message"
      ]
    },
    {
      "name": "envoi_authority_check",
      "needs": "read",
      "workKinds": [
        "agent_message"
      ]
    },
    {
      "name": "envoi_request_human",
      "needs": "send_agent_messages",
      "workKinds": [
        "agent_message"
      ]
    },
    {
      "name": "envoi_case_list_assets",
      "needs": "read",
      "workKinds": [
        "agent_message",
        "human_instruction"
      ]
    },
    {
      "name": "envoi_case_share_asset",
      "needs": "create_assets",
      "workKinds": [
        "agent_message"
      ]
    },
    {
      "name": "envoi_case_complete",
      "needs": "execute_cases",
      "workKinds": [
        "agent_message"
      ]
    }
  ],
  "x-scope-fields": [
    "caseId",
    "workId",
    "inboxId",
    "agentId",
    "senderAgentId",
    "senderInboxId",
    "recipientAddress",
    "recipientAgentId",
    "recipientInboxId",
    "recipientEmail",
    "counterpartyAddress",
    "sessionId"
  ],
  "x-ended-precedence": [
    "credential_ended",
    "agent_paused",
    "case_controlled",
    "work_ineligible",
    "work_settled",
    "ended_by_host",
    "superseded",
    "lease_lost"
  ],
  "x-recorded-only-reasons": [
    "expired"
  ],
  "x-implied-conditions": {
    "agent_paused": [
      "lease_lost"
    ],
    "case_controlled": [
      "lease_lost"
    ],
    "work_settled": [
      "lease_lost"
    ]
  },
  "x-model-visible": {
    "serverDerived": {
      "counterpartyKind": "session.counterparty.kind",
      "counterpartyAddress": "session.counterparty.address (agent work only)",
      "allowedTools": "session.allowedTools",
      "sessionExpiresInSeconds": "session.expiresAt minus the turn start"
    },
    "fromStatus": {
      "agentAddress": "GET /api/agent/status agent.address (agent-registration §7)"
    },
    "never": [
      "session.token",
      "leaseToken",
      "access and refresh tokens",
      "session.id",
      "session.fence",
      "session.installationId",
      "session.agentId",
      "session.workId",
      "session.caseId",
      "inbox and credential-family ids"
    ]
  },
  "x-operations": [
    {
      "operation": "mint",
      "request": "POST /api/agent/work/{workId}/session",
      "auth": "agent_access",
      "section": "§3"
    },
    {
      "operation": "end",
      "request": "POST /api/agent/work/{workId}/session/end",
      "auth": "agent_access",
      "section": "§8"
    },
    {
      "operation": "tool channel",
      "request": "POST /mcp",
      "auth": "case_session",
      "section": "§6"
    },
    {
      "operation": "instruction reply",
      "request": "POST /api/agent/instructions/{workId}/reply",
      "auth": "agent_access",
      "section": "shares the settlement path; coded errors §7.3"
    },
    {
      "operation": "claim",
      "request": "POST /api/agent/work/claim",
      "auth": "agent_access",
      "section": "a3 §3, a4 §4–§5 (unchanged)"
    },
    {
      "operation": "settlement",
      "request": "POST /api/agent/work/{workId}/{renew,acknowledge,complete,fail}",
      "auth": "agent_access",
      "section": "a3 §3; coded errors §7.3; complete and fail end the session §7.1"
    },
    {
      "operation": "availability",
      "request": "GET /api/agent/status (caseSessions)",
      "auth": "agent_access",
      "section": "§1"
    }
  ],
  "definitions": {
    "lifecycle": {
      "enum": [
        "STARTING",
        "RUNNING",
        "DEGRADED",
        "PAUSED",
        "NEEDS_RECONNECT",
        "REVOKED",
        "STOPPED",
        "UNCHANGED",
        "NOT_APPLICABLE"
      ]
    },
    "retry": {
      "enum": [
        "none",
        "backoff",
        "after_retry_after",
        "refresh_then_retry_once",
        "after_resume",
        "after_case_resume",
        "reclaim",
        "mint_again_once"
      ]
    },
    "guidance": {
      "enum": [
        "none",
        "sessions_unavailable",
        "update_connector",
        "case_paused",
        "wait_for_resume",
        "check_host_credential",
        "owner_reconnect",
        "owner_reenroll",
        "replaced_by_reconnect",
        "service_busy",
        "service_unavailable"
      ]
    },
    "turn": {
      "enum": [
        "none",
        "start",
        "continue",
        "cancel"
      ]
    },
    "errorCode": {
      "enum": [
        "FEATURE_DISABLED",
        "CASE_SESSION_REQUEST_INVALID",
        "WORK_NOT_FOUND",
        "WORK_NOT_ELIGIBLE",
        "WORK_LEASE_STALE",
        "CASE_CONTROLLED",
        "CASE_SESSION_NOT_FOUND",
        "CASE_SESSION_ENDED",
        "CASE_SESSION_EXPIRED",
        "AUTHENTICATION_REQUIRED",
        "ACCESS_TOKEN_EXPIRED",
        "CREDENTIAL_EXPIRED",
        "AGENT_PAUSED",
        "CREDENTIAL_REVOKED",
        "RATE_LIMITED",
        "AUTH_UNAVAILABLE",
        "INTERNAL_SERVER_ERROR"
      ]
    },
    "endedReason": {
      "enum": [
        "credential_ended",
        "agent_paused",
        "case_controlled",
        "work_ineligible",
        "work_settled",
        "ended_by_host",
        "superseded",
        "lease_lost"
      ]
    },
    "recordedEndReason": {
      "enum": [
        "credential_ended",
        "agent_paused",
        "case_controlled",
        "work_ineligible",
        "work_settled",
        "ended_by_host",
        "superseded",
        "lease_lost",
        "expired"
      ]
    },
    "leaseStaleReason": {
      "enum": [
        "other_installation",
        "superseded",
        "settled",
        "released",
        "expired"
      ]
    },
    "notEligibleReason": {
      "enum": [
        "counterparty_unavailable",
        "relationship_blocked",
        "instruction_authority_lost",
        "permission_removed"
      ]
    },
    "permission": {
      "enum": [
        "send_agent_messages",
        "receive_agent_messages",
        "create_assets",
        "execute_cases",
        "use_email_transport"
      ]
    },
    "workKind": {
      "enum": [
        "agent_message",
        "human_instruction"
      ]
    },
    "caseToolName": {
      "enum": [
        "envoi_case_snapshot",
        "envoi_case_reply",
        "envoi_case_propose",
        "envoi_case_decide",
        "envoi_authority_check",
        "envoi_request_human",
        "envoi_case_list_assets",
        "envoi_case_share_asset",
        "envoi_case_complete"
      ]
    },
    "sessionToken": {
      "type": "string",
      "pattern": "^envoi_case_session_[A-Za-z0-9_-]+$"
    },
    "errorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "error",
        "message",
        "requestId"
      ],
      "properties": {
        "code": {
          "$ref": "#/definitions/errorCode"
        },
        "error": {
          "$ref": "#/definitions/errorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "not": {
            "pattern": "(?:(?:envoi|sinaloa)_agent_(?:access|refresh)_|(?:envoi|sinaloa)_mcp_read_|envoi_case_session_|envoi_reg_|lease_PLACEHOLDER)"
          }
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "retryAfterSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "caseId": {
          "type": "string",
          "pattern": "^case_[A-Za-z0-9_-]+$"
        },
        "reason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "RATE_LIMITED"
              }
            }
          },
          "then": {
            "required": [
              "retryAfterSeconds"
            ]
          },
          "else": {
            "not": {
              "required": [
                "retryAfterSeconds"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "CASE_CONTROLLED"
              }
            }
          },
          "then": {
            "required": [
              "caseId"
            ]
          },
          "else": {
            "not": {
              "required": [
                "caseId"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "CASE_SESSION_ENDED"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "$ref": "#/definitions/endedReason"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "WORK_LEASE_STALE"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "$ref": "#/definitions/leaseStaleReason"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "WORK_NOT_ELIGIBLE"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "$ref": "#/definitions/notEligibleReason"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "CREDENTIAL_REVOKED"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "revoked",
                  "replaced",
                  "refresh_replay"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "CASE_SESSION_ENDED",
                  "WORK_LEASE_STALE",
                  "WORK_NOT_ELIGIBLE",
                  "CREDENTIAL_REVOKED"
                ]
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        }
      ]
    },
    "legacyRequestFailed": {
      "description": "Today's settlement error body, kept while ENVOI_CASE_SESSIONS_V1 is off (§7.3).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "message",
        "requestId"
      ],
      "properties": {
        "error": {
          "const": "REQUEST_FAILED"
        },
        "message": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        }
      }
    },
    "mintRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaseToken"
      ],
      "properties": {
        "leaseToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "endRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaseToken",
        "sessionId"
      ],
      "properties": {
        "leaseToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sessionId": {
          "type": "string",
          "pattern": "^case_session_[A-Za-z0-9_-]+$"
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "token",
        "tokenType",
        "status",
        "transport",
        "agentId",
        "installationId",
        "workId",
        "workKind",
        "caseId",
        "fence",
        "counterparty",
        "allowedTools",
        "createdAt",
        "expiresAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^case_session_[A-Za-z0-9_-]+$"
        },
        "token": {
          "$ref": "#/definitions/sessionToken"
        },
        "tokenType": {
          "const": "Bearer"
        },
        "status": {
          "const": "active"
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "mcp_streamable_http"
            },
            "url": {
              "type": "string",
              "pattern": "^https://.+/mcp$"
            }
          }
        },
        "agentId": {
          "type": "string",
          "pattern": "^agent_[A-Za-z0-9_-]+$"
        },
        "installationId": {
          "type": "string",
          "pattern": "^installation_[A-Za-z0-9_-]+$"
        },
        "workId": {
          "type": "string",
          "pattern": "^msg_[A-Za-z0-9_-]+$"
        },
        "workKind": {
          "$ref": "#/definitions/workKind"
        },
        "caseId": {
          "type": "string",
          "pattern": "^case_[A-Za-z0-9_-]+$"
        },
        "fence": {
          "type": "integer",
          "minimum": 1
        },
