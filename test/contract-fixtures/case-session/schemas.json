    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "version",
        "id",
        "description",
        "kind",
        "client"
      ],
      "properties": {
        "contract": {
          "const": "case-session"
        },
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "http",
            "event",
            "sequence",
            "rollback"
          ]
        },
        "flags": {
          "$ref": "#/definitions/fixtureFlags"
        },
        "context": {
          "$ref": "#/definitions/fixtureContext"
        },
        "request": {
          "$ref": "#/definitions/fixtureRequest"
        },
        "response": {
          "$ref": "#/definitions/fixtureResponse"
        },
        "event": {
          "$ref": "#/definitions/eventFrame"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/fixtureStep"
          }
        },
        "client": {
          "$ref": "#/definitions/fixtureClient"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "http"
              }
            }
          },
          "then": {
            "required": [
              "request",
              "response"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "steps"
                  ]
                },
                {
                  "required": [
                    "event"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "event"
              }
            }
          },
          "then": {
            "required": [
              "event"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "request"
                  ]
                },
                {
                  "required": [
                    "steps"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "sequence",
                  "rollback"
                ]
              }
            }
          },
          "then": {
            "required": [
              "steps"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "request"
                  ]
                },
                {
                  "required": [
                    "event"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "rollback"
              }
            }
          },
          "then": {
            "required": [
              "flags"
            ]
          }
        }
      ]
    }
  }
