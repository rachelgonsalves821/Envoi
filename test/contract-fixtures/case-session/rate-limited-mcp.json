{
  "contract": "case-session",
  "version": 1,
  "id": "rate-limited-mcp",
  "kind": "http",
  "description": "Rate limited on /mcp; the session is unaffected.",
  "context": {
    "workKind": "agent_message",
    "permissions": [
      "send_agent_messages",
      "receive_agent_messages",
      "create_assets",
      "execute_cases"
    ],
    "allowedTools": [
      "envoi_case_snapshot",
      "envoi_case_reply",
      "envoi_case_propose",
      "envoi_case_decide",
      "envoi_authority_check",
      "envoi_request_human",
      "envoi_case_list_assets",
      "envoi_case_share_asset",
      "envoi_case_complete"
    ],
    "ended": {
      "credential_ended": false,
      "agent_paused": false,
      "case_controlled": false,
      "work_ineligible": false,
      "work_settled": false,
      "ended_by_host": false,
      "superseded": false,
      "lease_lost": false
    }
  },
  "request": {
    "method": "POST",
    "path": "/mcp",
    "auth": "case_session",
    "headers": {
      "authorization": "Bearer envoi_case_session_PLACEHOLDER_example",
      "content-type": "application/json",
      "accept": "application/json, text/event-stream",
      "mcp-protocol-version": "2025-11-25"
    },
    "schema": "jsonRpcRequest",
    "body": {
      "jsonrpc": "2.0",
      "id": 25,
      "method": "tools/call",
      "params": {
        "name": "envoi_case_snapshot",
        "arguments": {}
      }
    }
  },
  "response": {
    "status": 429,
    "schema": "errorEnvelope",
    "headers": {
      "cache-control": "no-store",
      "retry-after": "2"
    },
    "body": {
      "code": "RATE_LIMITED",
      "error": "RATE_LIMITED",
      "message": "Too many requests. Retry after the indicated delay.",
      "requestId": "req_example",
      "retryAfterSeconds": 2
    }
  },
  "client": {
    "surface": "tool_channel",
    "lifecycle": "UNCHANGED",
    "retry": "after_retry_after",
    "guidance": "service_busy",
    "turn": "continue",
    "next": "Wait for retry-after and retry the identical call."
  }
}
