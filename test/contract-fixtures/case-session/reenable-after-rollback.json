{
  "contract": "case-session",
  "version": 1,
  "id": "reenable-after-rollback",
  "kind": "rollback",
  "description": "The flag was turned off and on again within 900 s while the host kept its lease. The epoch moved (§1), so the earlier session is an unknown bearer; a new mint works.",
  "flags": {
    "ENVOI_CASE_SESSIONS_V1": true,
    "ENVOI_INSTALLATIONS_V2": true
  },
  "context": {
    "workKind": "agent_message",
    "permissions": [
      "send_agent_messages",
      "receive_agent_messages",
      "create_assets",
      "execute_cases"
    ]
  },
  "steps": [
    {
      "context": {
        "workKind": "agent_message",
        "permissions": [
          "send_agent_messages",
          "receive_agent_messages",
          "create_assets",
          "execute_cases"
        ],
        "allowedTools": [
          "envoi_case_snapshot",
          "envoi_case_reply",
          "envoi_case_propose",
          "envoi_case_decide",
          "envoi_authority_check",
          "envoi_request_human",
          "envoi_case_list_assets",
          "envoi_case_share_asset",
          "envoi_case_complete"
        ],
        "ended": {
          "credential_ended": false,
          "agent_paused": false,
          "case_controlled": false,
          "work_ineligible": false,
          "work_settled": false,
          "ended_by_host": false,
          "superseded": false,
          "lease_lost": false
        },
        "createdBeforeEpoch": true
      },
      "request": {
        "method": "POST",
        "path": "/mcp",
        "auth": "case_session",
        "headers": {
          "authorization": "Bearer envoi_case_session_PLACEHOLDER_example",
          "content-type": "application/json",
          "accept": "application/json, text/event-stream",
          "mcp-protocol-version": "2025-11-25"
        },
        "schema": "jsonRpcRequest",
        "body": {
          "jsonrpc": "2.0",
          "id": 38,
          "method": "tools/call",
          "params": {
            "name": "envoi_case_snapshot",
            "arguments": {}
          }
        }
      },
      "response": {
        "status": 401,
        "schema": "errorEnvelope",
        "headers": {
          "cache-control": "no-store",
          "www-authenticate": "Bearer realm=\"Envoi agent MCP\""
        },
        "body": {
          "code": "AUTHENTICATION_REQUIRED",
          "error": "AUTHENTICATION_REQUIRED",
          "message": "Authentication is required.",
          "requestId": "req_example"
        }
      },
      "client": {
        "surface": "tool_channel",
        "lifecycle": "UNCHANGED",
        "retry": "none",
        "guidance": "none",
        "turn": "cancel",
        "next": "The old session never works again."
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/agent/work/msg_example/session",
        "auth": "agent_access",
        "headers": {
          "authorization": "Bearer envoi_agent_access_PLACEHOLDER_example",
          "content-type": "application/json"
        },
        "schema": "mintRequest",
        "body": {
          "leaseToken": "lease_PLACEHOLDER_example"
        }
      },
      "response": {
        "status": 201,
        "schema": "sessionCreated",
        "headers": {
          "cache-control": "no-store"
        },
        "body": {
          "session": {
            "id": "case_session_second",
            "token": "envoi_case_session_PLACEHOLDER_second",
            "tokenType": "Bearer",
            "status": "active",
            "transport": {
              "kind": "mcp_streamable_http",
              "url": "https://envoi.example/mcp"
            },
            "agentId": "agent_example",
            "installationId": "installation_example",
            "workId": "msg_example",
            "workKind": "agent_message",
            "caseId": "case_example",
            "fence": 1,
            "counterparty": {
              "kind": "agent",
              "address": "counterparty@envoi.mail"
            },
            "allowedTools": [
              "envoi_case_snapshot",
              "envoi_case_reply",
              "envoi_case_propose",
              "envoi_case_decide",
              "envoi_authority_check",
              "envoi_request_human",
              "envoi_case_list_assets",
              "envoi_case_share_asset",
              "envoi_case_complete"
            ],
            "createdAt": "2026-10-17T12:10:00.000Z",
            "expiresAt": "2026-10-17T12:25:00.000Z"
          },
          "lease": {
            "workId": "msg_example",
            "leaseExpiresAt": "2026-10-17T12:10:40.000Z"
          }
        }
      },
      "client": {
        "surface": "host",
        "lifecycle": "RUNNING",
        "retry": "none",
        "guidance": "none",
        "turn": "start",
        "next": "Start a new turn from the snapshot."
      }
    }
  ],
  "client": {
    "surface": "host",
    "lifecycle": "RUNNING",
    "retry": "none",
    "guidance": "none",
    "turn": "start",
    "next": "Rollback cannot revive a session."
  }
}
