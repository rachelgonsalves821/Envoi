{
  "contract": "case-session",
  "version": 1,
  "id": "late-write-after-pause",
  "kind": "sequence",
  "description": "A write that committed before the pause stays durable; the identical write after it is rejected at the HTTP level; the host's renewal sees the pause.",
  "steps": [
    {
      "context": {
        "workKind": "agent_message",
        "permissions": [
          "send_agent_messages",
          "receive_agent_messages",
          "create_assets",
          "execute_cases"
        ],
        "allowedTools": [
          "envoi_case_snapshot",
          "envoi_case_reply",
          "envoi_case_propose",
          "envoi_case_decide",
          "envoi_authority_check",
          "envoi_request_human",
          "envoi_case_list_assets",
          "envoi_case_share_asset",
          "envoi_case_complete"
        ],
        "ended": {
          "credential_ended": false,
          "agent_paused": false,
          "case_controlled": false,
          "work_ineligible": false,
          "work_settled": false,
          "ended_by_host": false,
          "superseded": false,
          "lease_lost": false
        }
      },
      "request": {
        "method": "POST",
        "path": "/mcp",
        "auth": "case_session",
        "headers": {
          "authorization": "Bearer envoi_case_session_PLACEHOLDER_example",
          "content-type": "application/json",
          "accept": "application/json, text/event-stream",
          "mcp-protocol-version": "2025-11-25"
        },
        "schema": "jsonRpcRequest",
        "body": {
          "jsonrpc": "2.0",
          "id": 20,
          "method": "tools/call",
          "params": {
            "name": "envoi_case_reply",
            "arguments": {
              "text": "Example reply",
              "idempotencyKey": "reply-late"
            }
          }
        }
      },
      "response": {
        "status": 200,
        "schema": "mcpToolCallResult",
        "headers": {
          "content-type": "application/json; charset=utf-8",
          "cache-control": "no-store"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 20,
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"defined_by\":\"case-tools v1\"}"
              }
            ],
            "isError": false
          }
        }
      },
      "client": {
        "surface": "tool_channel",
        "lifecycle": "UNCHANGED",
        "retry": "none",
        "guidance": "none",
        "turn": "continue",
        "next": "The write committed before the pause."
      }
    },
    {
      "context": {
        "workKind": "agent_message",
        "permissions": [
          "send_agent_messages",
          "receive_agent_messages",
          "create_assets",
          "execute_cases"
        ],
        "allowedTools": [
          "envoi_case_snapshot",
          "envoi_case_reply",
          "envoi_case_propose",
          "envoi_case_decide",
          "envoi_authority_check",
          "envoi_request_human",
          "envoi_case_list_assets",
          "envoi_case_share_asset",
          "envoi_case_complete"
        ],
        "ended": {
          "credential_ended": false,
          "agent_paused": true,
          "case_controlled": false,
          "work_ineligible": false,
          "work_settled": false,
          "ended_by_host": false,
          "superseded": false,
          "lease_lost": true
        },
        "recordedReason": "agent_paused"
      },
      "request": {
        "method": "POST",
        "path": "/mcp",
        "auth": "case_session",
        "headers": {
          "authorization": "Bearer envoi_case_session_PLACEHOLDER_example",
          "content-type": "application/json",
          "accept": "application/json, text/event-stream",
          "mcp-protocol-version": "2025-11-25"
        },
        "schema": "jsonRpcRequest",
        "body": {
          "jsonrpc": "2.0",
          "id": 21,
          "method": "tools/call",
          "params": {
            "name": "envoi_case_reply",
            "arguments": {
              "text": "Example reply",
              "idempotencyKey": "reply-late"
            }
          }
        }
      },
      "response": {
        "status": 401,
        "schema": "errorEnvelope",
        "headers": {
          "cache-control": "no-store",
          "www-authenticate": "Bearer realm=\"Envoi agent MCP\", error=\"invalid_token\""
        },
        "body": {
          "code": "CASE_SESSION_ENDED",
          "error": "CASE_SESSION_ENDED",
          "message": "This case session has ended.",
          "requestId": "req_example",
          "reason": "agent_paused"
        }
      },
      "client": {
        "surface": "tool_channel",
        "lifecycle": "UNCHANGED",
        "retry": "after_resume",
        "guidance": "wait_for_resume",
        "turn": "cancel",
        "next": "Nothing was written. Cancel the turn."
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/agent/work/msg_example/renew",
        "auth": "agent_access",
        "headers": {
          "authorization": "Bearer envoi_agent_access_PLACEHOLDER_example",
          "content-type": "application/json"
        },
        "body": {
          "leaseToken": "lease_PLACEHOLDER_example"
        }
      },
      "response": {
        "status": 409,
        "schema": "errorEnvelope",
        "headers": {
          "cache-control": "no-store"
        },
        "body": {
          "code": "AGENT_PAUSED",
          "error": "AGENT_PAUSED",
          "message": "This agent is paused by its owner.",
          "requestId": "req_example"
        }
      },
      "client": {
        "surface": "host",
        "lifecycle": "PAUSED",
        "retry": "after_resume",
        "guidance": "wait_for_resume",
        "turn": "cancel",
        "next": "Cancel the turn, end the session and wait for agent.resumed."
      }
    }
  ],
  "client": {
    "surface": "host",
    "lifecycle": "RUNNING",
    "retry": "none",
    "guidance": "none",
    "turn": "cancel",
    "next": "Discard model output produced after the pause."
  }
}
