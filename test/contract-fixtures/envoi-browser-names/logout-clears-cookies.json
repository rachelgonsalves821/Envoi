{
  "contract": "envoi-browser-names",
  "version": 1,
  "id": "logout-clears-cookies",
  "description": "Logout with the Envoi cookies, the new CSRF header and a matching Origin passes the CSRF gate and clears new and old names.",
  "kind": "http",
  "request": {
    "method": "POST",
    "path": "/api/auth/logout",
    "headers": {
      "origin": "https://www.envoi-agents.com",
      "cookie": "envoi_session=PLACEHOLDER; envoi_csrf=PLACEHOLDER",
      "x-envoi-csrf": "PLACEHOLDER"
    }
  },
  "response": {
    "status": 200,
    "schema": "logoutResult",
    "body": {
      "revoked": true,
      "logoutUrl": "https://api.workos.com/user_management/sessions/logout?session_id=PLACEHOLDER&return_to=https%3A%2F%2Fwww.envoi-agents.com"
    },
    "headers": {
      "set-cookie": [
        "envoi_session=; Path=/; HttpOnly; SameSite=Lax; Secure; Max-Age=0",
        "envoi_csrf=; Path=/; SameSite=Strict; Secure; Max-Age=0",
        "sinaloa_session=; Path=/; HttpOnly; SameSite=Lax; Secure; Max-Age=0",
        "sinaloa_csrf=; Path=/; SameSite=Strict; Secure; Max-Age=0",
        "sinaloa_workos_flow=; Path=/api/auth/workos; HttpOnly; SameSite=Lax; Secure; Max-Age=0"
      ]
    }
  },
  "cookies": {
    "set": [],
    "cleared": [
      "envoi_session",
      "envoi_csrf",
      "sinaloa_session",
      "sinaloa_csrf",
      "sinaloa_workos_flow"
    ]
  },
  "client": {
    "lifecycle": "NOT_APPLICABLE",
    "retry": "none",
    "guidance": "none",
    "next": "Show signed out; go to logoutUrl when present."
  }
}
