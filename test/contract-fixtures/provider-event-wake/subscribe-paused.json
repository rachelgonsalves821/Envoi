        "delivery": {
          "mode": "webhook",
          "url": "https://dots.callbacks.example/envoi/events",
          "secret": "whsec_UExBQ0VIT0xERVItRklYVFVSRS1TRUNSRVQtMDAwMQ=="
        }
      }
    }
  },
  "response": {
    "status": 409,
    "schema": "errorEnvelope",
    "body": {
      "code": "AGENT_PAUSED",
      "error": "AGENT_PAUSED",
      "message": "This agent is paused by its owner.",
      "requestId": "req_example"
    }
  },
  "client": {
    "surface": "host",
    "lifecycle": "PAUSED",
