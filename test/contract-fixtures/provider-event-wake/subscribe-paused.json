{
  "contract": "provider-event-wake",
  "version": 1,
  "id": "subscribe-paused",
  "kind": "http",
  "description": "§7: HTTP 409 while the agent is paused, never a JSON-RPC result. Existing subscriptions get envoi.control_changed.",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": true,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_HTTP_WAKE_V1": true,
    "ENVOI_REMOTE_MCP_OAUTH": true,
    "ENVOI_PROVIDER_CONNECTORS": false,
    "ENVOI_MCP_EVENTS_V1": true,
    "ENVOI_GROK_TRIGGER_V1": true
  },
  "context": {
    "profile": "mcp_events",
    "route": "remote_mcp_oauth",
    "agentStatus": "paused",
    "callbackOriginAllowlist": [
      "https://dots.callbacks.example"
    ],
    "dns": {
      "host": "dots.callbacks.example",
      "addresses": [
        "192.0.43.11"
      ]
    }
  },
  "request": {
    "method": "POST",
    "path": "/mcp",
    "auth": "bearer",
    "headers": {
