{
  "contract": "a5-presence",
  "version": 1,
  "id": "owner-revoked-refresh-replay",
  "description": "A paused agent whose only credential family was revoked by REFRESH_REPLAY. The status is reported as revoked while paused stays true.",
  "kind": "http",
  "request": {
    "method": "GET",
    "path": "/api/inboxes/inbox_example/agents",
    "auth": "human_session"
  },
  "response": {
    "status": 200,
    "schema": "ownerAgentList",
    "body": [
      {
        "id": "agent_example",
        "name": "Example agent",
        "slug": "example",
        "address": "example@envoi.mail",
        "platformAddress": "example@envoi.mail",
        "status": "revoked",
        "onboardingStatus": "approved",
        "permissions": [],
        "createdAt": "2026-10-01T09:00:00.000Z",
        "paused": true,
        "credentialRevoked": true,
        "connection": {
          "state": "revoked",
          "asOf": "2026-10-12T12:00:42.000Z",
          "recentWindowSeconds": 300,
          "seenAt": "2026-10-12T11:40:00.000Z",
          "credentialExpiresAt": null,
          "presence": {
            "lastSeenAt": "2026-10-12T11:40:00.000Z",
            "lastSuccessfulRefreshAt": "2026-10-12T11:40:00.000Z",
            "lastWorkClaimAt": "2026-10-12T09:15:00.000Z",
            "lastProcessedAt": null
          }
        }
      }
    ]
  },
  "client": {
    "surface": "owner_ui",
    "connectionLabel": "Access revoked",
    "agentLabel": "Revoked",
    "next": "Show \"Revoked · Access revoked\"; revocation outranks pause. Offer re-enrollment."
  }
}
