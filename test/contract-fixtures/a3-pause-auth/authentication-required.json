{
  "contract": "a3-pause-auth",
  "version": 1,
  "id": "authentication-required",
  "description": "The bearer token is unknown to the server, or belongs to another inbox.",
  "kind": "http",
  "request": {
    "method": "POST",
    "path": "/api/agent/work/claim",
    "headers": {
      "authorization": "Bearer sinaloa_agent_access_PLACEHOLDER_unknown",
      "content-type": "application/json"
    },
    "body": {}
  },
  "response": {
    "status": 401,
    "schema": "errorEnvelope",
    "body": {
      "code": "AUTHENTICATION_REQUIRED",
      "error": "AUTHENTICATION_REQUIRED",
      "message": "A valid agent credential is required.",
      "requestId": "req_example"
    }
  },
  "client": {
    "lifecycle": "UNCHANGED",
    "retry": "refresh_then_retry_once",
    "guidance": "none",
    "next": "Refresh once if a refresh token is stored; then follow the refresh result."
  }
}
