{
  "contract": "a3-pause-auth",
  "version": 1,
  "id": "credential-expired-refresh",
  "description": "The family passed its rolling inactivity expiry, for example after more than 30 days offline while paused.",
  "kind": "http",
  "request": {
    "method": "POST",
    "path": "/api/agent-token",
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "grantType": "refresh_token",
      "agentRefreshToken": "sinaloa_agent_refresh_PLACEHOLDER_expired",
      "rotationId": "rotation_PLACEHOLDER_0001"
    }
  },
  "response": {
    "status": 401,
    "schema": "errorEnvelope",
    "body": {
      "code": "CREDENTIAL_EXPIRED",
      "error": "CREDENTIAL_EXPIRED",
      "message": "This agent credential expired after inactivity. Ask the owner to reconnect this agent.",
      "requestId": "req_example"
    }
  },
  "client": {
    "lifecycle": "NEEDS_RECONNECT",
    "retry": "none",
    "guidance": "owner_reconnect",
    "next": "Wait for the owner to reconnect the same identity; do not enroll a new agent."
  }
}
