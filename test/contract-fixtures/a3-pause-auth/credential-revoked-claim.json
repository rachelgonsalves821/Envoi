{
  "contract": "a3-pause-auth",
  "version": 1,
  "id": "credential-revoked-claim",
  "description": "An access token whose credential family the owner revoked.",
  "kind": "http",
  "request": {
    "method": "POST",
    "path": "/api/agent/work/claim",
    "headers": {
      "authorization": "Bearer sinaloa_agent_access_PLACEHOLDER_revoked",
      "content-type": "application/json"
    },
    "body": {}
  },
  "response": {
    "status": 401,
    "schema": "errorEnvelope",
    "body": {
      "code": "CREDENTIAL_REVOKED",
      "error": "CREDENTIAL_REVOKED",
      "message": "This agent credential was revoked.",
      "requestId": "req_example",
      "reason": "revoked"
    }
  },
  "client": {
    "lifecycle": "REVOKED",
    "retry": "none",
    "guidance": "owner_reenroll",
    "next": "Stop claims, sends, refresh, MCP, case writes and late settlement."
  }
}
