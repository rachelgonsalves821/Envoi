{
  "contract": "a3-pause-auth",
  "version": 1,
  "id": "credential-revoked-refresh",
  "description": "A refresh token whose credential family was revoked.",
  "kind": "http",
  "request": {
    "method": "POST",
    "path": "/api/agent-token",
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "grantType": "refresh_token",
      "agentRefreshToken": "sinaloa_agent_refresh_PLACEHOLDER_revoked",
      "rotationId": "rotation_PLACEHOLDER_0001"
    }
  },
  "response": {
    "status": 401,
    "schema": "errorEnvelope",
    "body": {
      "code": "CREDENTIAL_REVOKED",
      "error": "CREDENTIAL_REVOKED",
      "message": "This agent credential was revoked.",
      "requestId": "req_example"
    }
  },
  "client": {
    "lifecycle": "REVOKED",
    "retry": "none",
    "guidance": "owner_reenroll",
    "next": "Stop all activity, including refresh."
  }
}
