{
  "contract": "a3-pause-auth",
  "version": 1,
  "id": "refresh-replay",
  "description": "An already-used refresh token presented with a different rotationId.",
  "kind": "http",
  "request": {
    "method": "POST",
    "path": "/api/agent-token",
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "grantType": "refresh_token",
      "agentRefreshToken": "sinaloa_agent_refresh_PLACEHOLDER_used",
      "rotationId": "rotation_PLACEHOLDER_9999"
    }
  },
  "response": {
    "status": 401,
    "schema": "errorEnvelope",
    "body": {
      "code": "REFRESH_REPLAY",
      "error": "REFRESH_REPLAY",
      "message": "This refresh token was already used by another request. Ask the owner to reconnect the agent.",
      "requestId": "req_example"
    }
  },
  "client": {
    "lifecycle": "NEEDS_RECONNECT",
    "retry": "none",
    "guidance": "owner_reconnect",
    "next": "Do not retry with another rotationId; wait for the owner."
  }
}
