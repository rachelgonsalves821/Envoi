{
  "$id": "a3-pause-auth/schemas.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "a3-pause-auth v1 schemas. Fixtures name a definition in response.schema or event.schema. x-codes is the code table from handoffs.md §2.",
  "x-codes": {
    "AGENT_PAUSED": {
      "status": 409,
      "lifecycle": "PAUSED",
      "retry": "after_resume",
      "guidance": "wait_for_resume"
    },
    "CREDENTIAL_REVOKED": {
      "status": 401,
      "lifecycle": "REVOKED",
      "retry": "none",
      "guidance": "owner_reenroll",
      "guidanceByReason": {
        "revoked": "owner_reenroll",
        "refresh_replay": "owner_reenroll",
        "replaced": "replaced_by_reconnect"
      }
    },
    "CREDENTIAL_EXPIRED": {
      "status": 401,
      "lifecycle": "NEEDS_RECONNECT",
      "retry": "none",
      "guidance": "owner_reconnect"
    },
    "ACCESS_TOKEN_EXPIRED": {
      "status": 401,
      "lifecycle": "UNCHANGED",
      "retry": "refresh_then_retry_once",
      "guidance": "none"
    },
    "AUTHENTICATION_REQUIRED": {
      "status": 401,
      "lifecycle": "UNCHANGED",
      "retry": "refresh_then_retry_once",
      "guidance": "none"
    },
    "ROTATION_ID_REQUIRED": {
      "status": 400,
      "lifecycle": "NEEDS_RECONNECT",
      "retry": "none",
      "guidance": "update_connector"
    },
    "REFRESH_TOKEN_INVALID": {
      "status": 401,
      "lifecycle": "NEEDS_RECONNECT",
      "retry": "none",
      "guidance": "owner_reconnect"
    },
    "REFRESH_REPLAY": {
      "status": 401,
      "lifecycle": "REVOKED",
      "retry": "none",
      "guidance": "owner_reenroll"
    },
    "REFRESH_RECOVERY_EXPIRED": {
      "status": 401,
      "lifecycle": "NEEDS_RECONNECT",
      "retry": "none",
      "guidance": "owner_reconnect"
    },
    "CASE_CONTROLLED": {
      "status": 409,
      "lifecycle": "UNCHANGED",
      "retry": "after_case_resume",
      "guidance": "case_paused"
    },
    "ACCOUNT_CHANGED": {
      "status": 409,
      "lifecycle": "NOT_APPLICABLE",
      "retry": "none",
      "guidance": "reload_browser"
    },
    "RATE_LIMITED": {
      "status": 429,
      "lifecycle": "DEGRADED",
      "retry": "after_retry_after",
      "guidance": "service_busy"
    },
    "INTERNAL_SERVER_ERROR": {
      "status": 500,
      "lifecycle": "DEGRADED",
      "retry": "backoff",
      "guidance": "service_unavailable"
    },
    "AUTH_UNAVAILABLE": {
      "status": 503,
      "lifecycle": "DEGRADED",
      "retry": "backoff",
      "guidance": "service_unavailable"
    }
  },
  "definitions": {
    "lifecycle": {
      "enum": [
        "STARTING",
        "RUNNING",
        "DEGRADED",
        "PAUSED",
        "NEEDS_RECONNECT",
        "REVOKED",
        "STOPPED",
        "UNCHANGED",
        "NOT_APPLICABLE"
      ]
    },
    "guidance": {
      "enum": [
        "none",
        "wait_for_resume",
        "owner_reenroll",
        "replaced_by_reconnect",
        "owner_reconnect",
        "update_connector",
        "case_paused",
        "reload_browser",
        "service_busy",
        "service_unavailable"
      ]
    },
    "errorCode": {
      "enum": [
        "AGENT_PAUSED",
        "CREDENTIAL_REVOKED",
        "CREDENTIAL_EXPIRED",
        "ACCESS_TOKEN_EXPIRED",
        "AUTHENTICATION_REQUIRED",
        "ROTATION_ID_REQUIRED",
        "REFRESH_TOKEN_INVALID",
        "REFRESH_REPLAY",
        "REFRESH_RECOVERY_EXPIRED",
        "CASE_CONTROLLED",
        "ACCOUNT_CHANGED",
        "RATE_LIMITED",
        "INTERNAL_SERVER_ERROR",
        "AUTH_UNAVAILABLE"
      ]
    },
    "errorEnvelope": {
      "type": "object",
      "required": [
        "code",
        "error",
        "message",
        "requestId"
      ],
      "properties": {
        "code": {
          "$ref": "#/definitions/errorCode"
        },
        "error": {
          "$ref": "#/definitions/errorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "not": {
            "pattern": "(?:sinaloa_agent_(?:access|refresh)_|sinaloa_mcp_read_|sinaloa_enroll_)"
          }
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "retryAfterSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "caseId": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "enum": [
            "revoked",
            "replaced",
            "refresh_replay"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "RATE_LIMITED"
              }
            }
          },
          "then": {
            "required": [
              "retryAfterSeconds"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "CASE_CONTROLLED"
              }
            }
          },
          "then": {
            "required": [
              "caseId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "CREDENTIAL_REVOKED"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          },
          "else": {
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        }
      ]
    },
    "tokenPair": {
      "type": "object",
      "required": [
        "agentApiToken",
        "agentRefreshToken",
        "agentTokenExpiresAt",
        "agentRefreshTokenExpiresAt",
        "tokenType"
      ],
      "properties": {
        "agentApiToken": {
          "type": "string",
          "pattern": "^sinaloa_agent_access_"
        },
        "agentRefreshToken": {
          "type": "string",
          "pattern": "^sinaloa_agent_refresh_"
        },
        "agentTokenExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "agentRefreshTokenExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "tokenType": {
          "const": "Bearer"
        }
      }
    },
    "claimPaused": {
      "type": "object",
      "required": [
        "work",
        "state"
      ],
      "properties": {
        "work": {
          "type": "null"
        },
        "state": {
          "const": "paused"
        }
      }
    },
    "claimIdle": {
      "type": "object",
      "required": [
        "work",
        "state"
      ],
      "properties": {
        "work": {
          "type": "null"
        },
        "state": {
          "const": "idle"
        }
      }
    },
    "claimClaimed": {
      "type": "object",
      "required": [
        "work",
        "state"
      ],
      "properties": {
        "state": {
          "const": "claimed"
        },
        "work": {
          "type": "object",
          "required": [
            "workId",
            "message",
            "leaseToken",
            "leaseExpiresAt"
          ],
          "properties": {
            "workId": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "oneOf": [
                {
                  "$ref": "#/definitions/nativeWorkMessage"
                },
                {
                  "$ref": "#/definitions/humanInstructionWorkMessageRef"
                }
              ]
            },
            "leaseToken": {
              "type": "string",
              "minLength": 1
            },
            "leaseExpiresAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "nativeWorkMessage": {
      "description": "The stored native agent message exactly as claim returns it today (unchanged by v1). Clients reject work without these fields.",
      "type": "object",
      "required": [
        "id",
        "messageId",
        "caseId",
        "conversationId",
        "senderType",
        "senderAgentId",
        "senderInboxId",
        "recipientAgentId",
        "recipientInboxId",
        "recipientEmail",
        "from",
        "to",
        "transport",
        "type",
        "text",
        "status",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "messageId": {
          "type": "string",
          "minLength": 1
        },
        "caseId": {
          "type": "string",
          "minLength": 1
        },
        "conversationId": {
          "type": "string",
          "minLength": 1
        },
        "senderType": {
          "const": "agent"
        },
        "senderAgentId": {
          "type": "string",
          "minLength": 1
        },
        "senderInboxId": {
          "type": "string",
          "minLength": 1
        },
        "recipientAgentId": {
          "type": "string",
          "minLength": 1
        },
        "recipientInboxId": {
          "type": "string",
          "minLength": 1
        },
        "recipientEmail": {
          "type": "string",
          "minLength": 3
        },
        "from": {
          "type": "object",
          "required": [
            "agentId",
            "address"
          ],
          "properties": {
            "agentId": {
              "type": "string",
              "minLength": 1
            },
            "address": {
              "type": "string",
              "minLength": 3
            }
          },
          "not": {
            "required": [
              "humanId"
            ]
          }
        },
        "to": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "agentId",
              "address"
            ]
          }
        },
        "transport": {
          "const": "native"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "status": {
          "enum": [
            "delivered",
            "acknowledged"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "senderHumanId"
            ]
          },
          {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "humanInstruction"
              }
            }
          }
        ]
      }
    },
    "humanInstructionWorkMessageRef": {
      "description": "Human instructions (claimed with acceptHumanInstructions: true) keep their current shape; v1 does not restate it.",
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "humanInstruction"
        }
      }
    },
    "agentSummary": {
      "type": "object",
      "required": [
        "id",
        "address",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "paused"
          ]
        }
      }
    },
    "agentStatus": {
      "type": "object",
      "required": [
        "state",
        "agent",
        "inboxId"
      ],
      "properties": {
        "state": {
          "enum": [
            "active",
            "paused"
          ]
        },
        "agent": {
          "$ref": "#/definitions/agentSummary"
        },
        "inboxId": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "paused"
              }
            }
          },
          "then": {
            "properties": {
              "agent": {
                "properties": {
                  "status": {
                    "const": "paused"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "active"
              }
            }
          },
          "then": {
            "properties": {
              "agent": {
                "properties": {
                  "status": {
                    "const": "active"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "pausedAgentStatus": {
      "allOf": [
        {
          "$ref": "#/definitions/agentStatus"
        },
        {
          "properties": {
            "state": {
              "const": "paused"
            }
          }
        }
      ]
    },
    "sendAccepted": {
      "description": "A fresh send (202). Always queued, and never reveals a pause or a barrier to the sender.",
      "type": "object",
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "caseId": {
          "type": "string"
        },
        "status": {
          "const": "queued"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "heldReason"
            ]
          },
          {
            "required": [
              "heldBehindMessageId"
            ]
          },
          {
            "required": [
              "heldAt"
            ]
          }
        ]
      }
    },
    "messageRecord": {
      "type": "object",
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "caseId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "heldReason": {
          "enum": [
            "sender_paused",
            "case_ordering"
          ]
        },
        "heldAt": {
          "type": "string",
          "format": "date-time"
        },
        "heldBehindMessageId": {
          "type": "string"
        },
        "cancelledAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "held"
              }
            }
          },
          "then": {
            "required": [
              "heldReason",
              "heldAt"
            ]
          }
        },
        {
          "if": {
            "required": [
              "heldReason"
            ],
            "properties": {
              "heldReason": {
                "const": "case_ordering"
              }
            }
          },
          "then": {
            "required": [
              "heldBehindMessageId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "required": [
              "cancelledAt"
            ]
          }
        }
      ]
    },
    "heldSenderMessageList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/messageRecord"
      },
      "contains": {
        "properties": {
          "status": {
            "const": "held"
          },
          "heldReason": {
            "const": "sender_paused"
          }
        },
        "required": [
          "status",
          "heldReason"
        ]
      }
    },
    "cancelledMessage": {
      "allOf": [
        {
          "$ref": "#/definitions/messageRecord"
        },
        {
          "properties": {
            "status": {
              "const": "cancelled"
            }
          }
        }
      ]
    },
    "reconnectTokenIssued": {
      "type": "object",
      "required": [
        "enrollmentId",
        "enrollmentToken",
        "expiresAt",
        "agentId",
        "quickConnect"
      ],
      "properties": {
        "enrollmentId": {
          "type": "string"
        },
        "enrollmentToken": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "agentId": {
          "type": "string"
        },
        "quickConnect": {
          "type": "object",
          "required": [
            "operation"
          ],
          "properties": {
            "operation": {
              "const": "reconnect"
            }
          }
        }
      }
    },
    "reconnectRedeemed": {
      "allOf": [
        {
          "$ref": "#/definitions/tokenPair"
        },
        {
          "type": "object",
          "required": [
            "agent",
            "inbox",
            "nativeMessaging"
          ],
          "properties": {
            "agent": {
              "allOf": [
                {
                  "$ref": "#/definitions/agentSummary"
                },
                {
                  "properties": {
                    "status": {
                      "const": "paused"
                    }
                  }
                }
              ]
            },
            "inbox": {
              "type": "object",
              "required": [
                "id"
              ]
            },
            "nativeMessaging": {
              "const": "ready"
            }
          }
        }
      ]
    },
    "eventBase": {
      "type": "object",
      "required": [
        "id",
        "type",
        "createdAt",
        "sequence",
        "cursor"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "cursor": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "agentPausedEvent": {
      "allOf": [
        {
          "$ref": "#/definitions/eventBase"
        },
        {
          "required": [
            "agentId",
            "humanId",
            "status"
          ],
          "properties": {
            "type": {
              "const": "agent.paused"
            },
            "agentId": {
              "type": "string"
            },
            "humanId": {
              "type": "string"
            },
            "status": {
              "const": "paused"
            }
          }
        }
      ]
    },
    "agentResumedEvent": {
      "allOf": [
        {
          "$ref": "#/definitions/eventBase"
        },
        {
          "required": [
            "agentId",
            "humanId",
            "status"
          ],
          "properties": {
            "type": {
              "const": "agent.resumed"
            },
            "agentId": {
              "type": "string"
            },
            "humanId": {
              "type": "string"
            },
            "status": {
              "const": "active"
            }
          }
        }
      ]
    },
    "workAvailableEvent": {
      "allOf": [
        {
          "$ref": "#/definitions/eventBase"
        },
        {
          "required": [
            "agentId",
            "reason"
          ],
          "properties": {
            "type": {
              "const": "work.available"
            },
            "agentId": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "messageCancelledEvent": {
      "allOf": [
        {
          "$ref": "#/definitions/eventBase"
        },
        {
          "required": [
            "messageId",
            "caseId",
            "humanId"
          ],
          "properties": {
            "type": {
              "const": "message.cancelled"
            },
            "messageId": {
              "type": "string"
            },
            "caseId": {
              "type": "string"
            },
            "humanId": {
              "type": "string"
            }
          }
        }
      ]
    },
    "credentialEndedEvent": {
      "description": "Stream control event: no SSE id, not persisted, does not advance the cursor. The stream closes after it.",
      "type": "object",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "enum": [
            "CREDENTIAL_REVOKED",
            "CREDENTIAL_EXPIRED"
          ]
        },
        "reason": {
          "enum": [
            "revoked",
            "replaced",
            "refresh_replay"
          ]
        }
      },
      "additionalProperties": false
    },
    "edgeText": {
      "type": "string"
    },
    "fixture": {
      "type": "object",
      "required": [
        "contract",
        "version",
        "id",
        "description",
        "kind",
        "client"
      ],
      "properties": {
        "contract": {
          "const": "a3-pause-auth"
        },
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "http",
            "sse",
            "network"
          ]
        },
        "request": {
          "type": "object",
          "required": [
            "method",
            "path"
          ],
          "properties": {
            "method": {
              "enum": [
                "GET",
                "POST"
              ]
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "headers": {
              "type": "object"
            }
          }
        },
        "response": {
          "type": "object",
          "required": [
            "status",
            "schema"
          ],
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "headers": {
              "type": "object"
            },
            "schema": {
              "type": "string"
            }
          },
          "oneOf": [
            {
              "required": [
                "body"
              ]
            },
            {
              "required": [
                "bodyText"
              ]
            }
          ]
        },
        "event": {
          "type": "object",
          "required": [
            "schema",
            "event",
            "data"
          ],
          "properties": {
            "schema": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "event": {
              "type": "string"
            },
            "data": {
              "type": "object"
            }
          }
        },
        "network": {
          "type": "object",
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "type": "string"
            }
          }
        },
        "client": {
          "type": "object",
          "required": [
            "lifecycle",
            "retry",
            "guidance",
            "next"
          ],
          "properties": {
            "lifecycle": {
              "$ref": "#/definitions/lifecycle"
            },
            "retry": {
              "enum": [
                "none",
                "refresh_then_retry_once",
                "after_retry_after",
                "backoff",
                "after_resume",
                "after_case_resume"
              ]
            },
            "guidance": {
              "$ref": "#/definitions/guidance"
            },
            "next": {
