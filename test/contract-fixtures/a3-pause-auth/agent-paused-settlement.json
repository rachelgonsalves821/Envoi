{
  "contract": "a3-pause-auth",
  "version": 1,
  "id": "agent-paused-settlement",
  "description": "A lease claimed before the pause is settled after it. The lease is invalid and no attempt is counted.",
  "kind": "http",
  "request": {
    "method": "POST",
    "path": "/api/agent/work/msg_example/complete",
    "headers": {
      "authorization": "Bearer sinaloa_agent_access_PLACEHOLDER_paused",
      "content-type": "application/json",
      "idempotency-key": "idem_PLACEHOLDER_0002"
    },
    "body": {
      "leaseToken": "lease_PLACEHOLDER"
    }
  },
  "response": {
    "status": 409,
    "schema": "errorEnvelope",
    "body": {
      "code": "AGENT_PAUSED",
      "error": "AGENT_PAUSED",
      "message": "This agent is paused by its owner.",
      "requestId": "req_example"
    }
  },
  "client": {
    "lifecycle": "PAUSED",
    "retry": "after_resume",
    "guidance": "wait_for_resume",
    "next": "Drop the local lease; the work is offered again with a new fence after resume."
  }
}
