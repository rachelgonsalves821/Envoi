{
  "contract": "a3-pause-auth",
  "version": 1,
  "id": "case-controlled",
  "description": "An active agent writes to a case a human paused.",
  "kind": "http",
  "request": {
    "method": "POST",
    "path": "/api/inboxes/inbox_example/messages",
    "headers": {
      "authorization": "Bearer sinaloa_agent_access_PLACEHOLDER_active",
      "content-type": "application/json",
      "idempotency-key": "idem_PLACEHOLDER_0001"
    },
    "body": {
      "senderAgentId": "agent_example",
      "recipientEmail": "counterparty@sinaloa.mail",
      "caseId": "case_example",
      "text": "Example message"
    }
  },
  "response": {
    "status": 409,
    "schema": "errorEnvelope",
    "body": {
      "code": "CASE_CONTROLLED",
      "error": "CASE_CONTROLLED",
      "message": "This case is paused or revoked by a human.",
      "requestId": "req_example",
      "caseId": "case_example"
    }
  },
  "client": {
    "lifecycle": "UNCHANGED",
    "retry": "after_case_resume",
    "guidance": "case_paused",
    "next": "Skip this case; keep working other cases."
  }
}
