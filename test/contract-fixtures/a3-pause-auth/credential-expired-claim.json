{
  "contract": "a3-pause-auth",
  "version": 1,
  "id": "credential-expired-claim",
  "description": "An access token from a family that passed its inactivity expiry.",
  "kind": "http",
  "request": {
    "method": "POST",
    "path": "/api/agent/work/claim",
    "headers": {
      "authorization": "Bearer sinaloa_agent_access_PLACEHOLDER_expired_family",
      "content-type": "application/json"
    },
    "body": {}
  },
  "response": {
    "status": 401,
    "schema": "errorEnvelope",
    "body": {
      "code": "CREDENTIAL_EXPIRED",
      "error": "CREDENTIAL_EXPIRED",
      "message": "This agent credential expired after inactivity. Ask the owner to reconnect it.",
      "requestId": "req_example"
    }
  },
  "client": {
    "lifecycle": "NEEDS_RECONNECT",
    "retry": "none",
    "guidance": "owner_reconnect",
    "next": "Do not refresh; wait for the owner to reconnect."
  }
}
