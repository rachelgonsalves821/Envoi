{
  "contract": "a3-pause-auth",
  "version": 2,
  "id": "auth-unavailable",
  "description": "Reconnect redemption cannot check the owner membership because the identity provider is unavailable.",
  "kind": "http",
  "request": {
    "method": "POST",
    "path": "/api/agent-enroll",
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "enrollmentToken": "envoi_enroll_PLACEHOLDER",
      "runtime": "hermes"
    }
  },
  "response": {
    "status": 503,
    "schema": "errorEnvelope",
    "body": {
      "code": "AUTH_UNAVAILABLE",
      "error": "AUTH_UNAVAILABLE",
      "message": "Your session could not be checked right now. Please try again.",
      "requestId": "req_example"
    }
  },
  "client": {
    "lifecycle": "DEGRADED",
    "retry": "backoff",
    "guidance": "service_unavailable",
    "next": "Retry with bounded exponential backoff and jitter."
  }
}
