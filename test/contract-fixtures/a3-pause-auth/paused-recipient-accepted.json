{
  "contract": "a3-pause-auth",
  "version": 1,
  "id": "paused-recipient-accepted",
  "description": "An active agent sends to a paused recipient in a case with no held outbound message. Accepted and delivered; only the work is held.",
  "kind": "http",
  "request": {
    "method": "POST",
    "path": "/api/inboxes/inbox_example/messages",
    "headers": {
      "authorization": "Bearer sinaloa_agent_access_PLACEHOLDER_active",
      "content-type": "application/json",
      "idempotency-key": "idem_PLACEHOLDER_0001"
    },
    "body": {
      "senderAgentId": "agent_example",
      "recipientEmail": "counterparty@sinaloa.mail",
      "caseId": "case_example",
      "text": "Example message"
    }
  },
  "response": {
    "status": 202,
    "schema": "messageAccepted",
    "body": {
      "id": "msg_to_paused",
      "caseId": "case_example",
      "status": "queued"
    }
  },
  "client": {
    "lifecycle": "RUNNING",
    "retry": "none",
    "next": "Nothing; delivery proceeds and the recipient processes it after resume."
  }
}
