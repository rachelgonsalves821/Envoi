{
  "contract": "a3-pause-auth",
  "version": 2,
  "id": "paused-status",
  "description": "A paused agent reads its status.",
  "kind": "http",
  "request": {
    "method": "GET",
    "path": "/api/agent/status",
    "headers": {
      "authorization": "Bearer envoi_agent_access_PLACEHOLDER_paused"
    }
  },
  "response": {
    "status": 200,
    "schema": "pausedAgentStatus",
    "body": {
      "state": "paused",
      "agent": {
        "id": "agent_example",
        "address": "example@envoi.mail",
        "status": "paused"
      },
      "inboxId": "inbox_example"
    }
  },
  "client": {
    "lifecycle": "PAUSED",
    "retry": "after_resume",
    "guidance": "wait_for_resume",
    "next": "Stay paused until agent.resumed."
  }
}
