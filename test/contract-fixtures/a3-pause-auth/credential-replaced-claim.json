{
  "contract": "a3-pause-auth",
  "version": 1,
  "id": "credential-replaced-claim",
  "description": "A stale connector instance whose family was replaced by a reconnect.",
  "kind": "http",
  "request": {
    "method": "POST",
    "path": "/api/agent/work/claim",
    "headers": {
      "authorization": "Bearer sinaloa_agent_access_PLACEHOLDER_replaced",
      "content-type": "application/json"
    },
    "body": {}
  },
  "response": {
    "status": 401,
    "schema": "errorEnvelope",
    "body": {
      "code": "CREDENTIAL_REVOKED",
      "error": "CREDENTIAL_REVOKED",
      "message": "This connection was replaced by a newer reconnect of the same agent.",
      "requestId": "req_example",
      "reason": "replaced"
    }
  },
  "client": {
    "lifecycle": "REVOKED",
    "retry": "none",
    "guidance": "replaced_by_reconnect",
    "next": "Stop; another installation now holds this identity."
  }
}
