{
  "$id": "agent-remote-auth-message-access/schemas.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "messageAccessReply": {
    "type": "object",
    "required": [
      "jsonrpc",
      "id",
      "result"
    ],
    "additionalProperties": false,
    "properties": {
      "jsonrpc": {
        "const": "2.0"
      },
      "id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ]
      },
      "result": {
        "type": "object",
        "required": [
          "content",
          "structuredContent",
          "isError"
        ],
        "additionalProperties": false,
        "properties": {
          "content": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "type",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "text"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "structuredContent": {
            "type": "object",
            "required": [
              "state",
              "address",
              "permissions"
            ],
            "additionalProperties": false,
            "properties": {
              "state": {
                "enum": [
                  "ready",
                  "permission_required",
                  "policy_blocked"
                ]
              },
              "address": {
                "type": "string"
              },
              "permissions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "isError": {
            "type": "boolean"
          },
          "_meta": {
            "type": "object",
            "required": [
              "mcp/www_authenticate"
            ],
            "additionalProperties": false,
            "properties": {
              "mcp/www_authenticate": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
