{
  "contract": "agent-remote-auth",
  "version": 1,
  "id": "token-refresh-replay",
  "description": "The old refresh token after a successor was used: replay. The family is revoked as refresh_replay.",
  "kind": "sequence",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": true,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_REMOTE_MCP_OAUTH": true,
    "ENVOI_PROVIDER_CONNECTORS": false
  },
  "steps": [
    {
      "note": "Rotation.",
      "request": {
        "method": "POST",
        "path": "/oauth/token",
        "auth": "public_client",
        "headers": {
          "content-type": "application/x-www-form-urlencoded"
        },
        "form": {
          "grant_type": "refresh_token",
          "refresh_token": "envoi_agent_refresh_PLACEHOLDER_oauth_1",
          "client_id": "https://assistant.example.com/oauth/envoi-client.json"
        }
      },
      "response": {
        "status": 200,
        "schema": "tokenResponse",
        "headers": {
          "cache-control": "no-store",
          "pragma": "no-cache"
        },
        "body": {
          "access_token": "envoi_agent_access_PLACEHOLDER_oauth_2",
          "token_type": "Bearer",
          "expires_in": 900,
          "refresh_token": "envoi_agent_refresh_PLACEHOLDER_oauth_2",
          "scope": "envoi.agent envoi.send"
        }
      }
    },
    {
      "note": "The successor is used.",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "auth": "bearer",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json, text/event-stream",
          "authorization": "Bearer envoi_agent_access_PLACEHOLDER_oauth_2"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "envoi_agent_info",
            "arguments": {}
          }
        }
      },
      "response": {
        "status": 200,
        "schema": "mcpResult",
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "result": {
            "content": [
              {
                "type": "text",
                "text": "identity"
              }
            ]
          }
        }
      }
    },
    {
      "note": "The old refresh token again.",
      "request": {
        "method": "POST",
        "path": "/oauth/token",
        "auth": "public_client",
        "headers": {
          "content-type": "application/x-www-form-urlencoded"
        },
        "form": {
          "grant_type": "refresh_token",
          "refresh_token": "envoi_agent_refresh_PLACEHOLDER_oauth_1",
          "client_id": "https://assistant.example.com/oauth/envoi-client.json"
        }
      },
      "response": {
        "status": 400,
        "schema": "oauthError",
        "headers": {
          "cache-control": "no-store",
          "pragma": "no-cache"
        },
        "body": {
          "error": "invalid_grant",
          "error_description": "The authorization grant is invalid, expired, already used or revoked."
        }
      }
    },
    {
      "note": "Every token of the family is revoked.",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "auth": "bearer",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json, text/event-stream",
          "authorization": "Bearer envoi_agent_access_PLACEHOLDER_oauth_2"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "envoi_agent_info",
            "arguments": {}
          }
        }
      },
      "response": {
        "status": 401,
        "schema": "errorEnvelope",
        "body": {
          "code": "CREDENTIAL_REVOKED",
          "error": "CREDENTIAL_REVOKED",
          "message": "This connection was revoked.",
          "requestId": "req_example",
          "reason": "refresh_replay"
        },
        "headers": {
          "www-authenticate": "Bearer resource_metadata=\"https://www.envoi-agents.com/.well-known/oauth-protected-resource/mcp\", scope=\"envoi.agent envoi.send\", error=\"invalid_token\""
        }
      },
      "client": {
        "surface": "host",
        "lifecycle": "REVOKED",
        "retry": "none",
        "guidance": "owner_reconnect",
        "next": "Stop. The installation ended with refresh_replay; the owner can reconnect the agent."
      }
    }
  ]
}
