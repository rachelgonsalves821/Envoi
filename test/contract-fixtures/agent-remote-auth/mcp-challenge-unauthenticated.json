{
  "contract": "agent-remote-auth",
  "version": 1,
  "id": "mcp-challenge-unauthenticated",
  "description": "No token at /mcp: 401 with the RFC 9728 challenge and the starting scope set.",
  "kind": "http",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": true,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_REMOTE_MCP_OAUTH": true,
    "ENVOI_PROVIDER_CONNECTORS": false
  },
  "request": {
    "method": "POST",
    "path": "/mcp",
    "auth": "none",
    "headers": {
      "content-type": "application/json",
      "accept": "application/json, text/event-stream"
    },
    "body": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "tools/call",
      "params": {
        "name": "envoi_agent_info",
        "arguments": {}
      }
    }
  },
  "response": {
    "status": 401,
    "schema": "errorEnvelope",
    "body": {
      "code": "AUTHENTICATION_REQUIRED",
      "error": "AUTHENTICATION_REQUIRED",
      "message": "Authentication is required.",
      "requestId": "req_example"
    },
    "headers": {
      "www-authenticate": "Bearer resource_metadata=\"https://www.envoi-agents.com/.well-known/oauth-protected-resource/mcp\", scope=\"envoi.agent envoi.send\""
    }
  },
  "client": {
    "surface": "host",
    "lifecycle": "UNCHANGED",
    "retry": "refresh_then_retry_once",
    "guidance": "none",
    "next": "No token to refresh: start discovery from resource_metadata and authorize with the challenged scopes."
  }
}
