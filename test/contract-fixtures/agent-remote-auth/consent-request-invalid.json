{
  "contract": "agent-remote-auth",
  "version": 1,
  "id": "consent-request-invalid",
  "description": "An expired, tampered or unknown handle: identical in every case.",
  "kind": "http",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": true,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_REMOTE_MCP_OAUTH": true,
    "ENVOI_PROVIDER_CONNECTORS": false
  },
  "request": {
    "method": "GET",
    "path": "/api/oauth/authorization-requests/PLACEHOLDER_expired_handle",
    "auth": "human_session",
    "headers": {
      "cookie": "envoi_session=PLACEHOLDER_session"
    }
  },
  "response": {
    "status": 404,
    "schema": "errorEnvelope",
    "body": {
      "code": "AUTHORIZATION_REQUEST_INVALID",
      "error": "AUTHORIZATION_REQUEST_INVALID",
      "message": "This connection request is no longer valid. Start again from your assistant.",
      "requestId": "req_example"
    }
  },
  "client": {
    "surface": "owner_ui",
    "lifecycle": "NOT_APPLICABLE",
    "retry": "none",
    "guidance": "start_again",
    "next": "Ask the user to start the connection again in their assistant."
  }
}
