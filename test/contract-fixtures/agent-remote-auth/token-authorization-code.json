{
  "contract": "agent-remote-auth",
  "version": 1,
  "id": "token-authorization-code",
  "description": "The code exchange is the activation: the agent, its installation (remote_mcp_oauth, on_demand) and an audience-bound family are created.",
  "kind": "http",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": true,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_REMOTE_MCP_OAUTH": true,
    "ENVOI_PROVIDER_CONNECTORS": false
  },
  "context": {
    "codeChallenge": "M3FIpMlzNJLst5kEE-j8UdR1OBkXmRHcAX4RQoA2lHM",
    "effectivePermissions": [
      "send_agent_messages",
      "receive_agent_messages"
    ],
    "installation": {
      "connectionRoute": "remote_mcp_oauth",
      "deliveryMode": "on_demand",
      "runtime": {
        "type": "remote_mcp",
        "version": null
      }
    }
  },
  "request": {
    "method": "POST",
    "path": "/oauth/token",
    "auth": "public_client",
    "headers": {
      "content-type": "application/x-www-form-urlencoded"
    },
    "form": {
      "grant_type": "authorization_code",
      "code": "envoi_oauth_code_PLACEHOLDER_1",
      "redirect_uri": "https://assistant.example.com/oauth/callback",
      "code_verifier": "iOY_y2JNRsKjN4t_WyVeJiT-YAQVoL6MnFjPW6Ks1hU",
      "resource": "https://www.envoi-agents.com/mcp",
      "client_id": "https://assistant.example.com/oauth/envoi-client.json"
    }
  },
  "response": {
    "status": 200,
    "schema": "tokenResponse",
    "headers": {
      "cache-control": "no-store",
      "pragma": "no-cache"
    },
    "body": {
      "access_token": "envoi_agent_access_PLACEHOLDER_oauth_1",
      "token_type": "Bearer",
      "expires_in": 900,
      "refresh_token": "envoi_agent_refresh_PLACEHOLDER_oauth_1",
      "scope": "envoi.agent envoi.send"
    }
  },
  "client": {
    "surface": "host",
    "lifecycle": "CONNECTED",
    "next": "Store both tokens in the host's secure store, never in model context. Read scope: it may be narrower than requested."
  }
}
