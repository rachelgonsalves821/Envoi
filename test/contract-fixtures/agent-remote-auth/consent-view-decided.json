{
  "contract": "agent-remote-auth",
  "version": 1,
  "id": "consent-view-decided",
  "description": "This human already approved the handle and the code was exchanged: the view carries the decision, so the page shows it instead of the form.",
  "kind": "http",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": true,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_REMOTE_MCP_OAUTH": true,
    "ENVOI_PROVIDER_CONNECTORS": false
  },
  "request": {
    "method": "GET",
    "path": "/api/oauth/authorization-requests/PLACEHOLDER_authorization_request_handle_1",
    "auth": "human_session",
    "headers": {
      "cookie": "envoi_session=PLACEHOLDER_session"
    }
  },
  "response": {
    "status": 200,
    "schema": "consentView",
    "headers": {
      "cache-control": "no-store"
    },
    "body": {
      "client": {
        "name": "Example Assistant",
        "clientIdHost": "assistant.example.com",
        "redirectHost": "assistant.example.com",
        "loopbackRedirect": false,
        "registration": "metadata_document"
      },
      "connectionRoute": "remote_mcp_oauth",
      "requestedPermissions": [
        "receive_agent_messages",
        "send_agent_messages"
      ],
      "grantablePermissions": [
        "receive_agent_messages",
        "send_agent_messages"
      ],
      "expiresAt": "2026-10-21T12:10:00.000Z",
      "decision": {
        "status": "completed",
        "registrationId": "registration_oauth_example",
        "target": "new_agent",
        "workspaceName": "Example workspace",
        "agent": {
          "name": "Example agent",
          "address": "example@envoi.mail"
        },
        "effectivePermissions": [
          "send_agent_messages",
          "receive_agent_messages"
        ],
        "policyProfile": "default",
        "codeExpiresAt": "2026-10-21T12:02:00.000Z"
      }
    }
  },
  "client": {
    "surface": "owner_ui",
    "next": "Show \"Connected. You can close this page.\" Offer no approve or deny."
  }
}
