{
  "contract": "agent-remote-auth",
  "version": 1,
  "id": "revoke-other-client",
  "description": "A token issued to another client, or a local-helper token: unauthorized_client, nothing changes.",
  "kind": "http",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": true,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_REMOTE_MCP_OAUTH": true,
    "ENVOI_PROVIDER_CONNECTORS": false
  },
  "request": {
    "method": "POST",
    "path": "/oauth/revoke",
    "auth": "public_client",
    "headers": {
      "content-type": "application/x-www-form-urlencoded"
    },
    "form": {
      "token": "envoi_agent_access_PLACEHOLDER_local_helper",
      "token_type_hint": "refresh_token",
      "client_id": "https://assistant.example.com/oauth/envoi-client.json"
    }
  },
  "response": {
    "status": 400,
    "schema": "oauthError",
    "headers": {
      "cache-control": "no-store",
      "pragma": "no-cache"
    },
    "body": {
      "error": "unauthorized_client",
      "error_description": "This client may not use this grant or token."
    }
  },
  "client": {
    "surface": "host",
    "next": "A client can revoke only its own tokens."
  }
}
