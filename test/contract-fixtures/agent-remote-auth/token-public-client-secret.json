{
  "contract": "agent-remote-auth",
  "version": 1,
  "id": "token-public-client-secret",
  "description": "A metadata-document client sends HTTP Basic: public clients send no secret.",
  "kind": "http",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": true,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_REMOTE_MCP_OAUTH": true,
    "ENVOI_PROVIDER_CONNECTORS": false
  },
  "request": {
    "method": "POST",
    "path": "/oauth/token",
    "auth": "client_basic",
    "headers": {
      "content-type": "application/x-www-form-urlencoded",
      "authorization": "Basic PLACEHOLDER_client_secret_basic"
    },
    "form": {
      "grant_type": "authorization_code",
      "code": "envoi_oauth_code_PLACEHOLDER_1",
      "redirect_uri": "https://assistant.example.com/oauth/callback",
      "code_verifier": "iOY_y2JNRsKjN4t_WyVeJiT-YAQVoL6MnFjPW6Ks1hU",
      "resource": "https://www.envoi-agents.com/mcp",
      "client_id": "https://assistant.example.com/oauth/envoi-client.json"
    }
  },
  "response": {
    "status": 401,
    "schema": "oauthError",
    "headers": {
      "cache-control": "no-store",
      "pragma": "no-cache",
      "www-authenticate": "Basic realm=\"Envoi\""
    },
    "body": {
      "error": "invalid_client",
      "error_description": "Client authentication failed."
    }
  },
  "client": {
    "surface": "host",
    "next": "A metadata-document client is public; send client_id in the body only."
  }
}
