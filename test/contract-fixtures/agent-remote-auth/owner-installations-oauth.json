{
  "contract": "agent-remote-auth",
  "version": 1,
  "id": "owner-installations-oauth",
  "description": "The owner view of an agent connected through remote MCP: the shape is agent-registration v1's, with the new route and on_demand.",
  "kind": "http",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": true,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_REMOTE_MCP_OAUTH": true,
    "ENVOI_PROVIDER_CONNECTORS": false
  },
  "request": {
    "method": "GET",
    "path": "/api/inboxes/inbox_example/agents/agent_example/installations",
    "auth": "human_session",
    "headers": {
      "cookie": "envoi_session=PLACEHOLDER_session"
    }
  },
  "response": {
    "status": 200,
    "schema": "agent-registration/ownerInstallationList",
    "headers": {
      "cache-control": "no-store"
    },
    "body": {
      "agentId": "agent_example",
      "installations": [
        {
          "id": "installation_oauth_example",
          "agentId": "agent_example",
          "connectionRoute": "remote_mcp_oauth",
          "deliveryMode": "on_demand",
          "runtime": {
            "type": "remote_mcp",
            "version": null
          },
          "status": "active",
          "endedReason": null,
          "legacy": false,
          "createdAt": "2026-10-21T12:01:10.000Z",
          "activatedAt": "2026-10-21T12:01:10.000Z",
          "endedAt": null
        }
      ]
    }
  },
  "client": {
    "surface": "owner_ui",
    "next": "Show \"Remote MCP\" and the a5-presence label for on_demand. The client name is not part of the installation in v1."
  }
}
