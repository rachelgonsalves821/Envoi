{
  "contract": "agent-remote-auth",
  "version": 1,
  "id": "bootstrap-code-public-client",
  "description": "A public client cannot use the bootstrap grant.",
  "kind": "http",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": true,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_REMOTE_MCP_OAUTH": true,
    "ENVOI_PROVIDER_CONNECTORS": true
  },
  "request": {
    "method": "POST",
    "path": "/oauth/token",
    "auth": "public_client",
    "headers": {
      "content-type": "application/x-www-form-urlencoded"
    },
    "form": {
      "grant_type": "urn:envoi:params:oauth:grant-type:bootstrap_code",
      "bootstrap_code": "envoi_boot_PLACEHOLDER_1",
      "resource": "https://www.envoi-agents.com/mcp",
      "client_id": "https://assistant.example.com/oauth/envoi-client.json"
    }
  },
  "response": {
    "status": 400,
    "schema": "oauthError",
    "headers": {
      "cache-control": "no-store",
      "pragma": "no-cache"
    },
    "body": {
      "error": "unauthorized_client",
      "error_description": "This client may not use this grant or token."
    }
  },
  "client": {
    "surface": "host",
    "next": "Only a pre-registered confidential provider client may exchange bootstrap codes."
  }
}
