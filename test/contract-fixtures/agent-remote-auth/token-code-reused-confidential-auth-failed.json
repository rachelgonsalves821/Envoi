{
  "contract": "agent-remote-auth",
  "version": 1,
  "id": "token-code-reused-confidential-auth-failed",
  "description": "A confidential client's used code presented with a wrong client secret: check 3 fails first, so nothing is revoked.",
  "kind": "sequence",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": true,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_REMOTE_MCP_OAUTH": false,
    "ENVOI_PROVIDER_CONNECTORS": true
  },
  "steps": [
    {
      "note": "First exchange, with the client secret.",
      "request": {
        "method": "POST",
        "path": "/oauth/token",
        "auth": "client_basic",
        "headers": {
          "content-type": "application/x-www-form-urlencoded",
          "authorization": "Basic PLACEHOLDER_client_secret_basic"
        },
        "form": {
          "grant_type": "authorization_code",
          "code": "envoi_oauth_code_PLACEHOLDER_2",
          "redirect_uri": "https://connectors.provider.example/oauth/envoi/callback",
          "code_verifier": "iOY_y2JNRsKjN4t_WyVeJiT-YAQVoL6MnFjPW6Ks1hU",
          "resource": "https://www.envoi-agents.com/mcp"
        }
      },
      "response": {
        "status": 200,
        "schema": "tokenResponse",
        "headers": {
          "cache-control": "no-store",
          "pragma": "no-cache"
        },
        "body": {
          "access_token": "envoi_agent_access_PLACEHOLDER_oauth_1",
          "token_type": "Bearer",
          "expires_in": 900,
          "refresh_token": "envoi_agent_refresh_PLACEHOLDER_oauth_1",
          "scope": "envoi.agent envoi.send"
        }
      }
    },
    {
      "note": "The same code with a wrong secret.",
      "request": {
        "method": "POST",
        "path": "/oauth/token",
        "auth": "client_basic",
        "headers": {
          "content-type": "application/x-www-form-urlencoded",
          "authorization": "Basic PLACEHOLDER_wrong_client_secret"
        },
        "form": {
          "grant_type": "authorization_code",
          "code": "envoi_oauth_code_PLACEHOLDER_2",
          "redirect_uri": "https://connectors.provider.example/oauth/envoi/callback",
          "code_verifier": "iOY_y2JNRsKjN4t_WyVeJiT-YAQVoL6MnFjPW6Ks1hU",
          "resource": "https://www.envoi-agents.com/mcp"
        }
      },
      "response": {
        "status": 401,
        "schema": "oauthError",
        "headers": {
          "cache-control": "no-store",
          "pragma": "no-cache",
          "www-authenticate": "Basic realm=\"Envoi\""
        },
        "body": {
          "error": "invalid_client",
          "error_description": "Client authentication failed."
        }
      }
    },
    {
      "note": "The first exchange's token still works.",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "auth": "bearer",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json, text/event-stream",
          "authorization": "Bearer envoi_agent_access_PLACEHOLDER_oauth_1"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "envoi_agent_info",
            "arguments": {}
          }
        }
      },
      "response": {
        "status": 200,
        "schema": "mcpResult",
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "result": {
            "content": [
              {
                "type": "text",
                "text": "identity"
              }
            ]
          }
        }
      }
    }
  ]
}
