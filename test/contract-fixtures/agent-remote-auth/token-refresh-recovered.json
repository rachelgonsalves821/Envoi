{
  "contract": "agent-remote-auth",
  "version": 1,
  "id": "token-refresh-recovered",
  "description": "The refresh response was lost; the same client presents the old token again within 60 s before using either successor, and gets the identical response.",
  "kind": "sequence",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": true,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_REMOTE_MCP_OAUTH": true,
    "ENVOI_PROVIDER_CONNECTORS": false
  },
  "steps": [
    {
      "note": "The response is lost.",
      "delivered": false,
      "request": {
        "method": "POST",
        "path": "/oauth/token",
        "auth": "public_client",
        "headers": {
          "content-type": "application/x-www-form-urlencoded"
        },
        "form": {
          "grant_type": "refresh_token",
          "refresh_token": "envoi_agent_refresh_PLACEHOLDER_oauth_1",
          "client_id": "https://assistant.example.com/oauth/envoi-client.json"
        }
      },
      "response": {
        "status": 200,
        "schema": "tokenResponse",
        "headers": {
          "cache-control": "no-store",
          "pragma": "no-cache"
        },
        "body": {
          "access_token": "envoi_agent_access_PLACEHOLDER_oauth_2",
          "token_type": "Bearer",
          "expires_in": 900,
          "refresh_token": "envoi_agent_refresh_PLACEHOLDER_oauth_2",
          "scope": "envoi.agent envoi.send"
        }
      }
    },
    {
      "note": "20 s later, the identical request.",
      "request": {
        "method": "POST",
        "path": "/oauth/token",
        "auth": "public_client",
        "headers": {
          "content-type": "application/x-www-form-urlencoded"
        },
        "form": {
          "grant_type": "refresh_token",
          "refresh_token": "envoi_agent_refresh_PLACEHOLDER_oauth_1",
          "client_id": "https://assistant.example.com/oauth/envoi-client.json"
        }
      },
      "response": {
        "status": 200,
        "schema": "tokenResponse",
        "headers": {
          "cache-control": "no-store",
          "pragma": "no-cache"
        },
        "body": {
          "access_token": "envoi_agent_access_PLACEHOLDER_oauth_2",
          "token_type": "Bearer",
          "expires_in": 900,
          "refresh_token": "envoi_agent_refresh_PLACEHOLDER_oauth_2",
          "scope": "envoi.agent envoi.send"
        }
      }
    }
  ]
}
