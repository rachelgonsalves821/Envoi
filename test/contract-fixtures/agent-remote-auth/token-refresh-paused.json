{
  "contract": "agent-remote-auth",
  "version": 1,
  "id": "token-refresh-paused",
  "description": "Refresh succeeds while the agent is paused (a3 §14); /mcp still answers 409.",
  "kind": "sequence",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": true,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_REMOTE_MCP_OAUTH": true,
    "ENVOI_PROVIDER_CONNECTORS": false
  },
  "context": {
    "agentStatus": "paused"
  },
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/oauth/token",
        "auth": "public_client",
        "headers": {
          "content-type": "application/x-www-form-urlencoded"
        },
        "form": {
          "grant_type": "refresh_token",
          "refresh_token": "envoi_agent_refresh_PLACEHOLDER_oauth_1",
          "client_id": "https://assistant.example.com/oauth/envoi-client.json"
        }
      },
      "response": {
        "status": 200,
        "schema": "tokenResponse",
        "headers": {
          "cache-control": "no-store",
          "pragma": "no-cache"
        },
        "body": {
          "access_token": "envoi_agent_access_PLACEHOLDER_oauth_2",
          "token_type": "Bearer",
          "expires_in": 900,
          "refresh_token": "envoi_agent_refresh_PLACEHOLDER_oauth_2",
          "scope": "envoi.agent envoi.send"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/mcp",
        "auth": "bearer",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json, text/event-stream",
          "authorization": "Bearer envoi_agent_access_PLACEHOLDER_oauth_2"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "envoi_agent_info",
            "arguments": {}
          }
        }
      },
      "response": {
        "status": 409,
        "schema": "errorEnvelope",
        "body": {
          "code": "AGENT_PAUSED",
          "error": "AGENT_PAUSED",
          "message": "This agent is paused by its owner.",
          "requestId": "req_example"
        }
      },
      "client": {
        "surface": "host",
        "lifecycle": "PAUSED",
        "retry": "after_resume",
        "guidance": "wait_for_resume",
        "next": "Wait for the owner to resume."
      }
    }
  ]
}
