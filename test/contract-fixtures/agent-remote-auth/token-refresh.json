{
  "contract": "agent-remote-auth",
  "version": 1,
  "id": "token-refresh",
  "description": "Refresh rotates both tokens; the scope is unchanged.",
  "kind": "http",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": true,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_REMOTE_MCP_OAUTH": true,
    "ENVOI_PROVIDER_CONNECTORS": false
  },
  "request": {
    "method": "POST",
    "path": "/oauth/token",
    "auth": "public_client",
    "headers": {
      "content-type": "application/x-www-form-urlencoded"
    },
    "form": {
      "grant_type": "refresh_token",
      "refresh_token": "envoi_agent_refresh_PLACEHOLDER_oauth_1",
      "client_id": "https://assistant.example.com/oauth/envoi-client.json"
    }
  },
  "response": {
    "status": 200,
    "schema": "tokenResponse",
    "headers": {
      "cache-control": "no-store",
      "pragma": "no-cache"
    },
    "body": {
      "access_token": "envoi_agent_access_PLACEHOLDER_oauth_2",
      "token_type": "Bearer",
      "expires_in": 900,
      "refresh_token": "envoi_agent_refresh_PLACEHOLDER_oauth_2",
      "scope": "envoi.agent envoi.send"
    }
  },
  "client": {
    "surface": "host",
    "next": "Replace both stored tokens atomically."
  }
}
