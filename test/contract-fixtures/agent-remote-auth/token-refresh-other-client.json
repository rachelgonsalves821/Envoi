{
  "contract": "agent-remote-auth",
  "version": 1,
  "id": "token-refresh-other-client",
  "description": "A refresh token presented by a different client is unknown here.",
  "kind": "http",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": true,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_REMOTE_MCP_OAUTH": true,
    "ENVOI_PROVIDER_CONNECTORS": false
  },
  "request": {
    "method": "POST",
    "path": "/oauth/token",
    "auth": "public_client",
    "headers": {
      "content-type": "application/x-www-form-urlencoded"
    },
    "form": {
      "grant_type": "refresh_token",
      "refresh_token": "envoi_agent_refresh_PLACEHOLDER_oauth_1",
      "client_id": "https://desktop.example.org/envoi/client.json"
    }
  },
  "response": {
    "status": 400,
    "schema": "oauthError",
    "headers": {
      "cache-control": "no-store",
      "pragma": "no-cache"
    },
    "body": {
      "error": "invalid_grant",
      "error_description": "The authorization grant is invalid, expired, already used or revoked."
    }
  },
  "client": {
    "surface": "host",
    "next": "Refresh tokens are bound to the client they were issued to."
  }
}
