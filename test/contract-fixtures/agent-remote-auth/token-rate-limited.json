{
  "contract": "agent-remote-auth",
  "version": 1,
  "id": "token-rate-limited",
  "description": "Too many token requests from one source.",
  "kind": "http",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": true,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_REMOTE_MCP_OAUTH": true,
    "ENVOI_PROVIDER_CONNECTORS": false
  },
  "request": {
    "method": "POST",
    "path": "/oauth/token",
    "auth": "public_client",
    "headers": {
      "content-type": "application/x-www-form-urlencoded"
    },
    "form": {
      "grant_type": "authorization_code",
      "code": "envoi_oauth_code_PLACEHOLDER_1",
      "redirect_uri": "https://assistant.example.com/oauth/callback",
      "code_verifier": "iOY_y2JNRsKjN4t_WyVeJiT-YAQVoL6MnFjPW6Ks1hU",
      "resource": "https://www.envoi-agents.com/mcp",
      "client_id": "https://assistant.example.com/oauth/envoi-client.json"
    }
  },
  "response": {
    "status": 429,
    "schema": "oauthError",
    "headers": {
      "cache-control": "no-store",
      "pragma": "no-cache",
      "retry-after": "30"
    },
    "body": {
      "error": "temporarily_unavailable",
      "error_description": "Too many requests. Retry after the indicated delay."
    }
  },
  "client": {
    "surface": "host",
    "next": "Wait retry-after seconds. An authorization code may expire meanwhile."
  }
}
