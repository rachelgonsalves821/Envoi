{
  "contract": "agent-remote-auth",
  "version": 1,
  "id": "rollback-flags-off",
  "description": "Turning the flag off makes issued tokens unusable without revoking them; turning it on again restores them.",
  "kind": "rollback",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": true,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_REMOTE_MCP_OAUTH": false,
    "ENVOI_PROVIDER_CONNECTORS": false
  },
  "steps": [
    {
      "note": "Flag on: the token works.",
      "flags": {
        "ENVOI_AGENT_REGISTRATION_V2": true,
        "ENVOI_INSTALLATIONS_V2": true,
        "ENVOI_REMOTE_MCP_OAUTH": true,
        "ENVOI_PROVIDER_CONNECTORS": false
      },
      "request": {
        "method": "POST",
        "path": "/mcp",
        "auth": "bearer",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json, text/event-stream",
          "authorization": "Bearer envoi_agent_access_PLACEHOLDER_oauth_1"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "envoi_agent_info",
            "arguments": {}
          }
        }
      },
      "response": {
        "status": 200,
        "schema": "mcpResult",
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "result": {
            "content": [
              {
                "type": "text",
                "text": "identity"
              }
            ]
          }
        }
      }
    },
    {
      "note": "Flag off: the same token is unrecognized and the challenge has no resource_metadata.",
      "flags": {
        "ENVOI_AGENT_REGISTRATION_V2": true,
        "ENVOI_INSTALLATIONS_V2": true,
        "ENVOI_REMOTE_MCP_OAUTH": false,
        "ENVOI_PROVIDER_CONNECTORS": false
      },
      "request": {
        "method": "POST",
        "path": "/mcp",
        "auth": "bearer",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json, text/event-stream",
          "authorization": "Bearer envoi_agent_access_PLACEHOLDER_oauth_1"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "envoi_agent_info",
            "arguments": {}
          }
        }
      },
      "response": {
        "status": 401,
        "schema": "errorEnvelope",
        "body": {
          "code": "AUTHENTICATION_REQUIRED",
          "error": "AUTHENTICATION_REQUIRED",
          "message": "Authentication is required.",
          "requestId": "req_example"
        },
        "headers": {
          "www-authenticate": "Bearer realm=\"Envoi agent MCP\""
        }
      },
      "client": {
        "surface": "host",
        "lifecycle": "UNCHANGED",
        "retry": "refresh_then_retry_once",
        "guidance": "none",
        "next": "Refresh fails too (404 FEATURE_DISABLED); the host reports the connection unavailable."
      }
    },
    {
      "note": "Flag on again: nothing was revoked.",
      "flags": {
        "ENVOI_AGENT_REGISTRATION_V2": true,
        "ENVOI_INSTALLATIONS_V2": true,
        "ENVOI_REMOTE_MCP_OAUTH": true,
        "ENVOI_PROVIDER_CONNECTORS": false
      },
      "request": {
        "method": "POST",
        "path": "/mcp",
        "auth": "bearer",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json, text/event-stream",
          "authorization": "Bearer envoi_agent_access_PLACEHOLDER_oauth_1"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "envoi_agent_info",
            "arguments": {}
          }
        }
      },
      "response": {
        "status": 200,
        "schema": "mcpResult",
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "result": {
            "content": [
              {
                "type": "text",
                "text": "identity"
              }
            ]
          }
        }
      }
    }
  ]
}
