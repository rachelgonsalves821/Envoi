{
  "contract": "agent-remote-auth",
  "version": 1,
  "id": "consent-approve-lost-response",
  "description": "The first approve response is lost, the server restarts, and the owner retries: the outcome comes from the stored registration, the code is never repeated, and the approval lapses unused.",
  "kind": "sequence",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": true,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_REMOTE_MCP_OAUTH": true,
    "ENVOI_PROVIDER_CONNECTORS": false
  },
  "steps": [
    {
      "note": "The response never reaches the page, so the host never receives the code.",
      "delivered": false,
      "request": {
        "method": "POST",
        "path": "/api/oauth/authorization-requests/PLACEHOLDER_authorization_request_handle_1/approve",
        "auth": "human_session",
        "headers": {
          "cookie": "envoi_session=PLACEHOLDER_session; envoi_csrf=PLACEHOLDER_csrf",
          "x-envoi-csrf": "PLACEHOLDER_csrf",
          "origin": "https://www.envoi-agents.com"
        },
        "schema": "consentApproveRequest",
        "body": {
          "target": {
            "kind": "new_agent",
            "workspaceInboxId": "inbox_workspace_example",
            "name": "Example agent",
            "localPart": "example"
          },
          "grantedPermissions": [
            "send_agent_messages",
            "receive_agent_messages"
          ],
          "policyProfile": "default"
        }
      },
      "response": {
        "status": 200,
        "schema": "consentApproved",
        "headers": {
          "cache-control": "no-store"
        },
        "body": {
          "redirectTo": "https://assistant.example.com/oauth/callback?code=envoi_oauth_code_PLACEHOLDER_1&state=af0ifjsldkj-example-state&iss=https%3A%2F%2Fwww.envoi-agents.com",
          "registrationId": "registration_oauth_example",
          "target": "new_agent",
          "workspaceName": "Example workspace",
          "agent": {
            "name": "Example agent",
            "address": "example@envoi.mail"
          },
          "effectivePermissions": [
            "send_agent_messages",
            "receive_agent_messages"
          ],
          "policyProfile": "default",
          "codeExpiresAt": "2026-10-21T12:02:00.000Z"
        }
      }
    },
    {
      "note": "After a server restart, the identical approve.",
      "request": {
        "method": "POST",
        "path": "/api/oauth/authorization-requests/PLACEHOLDER_authorization_request_handle_1/approve",
        "auth": "human_session",
        "headers": {
          "cookie": "envoi_session=PLACEHOLDER_session; envoi_csrf=PLACEHOLDER_csrf",
          "x-envoi-csrf": "PLACEHOLDER_csrf",
          "origin": "https://www.envoi-agents.com"
        },
        "schema": "consentApproveRequest",
        "body": {
          "target": {
            "kind": "new_agent",
            "workspaceInboxId": "inbox_workspace_example",
            "name": "Example agent",
            "localPart": "example"
          },
          "grantedPermissions": [
            "send_agent_messages",
            "receive_agent_messages"
          ],
          "policyProfile": "default"
        }
      },
      "response": {
        "status": 200,
        "schema": "consentDecided",
        "headers": {
          "cache-control": "no-store"
        },
        "body": {
          "status": "pending_exchange",
          "registrationId": "registration_oauth_example",
          "target": "new_agent",
          "workspaceName": "Example workspace",
          "agent": {
            "name": "Example agent",
            "address": "example@envoi.mail"
          },
          "effectivePermissions": [
            "send_agent_messages",
            "receive_agent_messages"
          ],
          "policyProfile": "default",
          "codeExpiresAt": "2026-10-21T12:02:00.000Z"
        }
      },
      "client": {
        "surface": "owner_ui",
        "next": "Do not navigate. Tell the owner to start again from the assistant if it does not connect."
      }
    },
    {
      "note": "A reload reads the handle and shows the outcome instead of the form.",
      "request": {
        "method": "GET",
        "path": "/api/oauth/authorization-requests/PLACEHOLDER_authorization_request_handle_1",
        "auth": "human_session",
        "headers": {
          "cookie": "envoi_session=PLACEHOLDER_session"
        }
      },
      "response": {
        "status": 200,
        "schema": "consentView",
        "headers": {
          "cache-control": "no-store"
        },
        "body": {
          "client": {
            "name": "Example Assistant",
            "clientIdHost": "assistant.example.com",
            "redirectHost": "assistant.example.com",
            "loopbackRedirect": false,
            "registration": "metadata_document"
          },
          "connectionRoute": "remote_mcp_oauth",
          "requestedPermissions": [
            "receive_agent_messages",
            "send_agent_messages"
          ],
          "grantablePermissions": [
            "receive_agent_messages",
            "send_agent_messages"
          ],
          "expiresAt": "2026-10-21T12:10:00.000Z",
          "decision": {
            "status": "pending_exchange",
            "registrationId": "registration_oauth_example",
            "target": "new_agent",
            "workspaceName": "Example workspace",
            "agent": {
              "name": "Example agent",
              "address": "example@envoi.mail"
            },
            "effectivePermissions": [
              "send_agent_messages",
              "receive_agent_messages"
            ],
            "policyProfile": "default",
            "codeExpiresAt": "2026-10-21T12:02:00.000Z"
          }
        }
      },
      "client": {
        "surface": "owner_ui",
        "next": "Render the decision, not the form."
      }
    },
    {
      "note": "After codeExpiresAt, the identical approve again.",
      "request": {
        "method": "POST",
        "path": "/api/oauth/authorization-requests/PLACEHOLDER_authorization_request_handle_1/approve",
        "auth": "human_session",
        "headers": {
          "cookie": "envoi_session=PLACEHOLDER_session; envoi_csrf=PLACEHOLDER_csrf",
          "x-envoi-csrf": "PLACEHOLDER_csrf",
          "origin": "https://www.envoi-agents.com"
        },
        "schema": "consentApproveRequest",
        "body": {
          "target": {
            "kind": "new_agent",
            "workspaceInboxId": "inbox_workspace_example",
            "name": "Example agent",
            "localPart": "example"
          },
          "grantedPermissions": [
            "send_agent_messages",
            "receive_agent_messages"
          ],
          "policyProfile": "default"
        }
      },
      "response": {
        "status": 200,
        "schema": "consentDecided",
        "headers": {
          "cache-control": "no-store"
        },
        "body": {
          "status": "expired",
          "registrationId": "registration_oauth_example",
          "target": "new_agent",
          "workspaceName": "Example workspace",
          "agent": {
            "name": "Example agent",
            "address": "example@envoi.mail"
          },
          "effectivePermissions": [
            "send_agent_messages",
            "receive_agent_messages"
          ],
          "policyProfile": "default",
          "codeExpiresAt": "2026-10-21T12:02:00.000Z"
        }
      },
      "client": {
        "surface": "owner_ui",
        "next": "Start again from the assistant: a new authorization request and a new handle."
      }
    }
  ]
}
