{
  "contract": "agent-saved-setup",
  "version": 1,
  "id": "setup-status-approved",
  "description": "The owner approved on Envoi's page with this setup; the Dot has not finished connecting.",
  "kind": "http",
  "flags": {
    "ENVOI_SAVED_SETUP": true,
    "ENVOI_REMOTE_MCP_OAUTH": true
  },
  "request": {
    "method": "GET",
    "path": "/api/inboxes/inbox_workspace_example/agent-setups/setup_example_1",
    "auth": "human_session",
    "headers": {
      "cookie": "envoi_session=PLACEHOLDER_session"
    }
  },
  "response": {
    "status": 200,
    "schema": "savedSetup",
    "headers": {
      "cache-control": "no-store"
    },
    "body": {
      "setupId": "setup_example_1",
      "runtime": "dots",
      "workspaceInboxId": "inbox_workspace_example",
      "workspaceName": "Example workspace",
      "name": "Milo",
      "localPart": "milo",
      "address": "milo@envoi-agents.com",
      "permissions": [
        "receive_agent_messages",
        "send_agent_messages"
      ],
      "status": "approved",
      "createdAt": "2026-11-12T15:00:00.000Z",
      "expiresAt": "2026-11-12T15:30:00.000Z",
      "agent": {
        "name": "Milo",
        "address": "milo@envoi-agents.com"
      }
    }
  },
  "client": {
    "surface": "owner_ui",
    "next": "Status row: Approved. Your Dot is finishing the connection."
  }
}
