{
  "contract": "a4-wake",
  "version": 1,
  "id": "stream-credential-ended",
  "description": "The credential family was replaced by a reconnect: credential.ended (no id), then the stream closes.",
  "kind": "sse-session",
  "request": {
    "method": "GET",
    "path": "/api/inboxes/inbox_example/events",
    "headers": {
      "authorization": "Bearer sinaloa_agent_access_PLACEHOLDER_active",
      "accept": "text/event-stream",
      "last-event-id": "00000000000000000044"
    }
  },
  "frames": [
    {
      "event": "ready",
      "data": {
        "inboxId": "inbox_example",
        "at": "2026-10-09T12:00:00.000Z",
        "cursor": "00000000000000000044"
      },
      "schema": "readyFrame"
    },
    {
      "event": "credential.ended",
      "data": {
        "code": "CREDENTIAL_REVOKED",
        "reason": "replaced"
      },
      "schema": "credentialEndedFrame"
    }
  ],
  "client": {
    "lifecycle": "REVOKED",
    "retry": "none",
    "guidance": "none",
    "claim": false,
    "next": "Apply the a3 lifecycle for data.code; do not reconnect with this credential."
  }
}
