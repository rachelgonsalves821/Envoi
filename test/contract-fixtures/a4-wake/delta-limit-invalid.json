  "kind": "http",
  "request": {
    "method": "GET",
    "path": "/api/inboxes/inbox_example/events/delta?cursor=00000000000000000104&limit=500",
    "headers": {
      "authorization": "Bearer sinaloa_agent_access_PLACEHOLDER_active"
    }
  },
  "response": {
    "status": 400,
    "schema": "errorEnvelope",
    "body": {
      "code": "EVENT_LIMIT_INVALID",
      "error": "EVENT_LIMIT_INVALID",
