{
  "contract": "agent-registration",
  "version": 1,
  "id": "claim-auth-unavailable",
  "kind": "http",
  "description": "The identity provider is unavailable during lookup.",
  "request": {
    "method": "POST",
    "path": "/api/agent-claims/lookup",
    "auth": "human_session",
    "headers": {
      "cookie": "envoi_session=PLACEHOLDER_session; envoi_csrf=PLACEHOLDER_csrf",
      "x-envoi-csrf": "PLACEHOLDER_csrf",
      "origin": "https://www.envoi-agents.com"
    },
    "schema": "claimLookupRequest",
    "body": {
      "verificationCode": "F7KQ-PM4D"
    }
  },
  "response": {
    "status": 503,
    "schema": "errorEnvelope",
    "body": {
      "code": "AUTH_UNAVAILABLE",
      "error": "AUTH_UNAVAILABLE",
      "message": "Sign-in is temporarily unavailable.",
      "requestId": "req_example"
    }
  },
  "client": {
    "surface": "owner_ui",
    "lifecycle": "NOT_APPLICABLE",
    "retry": "backoff",
    "guidance": "service_unavailable",
    "next": "Retry with backoff. A 5xx never counts as a claim failure."
  }
}
