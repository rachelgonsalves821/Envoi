{
  "contract": "agent-registration",
  "version": 1,
  "id": "claim-reject-after-approve",
  "kind": "http",
  "description": "The human who approved this registration sends reject for it. A decision is never silently reversed; the response is not a claim failure.",
  "request": {
    "method": "POST",
    "path": "/api/agent-registrations/registration_example/reject",
    "auth": "human_session",
    "headers": {
      "cookie": "envoi_session=PLACEHOLDER_session; envoi_csrf=PLACEHOLDER_csrf",
      "x-envoi-csrf": "PLACEHOLDER_csrf",
      "origin": "https://www.envoi-agents.com"
    },
    "schema": "claimRejectRequest",
    "body": {
      "verificationCode": "F7KQ-PM4D"
    }
  },
  "response": {
    "status": 409,
    "schema": "errorEnvelope",
    "body": {
      "code": "CLAIM_ALREADY_DECIDED",
      "error": "CLAIM_ALREADY_DECIDED",
      "message": "You already decided this registration.",
      "requestId": "req_example"
    }
  },
  "client": {
    "surface": "owner_ui",
    "lifecycle": "NOT_APPLICABLE",
    "retry": "none",
    "guidance": "withdraw_first",
    "next": "Explain the earlier approval stands; offer Withdraw from the claims list while it is still approved."
  }
}
