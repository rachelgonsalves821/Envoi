{
  "contract": "agent-registration",
  "version": 1,
  "id": "migration-legacy-family",
  "kind": "migration",
  "description": "Turning ENVOI_INSTALLATIONS_V2 on projects each existing credential family as a legacy installation. Nothing is written and nobody re-enrolls.",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": false,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_AUTHENTICATED_REST_ROUTE": false
  },
  "stored": {
    "credentialFamilies": [
      {
        "id": "credential_family_0b6f8f9e-1c2d-4e5f-8a9b-0c1d2e3f4a5b",
        "agentId": "agent_example",
        "inboxId": "inbox_example",
        "createdAt": "2026-09-20T08:00:00.000Z",
        "refreshExpiresAt": "2026-11-11T08:00:00.000Z",
        "revokedAt": null,
        "runtime": "openclaw"
      }
    ]
  },
  "steps": [
    {
      "request": {
        "method": "GET",
        "path": "/api/inboxes/inbox_example/agents/agent_example/installations",
        "auth": "human_session",
        "headers": {
          "cookie": "envoi_session=PLACEHOLDER_session; envoi_csrf=PLACEHOLDER_csrf"
        }
      },
      "response": {
        "status": 200,
        "schema": "ownerInstallationList",
        "headers": {
          "cache-control": "no-store"
        },
        "body": {
          "agentId": "agent_example",
          "installations": [
            {
              "id": "installation_legacy_0b6f8f9e-1c2d-4e5f-8a9b-0c1d2e3f4a5b",
              "agentId": "agent_example",
              "connectionRoute": "local_helper",
              "deliveryMode": "envoi_link",
              "runtime": {
                "type": "openclaw",
                "version": null
              },
              "status": "active",
              "endedReason": null,
              "legacy": true,
              "createdAt": "2026-09-20T08:00:00.000Z",
              "activatedAt": "2026-09-20T08:00:00.000Z",
              "endedAt": null
            }
          ]
        }
      },
      "client": {
        "surface": "owner_ui",
        "next": "Legacy installations look like any other; legacy:true only explains why the version is unknown."
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/agent/status",
        "auth": "agent_access",
        "headers": {
          "authorization": "Bearer envoi_agent_access_PLACEHOLDER_legacy"
        }
      },
      "response": {
        "status": 200,
        "schema": "agentStatusWithInstallation",
        "body": {
          "state": "active",
          "agent": {
            "id": "agent_example",
            "address": "example@envoi.mail",
            "status": "active"
          },
          "inboxId": "inbox_example",
          "asOf": "2026-10-12T12:05:00.000Z",
          "presence": {
            "lastSeenAt": "2026-10-12T12:05:00.000Z",
            "lastSuccessfulRefreshAt": "2026-10-12T11:50:00.000Z",
            "lastWorkClaimAt": "2026-10-12T12:05:00.000Z",
            "lastProcessedAt": "2026-10-12T11:40:00.000Z"
          },
          "installation": {
            "id": "installation_legacy_0b6f8f9e-1c2d-4e5f-8a9b-0c1d2e3f4a5b",
            "connectionRoute": "local_helper",
            "deliveryMode": "envoi_link",
            "legacy": true
          }
        }
      },
      "client": {
        "surface": "connector",
        "lifecycle": "UNCHANGED",
        "next": "An existing connector keeps working unchanged; it may ignore the installation field."
      }
    }
  ],
  "client": {
    "surface": "server",
    "next": "Projection only: installation id is installation_legacy_ + the family UUID; route local_helper; delivery envoi_link; runtime from the family; presence keyed by the family as in a5-presence §1."
  }
}
