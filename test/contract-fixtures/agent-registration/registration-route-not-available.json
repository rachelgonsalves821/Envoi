{
  "contract": "agent-registration",
  "version": 1,
  "id": "registration-route-not-available",
  "kind": "http",
  "description": "A registration names a route that is not available in v1.",
  "request": {
    "method": "POST",
    "path": "/api/agent-registrations",
    "auth": "none",
    "schema": "registrationCreateRequest",
    "body": {
      "requestedName": "Example agent",
      "requestedLocalPart": "example",
      "requestedPermissions": [
        "send_agent_messages",
        "receive_agent_messages"
      ],
      "connectionRoute": "remote_mcp_oauth",
      "runtime": {
        "type": "hermes",
        "version": "0.9.0"
      },
      "deliveryCapabilities": {
        "persistentProcess": true,
        "outboundHttps": true,
        "sse": true,
        "webhook": false,
        "scheduledPolling": false,
        "a2a": false
      },
      "helper": {
        "name": "envoi-link",
        "version": "1.0.0"
      }
    }
  },
  "response": {
    "status": 400,
    "schema": "errorEnvelope",
    "body": {
      "code": "ROUTE_NOT_AVAILABLE",
      "error": "ROUTE_NOT_AVAILABLE",
      "message": "That connection route is not available.",
      "requestId": "req_example"
    }
  },
  "client": {
    "surface": "helper",
    "lifecycle": "REGISTRATION_ENDED",
    "retry": "none",
    "guidance": "route_unavailable",
    "next": "Stop. Re-read GET /api/onboarding/routes and name the missing route to the human.",
    "modelVisible": {
      "state": "registration_ended",
      "guidance": "route_unavailable"
    }
  }
}
