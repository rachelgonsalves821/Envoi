{
  "contract": "agent-registration",
  "version": 1,
  "id": "bootstrap-pending-no-mcp",
  "kind": "http",
  "description": "A pending registration's bootstrap token on /mcp.",
  "request": {
    "method": "POST",
    "path": "/mcp",
    "auth": "bootstrap",
    "headers": {
      "authorization": "Bearer envoi_reg_PLACEHOLDER_example",
      "content-type": "application/json"
    },
    "body": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "tools/list"
    }
  },
  "response": {
    "status": 401,
    "schema": "errorEnvelope",
    "body": {
      "code": "AUTHENTICATION_REQUIRED",
      "error": "AUTHENTICATION_REQUIRED",
      "message": "Authentication is required.",
      "requestId": "req_example"
    }
  },
  "client": {
    "surface": "helper",
    "lifecycle": "UNCHANGED",
    "retry": "none",
    "guidance": "none",
    "next": "A registration has no inbox, messaging, claim, case, file, MCP or directory access. It is an HTTP 401, not a JSON-RPC result."
  }
}
