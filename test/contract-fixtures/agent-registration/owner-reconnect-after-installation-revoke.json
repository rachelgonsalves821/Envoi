{
  "contract": "agent-registration",
  "version": 1,
  "id": "owner-reconnect-after-installation-revoke",
  "kind": "restart",
  "description": "Revision 4 (§5.3 Owner-UI eligibility). The owner revoked the only installation of agent_example (§6.5), and the server may have restarted since. The owner view reports the agent as revoked (a5-presence v1), but it is not frozen: the owner UI offers it under \"Reconnect an existing agent\", and an existing_agent approval with replacesInstallationId null attaches to it. agent_frozen was frozen by the agent-wide credentials/revoke, so the UI does not offer it.",
  "flags": {
    "ENVOI_AGENT_REGISTRATION_V2": true,
    "ENVOI_INSTALLATIONS_V2": true,
    "ENVOI_AUTHENTICATED_REST_ROUTE": false
  },
  "context": {
    "requestedPermissions": [
      "send_agent_messages",
      "receive_agent_messages"
    ]
  },
  "stored": {
    "agents": [
      {
        "id": "agent_example",
        "onboardingStatus": "approved",
        "status": "active"
      },
      {
        "id": "agent_frozen",
        "onboardingStatus": "revoked",
        "status": "revoked"
      }
    ],
    "credentialFamilies": [
      {
        "id": "credential_family_example",
        "agentId": "agent_example",
        "inboxId": "inbox_example",
        "createdAt": "2026-10-12T09:00:00.000Z",
        "refreshExpiresAt": "2026-11-11T09:00:00.000Z",
        "revokedAt": "2026-10-12T11:00:00.000Z",
        "revokedReason": "revoked",
        "runtime": "hermes",
        "installationId": "installation_example"
      },
      {
        "id": "credential_family_frozen",
        "agentId": "agent_frozen",
        "inboxId": "inbox_frozen",
        "createdAt": "2026-10-10T09:00:00.000Z",
        "refreshExpiresAt": "2026-11-09T09:00:00.000Z",
        "revokedAt": "2026-10-11T16:30:00.000Z",
        "revokedReason": "revoked",
        "runtime": "openclaw"
      }
    ],
    "installations": [
      {
        "id": "installation_example",
        "agentId": "agent_example",
        "credentialFamilyId": "credential_family_example",
        "registrationId": "registration_first",
        "connectionRoute": "local_helper",
        "deliveryMode": "envoi_link",
        "runtime": {
          "type": "hermes",
          "version": "0.9.0"
        },
        "createdAt": "2026-10-12T09:00:00.000Z",
        "activatedAt": "2026-10-12T09:00:00.000Z",
        "replayDetectedAt": null
      }
    ]
  },
  "steps": [
    {
      "request": {
        "method": "GET",
        "path": "/api/inboxes/inbox_example/agents",
        "auth": "human_session",
        "headers": {
          "cookie": "envoi_session=PLACEHOLDER_session"
        }
      },
      "response": {
        "status": 200,
        "schema": "a5-presence/ownerAgentList",
        "headers": {
          "cache-control": "no-store"
        },
        "body": [
          {
            "id": "agent_example",
            "name": "Example agent",
            "slug": "example",
            "address": "example@envoi.mail",
            "platformAddress": "example@envoi.mail",
            "status": "revoked",
            "onboardingStatus": "approved",
            "permissions": [],
            "createdAt": "2026-10-12T09:00:00.000Z",
            "paused": false,
            "credentialRevoked": true,
            "connection": {
              "state": "revoked",
              "asOf": "2026-10-12T12:00:42.000Z",
              "recentWindowSeconds": 300,
              "seenAt": "2026-10-12T10:55:00.000Z",
              "credentialExpiresAt": null,
              "presence": {
                "lastSeenAt": "2026-10-12T10:58:00.000Z",
                "lastSuccessfulRefreshAt": "2026-10-12T10:30:00.000Z",
                "lastWorkClaimAt": "2026-10-12T10:55:00.000Z",
                "lastProcessedAt": "2026-10-12T10:20:00.000Z"
              }
            }
          }
        ]
      },
      "client": {
        "surface": "owner_ui",
        "reconnectOffered": [
          "agent_example"
        ],
        "next": "Show \"Revoked · Access revoked\" (a5-presence v1), and offer Reconnect an existing agent: onboardingStatus is approved and credentialRevoked is true, so the identity is not frozen."
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/inboxes/inbox_frozen/agents",
        "auth": "human_session",
        "headers": {
          "cookie": "envoi_session=PLACEHOLDER_session"
        }
      },
      "response": {
        "status": 200,
        "schema": "a5-presence/ownerAgentList",
        "headers": {
          "cache-control": "no-store"
        },
        "body": [
          {
            "id": "agent_frozen",
            "name": "Frozen agent",
            "slug": "frozen",
            "address": "frozen@envoi.mail",
            "platformAddress": "frozen@envoi.mail",
            "status": "revoked",
            "onboardingStatus": "revoked",
            "permissions": [],
            "createdAt": "2026-10-10T09:00:00.000Z",
            "paused": false,
            "credentialRevoked": true,
            "connection": {
              "state": "revoked",
              "asOf": "2026-10-12T12:00:42.000Z",
              "recentWindowSeconds": 300,
              "seenAt": "2026-10-11T16:00:00.000Z",
              "credentialExpiresAt": null,
              "presence": {
                "lastSeenAt": "2026-10-11T16:00:00.000Z",
                "lastSuccessfulRefreshAt": "2026-10-11T15:50:00.000Z",
                "lastWorkClaimAt": "2026-10-11T16:00:00.000Z",
                "lastProcessedAt": "2026-10-11T15:12:00.000Z"
              }
            }
          }
        ]
      },
      "client": {
        "surface": "owner_ui",
        "reconnectOffered": [],
        "next": "Do not offer Reconnect an existing agent: onboardingStatus revoked means the agent-wide revoke froze it (AGENT_NOT_RECONNECTABLE). Point to re-enrollment through Quick Connect."
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/agent-registrations/registration_example/approve",
        "auth": "human_session",
        "headers": {
          "cookie": "envoi_session=PLACEHOLDER_session; envoi_csrf=PLACEHOLDER_csrf",
          "x-envoi-csrf": "PLACEHOLDER_csrf",
          "origin": "https://www.envoi-agents.com"
        },
        "schema": "claimApproveRequest",
        "body": {
          "verificationCode": "F7KQ-PM4D",
          "target": {
            "kind": "existing_agent",
            "agentId": "agent_example",
            "replacesInstallationId": null
          },
          "grantedPermissions": [
            "send_agent_messages"
          ],
          "policyProfile": "default"
        }
      },
      "response": {
        "status": 200,
        "schema": "claimApproved",
        "headers": {
          "cache-control": "no-store"
        },
        "body": {
          "registrationId": "registration_example",
          "status": "approved",
          "target": "existing_agent",
          "workspaceName": "Example workspace",
          "agent": {
            "id": "agent_example",
            "name": "Example agent",
            "address": "example@envoi.mail"
          },
          "effectivePermissions": [
            "send_agent_messages",
            "receive_agent_messages"
          ],
          "policyProfile": "default",
          "activationExpiresAt": "2026-10-12T12:13:00.000Z"
        }
      },
      "client": {
        "surface": "owner_ui",
        "next": "No installation is active, so replacesInstallationId is null and nothing is disconnected. On activation the agent keeps its id, address, cases and history, with the permissions decided again."
      }
    }
  ],
  "client": {
    "surface": "owner_ui",
    "next": "Offer every agent the §5.3 predicate allows: onboardingStatus approved, and status active or paused, or credentialRevoked true. test/agent-reconnect-after-revoke.test.js proves the server side on FileStore and PostgreSQL."
  }
}
