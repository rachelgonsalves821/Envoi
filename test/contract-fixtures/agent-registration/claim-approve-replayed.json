{
  "contract": "agent-registration",
  "version": 1,
  "id": "claim-approve-replayed",
  "kind": "http",
  "description": "The browser lost the approval response; the same human sends the identical body. It replays the same 200 and does not count as a failure.",
  "context": {
    "requestedPermissions": [
      "send_agent_messages",
      "receive_agent_messages"
    ]
  },
  "request": {
    "method": "POST",
    "path": "/api/agent-registrations/registration_example/approve",
    "auth": "human_session",
    "headers": {
      "cookie": "envoi_session=PLACEHOLDER_session; envoi_csrf=PLACEHOLDER_csrf",
      "x-envoi-csrf": "PLACEHOLDER_csrf",
      "origin": "https://www.envoi-agents.com"
    },
    "schema": "claimApproveRequest",
    "body": {
      "verificationCode": "F7KQ-PM4D",
      "target": {
        "kind": "new_agent",
        "workspaceInboxId": "inbox_workspace_example",
        "name": "Example agent",
        "localPart": "example"
      },
      "grantedPermissions": [
        "send_agent_messages",
        "receive_agent_messages",
        "execute_cases"
      ],
      "policyProfile": "default"
    }
  },
  "response": {
    "status": 200,
    "schema": "claimApproved",
    "headers": {
      "cache-control": "no-store"
    },
    "body": {
      "registrationId": "registration_example",
      "status": "approved",
      "target": "new_agent",
      "workspaceName": "Example workspace",
      "agent": {
        "name": "Example agent",
        "address": "example@envoi.mail"
      },
      "effectivePermissions": [
        "send_agent_messages",
        "receive_agent_messages"
      ],
      "policyProfile": "default",
      "activationExpiresAt": "2026-10-12T12:13:00.000Z"
    }
  },
  "client": {
    "surface": "owner_ui",
    "next": "Same as claim-approve-new-agent."
  }
}
