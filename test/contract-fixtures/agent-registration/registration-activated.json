{
  "contract": "agent-registration",
  "version": 1,
  "id": "registration-activated",
  "kind": "http",
  "description": "Polling inside the recovery window after activation (the helper lost the response). Status only; credentials are never repeated here.",
  "request": {
    "method": "GET",
    "path": "/api/agent-registrations/registration_example",
    "auth": "bootstrap",
    "headers": {
      "authorization": "Bearer envoi_reg_PLACEHOLDER_example"
    }
  },
  "response": {
    "status": 200,
    "schema": "registrationStatus",
    "headers": {
      "cache-control": "no-store"
    },
    "body": {
      "registrationId": "registration_example",
      "status": "activated",
      "installationId": "installation_example"
    }
  },
  "client": {
    "surface": "helper",
    "lifecycle": "ACTIVATING",
    "retry": "none",
    "guidance": "none",
    "modelVisible": {
      "state": "needs_help",
      "registrationStatus": "activated"
    },
    "next": "Retry activation with the persisted activationId inside the 300 s window. Without it, the owner reconnects."
  }
}
