{
  "contract": "agent-registration",
  "version": 1,
  "id": "activation-token-consumed",
  "kind": "http",
  "description": "After the recovery window the bootstrap token is gone: any activation, even with a different activationId, is an unknown token and revokes nothing.",
  "request": {
    "method": "POST",
    "path": "/api/agent-installations/activate",
    "auth": "bootstrap",
    "headers": {
      "authorization": "Bearer envoi_reg_PLACEHOLDER_example"
    },
    "schema": "activationRequest",
    "body": {
      "registrationId": "registration_example",
      "activationId": "activation_late_holder",
      "deliveryMode": "envoi_link"
    }
  },
  "response": {
    "status": 401,
    "schema": "errorEnvelope",
    "body": {
      "code": "REGISTRATION_TOKEN_INVALID",
      "error": "REGISTRATION_TOKEN_INVALID",
      "message": "This setup is no longer valid.",
      "requestId": "req_example"
    }
  },
  "client": {
    "surface": "helper",
    "lifecycle": "REGISTRATION_ENDED",
    "retry": "none",
    "guidance": "register_again",
    "next": "Delete local registration state.",
    "modelVisible": {
      "state": "registration_ended",
      "guidance": "register_again"
    }
  }
}
