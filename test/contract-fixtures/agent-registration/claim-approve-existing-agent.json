{
  "contract": "agent-registration",
  "version": 1,
  "id": "claim-approve-existing-agent",
  "kind": "http",
  "description": "The owner attaches this registration to an existing paused agent, confirming the installation it will replace, and re-chooses permissions. receive_agent_messages is always added.",
  "context": {
    "requestedPermissions": [
      "send_agent_messages",
      "receive_agent_messages"
    ]
  },
  "request": {
    "method": "POST",
    "path": "/api/agent-registrations/registration_example/approve",
    "auth": "human_session",
    "headers": {
      "cookie": "envoi_session=PLACEHOLDER_session; envoi_csrf=PLACEHOLDER_csrf",
      "x-envoi-csrf": "PLACEHOLDER_csrf",
      "origin": "https://www.envoi-agents.com"
    },
    "schema": "claimApproveRequest",
    "body": {
      "verificationCode": "F7KQ-PM4D",
      "target": {
        "kind": "existing_agent",
        "agentId": "agent_example",
        "replacesInstallationId": "installation_legacy_0b6f8f9e-1c2d-4e5f-8a9b-0c1d2e3f4a5b"
      },
      "grantedPermissions": [
        "send_agent_messages"
      ],
      "policyProfile": "default"
    }
  },
  "response": {
    "status": 200,
    "schema": "claimApproved",
    "headers": {
      "cache-control": "no-store"
    },
    "body": {
      "registrationId": "registration_example",
      "status": "approved",
      "target": "existing_agent",
      "workspaceName": "Example workspace",
      "agent": {
        "id": "agent_example",
        "name": "Example agent",
        "address": "example@envoi.mail"
      },
      "effectivePermissions": [
        "send_agent_messages",
        "receive_agent_messages"
      ],
      "policyProfile": "default",
      "activationExpiresAt": "2026-10-12T12:13:00.000Z"
    }
  },
  "client": {
    "surface": "owner_ui",
    "next": "Explain that the current installation keeps working until the new one activates, then is replaced; the agent keeps its address, cases and history, and stays paused until resumed."
  }
}
