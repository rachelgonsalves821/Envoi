{
  "contract": "agent-registration",
  "version": 1,
  "id": "bootstrap-pending-no-status",
  "kind": "http",
  "description": "A pending registration's bootstrap token on agent status.",
  "request": {
    "method": "GET",
    "path": "/api/agent/status",
    "auth": "bootstrap",
    "headers": {
      "authorization": "Bearer envoi_reg_PLACEHOLDER_example"
    }
  },
  "response": {
    "status": 401,
    "schema": "errorEnvelope",
    "body": {
      "code": "AUTHENTICATION_REQUIRED",
      "error": "AUTHENTICATION_REQUIRED",
      "message": "Authentication is required.",
      "requestId": "req_example"
    }
  },
  "client": {
    "surface": "helper",
    "lifecycle": "UNCHANGED",
    "retry": "none",
    "guidance": "none",
    "next": "A registration has no inbox, messaging, claim, case, file, MCP or directory access. Only §4 and §6.1 accept it."
  }
}
