{
  "contract": "agent-registration",
  "version": 1,
  "id": "claim-approve-new-agent",
  "kind": "http",
  "description": "The owner approves a new agent. execute_cases was granted but not requested, so the intersection drops it. The agent is created only at activation; no credential reaches the browser.",
  "context": {
    "requestedPermissions": [
      "send_agent_messages",
      "receive_agent_messages"
    ]
  },
  "request": {
    "method": "POST",
    "path": "/api/agent-registrations/registration_example/approve",
    "auth": "human_session",
    "headers": {
      "cookie": "envoi_session=PLACEHOLDER_session; envoi_csrf=PLACEHOLDER_csrf",
      "x-envoi-csrf": "PLACEHOLDER_csrf",
      "origin": "https://www.envoi-agents.com"
    },
    "schema": "claimApproveRequest",
    "body": {
      "verificationCode": "F7KQ-PM4D",
      "target": {
        "kind": "new_agent",
        "workspaceInboxId": "inbox_workspace_example",
        "name": "Example agent",
        "localPart": "example"
      },
      "grantedPermissions": [
        "send_agent_messages",
        "receive_agent_messages",
        "execute_cases"
      ],
      "policyProfile": "default"
    }
  },
  "response": {
    "status": 200,
    "schema": "claimApproved",
    "headers": {
      "cache-control": "no-store"
    },
    "body": {
      "registrationId": "registration_example",
      "status": "approved",
      "target": "new_agent",
      "workspaceName": "Example workspace",
      "agent": {
        "name": "Example agent",
        "address": "example@envoi.mail"
      },
      "effectivePermissions": [
        "send_agent_messages",
        "receive_agent_messages"
      ],
      "policyProfile": "default",
      "activationExpiresAt": "2026-10-12T12:13:00.000Z"
    }
  },
  "client": {
    "surface": "owner_ui",
    "next": "Show \"Approved. Waiting for your agent to finish setup\", with Withdraw. The address and an agent slot are held until activation or expiry."
  }
}
