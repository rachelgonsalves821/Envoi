{
  "contract": "agent-registration",
  "version": 1,
  "id": "claim-agent-not-reconnectable",
  "kind": "http",
  "description": "existing_agent target the human manages but which was frozen by the agent-wide revoke.",
  "request": {
    "method": "POST",
    "path": "/api/agent-registrations/registration_example/approve",
    "auth": "human_session",
    "headers": {
      "cookie": "envoi_session=PLACEHOLDER_session; envoi_csrf=PLACEHOLDER_csrf",
      "x-envoi-csrf": "PLACEHOLDER_csrf",
      "origin": "https://www.envoi-agents.com"
    },
    "schema": "claimApproveRequest",
    "body": {
      "verificationCode": "F7KQ-PM4D",
      "target": {
        "kind": "existing_agent",
        "agentId": "agent_frozen",
        "replacesInstallationId": null
      },
      "grantedPermissions": [
        "send_agent_messages"
      ],
      "policyProfile": "default"
    }
  },
  "response": {
    "status": 409,
    "schema": "errorEnvelope",
    "body": {
      "code": "AGENT_NOT_RECONNECTABLE",
      "error": "AGENT_NOT_RECONNECTABLE",
      "message": "That agent cannot be reconnected here.",
      "requestId": "req_example"
    }
  },
  "client": {
    "surface": "owner_ui",
    "lifecycle": "NOT_APPLICABLE",
    "retry": "none",
    "guidance": "choose_another_agent",
    "next": "Let the owner choose another agent or create a new one."
  }
}
