{
  "contract": "a5-presence-on-demand",
  "version": 1,
  "id": "owner-on-demand-paused",
  "description": "A paused remote MCP assistant. Its user tried a tool 2 min ago and got 409 AGENT_PAUSED, which still updates lastSeenAt; its refresh 10 min ago succeeded while paused.",
  "kind": "http",
  "context": {
    "reportedInstallations": [
      {
        "agentId": "agent_example",
        "installation": {
          "id": "installation_remote_example",
          "connectionRoute": "remote_mcp_oauth",
          "deliveryMode": "on_demand",
          "legacy": false
        }
      }
    ]
  },
  "request": {
    "method": "GET",
    "path": "/api/inboxes/inbox_example/agents",
    "auth": "human_session"
  },
  "response": {
    "status": 200,
    "schema": "ownerAgentList",
    "body": [
      {
        "id": "agent_example",
        "name": "Example assistant",
        "slug": "example",
        "address": "example@envoi.mail",
        "platformAddress": "example@envoi.mail",
        "status": "paused",
        "onboardingStatus": "approved",
        "permissions": [
          "send_agent_messages",
          "receive_agent_messages"
        ],
        "createdAt": "2026-10-20T09:00:00.000Z",
        "paused": true,
        "credentialRevoked": false,
        "connection": {
          "state": "on_demand",
          "asOf": "2026-10-22T12:00:42.000Z",
          "recentWindowSeconds": 300,
          "seenAt": "2026-10-22T11:58:30.000Z",
          "credentialExpiresAt": "2026-11-21T11:50:00.000Z",
          "presence": {
            "lastSeenAt": "2026-10-22T11:58:30.000Z",
            "lastSuccessfulRefreshAt": "2026-10-22T11:50:00.000Z",
            "lastWorkClaimAt": null,
            "lastProcessedAt": null
          }
        }
      }
    ]
  },
  "client": {
    "surface": "owner_ui",
    "connectionLabel": "On demand",
    "connectionDetail": "Last request {relative}",
    "agentLabel": "Paused",
    "next": "Show \"Paused · On demand · Last request 2 minutes ago\". Pause is the agent label; resume is a separate owner action."
  }
}
