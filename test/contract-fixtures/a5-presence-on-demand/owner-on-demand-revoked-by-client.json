{
  "contract": "a5-presence-on-demand",
  "version": 1,
  "id": "owner-on-demand-revoked-by-client",
  "description": "The user disconnected Envoi in the assistant, which revoked the family through POST /oauth/revoke. It was the agent's only installation, so the owner view reports revoked. The identity is not frozen.",
  "kind": "http",
  "context": {
    "reportedInstallations": [
      {
        "agentId": "agent_example",
        "installation": {
          "id": "installation_remote_example",
          "connectionRoute": "remote_mcp_oauth",
          "deliveryMode": "on_demand",
          "legacy": false
        }
      }
    ]
  },
  "request": {
    "method": "GET",
    "path": "/api/inboxes/inbox_example/agents",
    "auth": "human_session"
  },
  "response": {
    "status": 200,
    "schema": "ownerAgentList",
    "body": [
      {
        "id": "agent_example",
        "name": "Example assistant",
        "slug": "example",
        "address": "example@envoi.mail",
        "platformAddress": "example@envoi.mail",
        "status": "revoked",
        "onboardingStatus": "approved",
        "permissions": [],
        "createdAt": "2026-10-20T09:00:00.000Z",
        "paused": false,
        "credentialRevoked": true,
        "connection": {
          "state": "revoked",
          "asOf": "2026-10-22T12:00:42.000Z",
          "recentWindowSeconds": 300,
          "seenAt": "2026-10-22T10:05:00.000Z",
          "credentialExpiresAt": null,
          "presence": {
            "lastSeenAt": "2026-10-22T10:05:00.000Z",
            "lastSuccessfulRefreshAt": "2026-10-22T09:40:00.000Z",
            "lastWorkClaimAt": null,
            "lastProcessedAt": null
          }
        }
      }
    ]
  },
  "client": {
    "surface": "owner_ui",
    "connectionLabel": "Access revoked",
    "agentLabel": "Revoked",
    "next": "Show \"Revoked · Access revoked\" and offer \"Reconnect an existing agent\" (agent-registration revision 4). Do not show On demand."
  }
}
