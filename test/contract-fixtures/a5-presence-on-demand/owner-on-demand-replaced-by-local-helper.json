{
  "contract": "a5-presence-on-demand",
  "version": 1,
  "id": "owner-on-demand-replaced-by-local-helper",
  "description": "The owner reconnected the agent through a local helper, which replaced its on-demand installation. The reported family is now the helper family, so a5-presence v1 rows apply.",
  "kind": "http",
  "context": {
    "reportedInstallations": [
      {
        "agentId": "agent_example",
        "installation": {
          "id": "installation_helper_example",
          "connectionRoute": "local_helper",
          "deliveryMode": "envoi_link",
          "legacy": false
        }
      }
    ]
  },
  "request": {
    "method": "GET",
    "path": "/api/inboxes/inbox_example/agents",
    "auth": "human_session"
  },
  "response": {
    "status": 200,
    "schema": "ownerAgentList",
    "body": [
      {
        "id": "agent_example",
        "name": "Example assistant",
        "slug": "example",
        "address": "example@envoi.mail",
        "platformAddress": "example@envoi.mail",
        "status": "active",
        "onboardingStatus": "approved",
        "permissions": [
          "send_agent_messages",
          "receive_agent_messages"
        ],
        "createdAt": "2026-10-20T09:00:00.000Z",
        "paused": false,
        "credentialRevoked": false,
        "connection": {
          "state": "seen_recently",
          "asOf": "2026-10-22T12:00:42.000Z",
          "recentWindowSeconds": 300,
          "seenAt": "2026-10-22T12:00:20.000Z",
          "credentialExpiresAt": "2026-11-21T11:45:00.000Z",
          "presence": {
            "lastSeenAt": "2026-10-22T12:00:20.000Z",
            "lastSuccessfulRefreshAt": "2026-10-22T11:45:00.000Z",
            "lastWorkClaimAt": "2026-10-22T12:00:20.000Z",
            "lastProcessedAt": null
          }
        }
      }
    ]
  },
  "client": {
    "surface": "owner_ui",
    "connectionLabel": "Seen recently",
    "agentLabel": "Active",
    "next": "Show \"Active · Seen recently\". The ended on-demand installation is listed only under installations."
  }
}
