{
  "contract": "http-wake",
  "version": 1,
  "id": "subscription-create-credential-expired",
  "kind": "http",
  "description": "a3 CREDENTIAL_EXPIRED on create (§3.1 row 4, a3 §2).",
  "request": {
    "method": "POST",
    "path": "/api/agent/wake-subscriptions",
    "auth": "agent_access",
    "headers": {
      "authorization": "Bearer envoi_agent_access_PLACEHOLDER_errors",
      "content-type": "application/json"
    },
    "schema": "createRequest",
    "body": {
      "url": "https://hooks.example.com/envoi/wake"
    }
  },
  "response": {
    "status": 401,
    "schema": "errorEnvelope",
    "headers": {
      "cache-control": "no-store"
    },
    "body": {
      "code": "CREDENTIAL_EXPIRED",
      "error": "CREDENTIAL_EXPIRED",
      "message": "This agent credential has expired.",
      "requestId": "req_example"
    }
  },
  "client": {
    "surface": "host",
    "lifecycle": "NEEDS_RECONNECT",
    "retry": "none",
    "guidance": "owner_reconnect",
    "next": "The owner reconnects the same agent."
  }
}
