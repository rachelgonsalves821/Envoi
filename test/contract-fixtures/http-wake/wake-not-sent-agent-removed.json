{
  "contract": "http-wake",
  "version": 1,
  "id": "wake-not-sent-agent-removed",
  "kind": "delivery",
  "description": "An agent revoked or removed fails a3 §2.1 step 3 even when its family is not revoked, so its subscriptions end with credential_ended and nothing is sent (§8.3).",
  "context": {
    "subscription": {
      "id": "wake_sub_agent_removed",
      "url": "https://hooks.example.com/envoi/wake",
      "status": "active"
    },
    "agentStatus": "active",
    "credential": "ended",
    "note": "The owner removed the agent; its family document was not revoked."
  },
  "delivery": {
    "origin": "server",
    "attempt": 1,
    "sent": false,
    "failureClass": null,
    "outcome": "not_sent",
    "notSentReason": "subscription_ended",
    "suppressed": {
      "type": "wake.work_available",
      "reason": "message_delivered"
    }
  }
}
