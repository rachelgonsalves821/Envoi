{
  "contract": "http-wake",
  "version": 1,
  "id": "subscription-activate-active-wrong-challenge",
  "kind": "http",
  "description": "A wrong challenge for an active subscription (§3.3 row 8). It stays active, unchanged.",
  "request": {
    "method": "POST",
    "path": "/api/agent/wake-subscriptions/wake_sub_fresh/activate",
    "auth": "agent_access",
    "headers": {
      "authorization": "Bearer envoi_agent_access_PLACEHOLDER_fresh",
      "content-type": "application/json"
    },
    "schema": "activateRequest",
    "body": {
      "challenge": "envoi_wake_challenge_PLACEHOLDER_other"
    }
  },
  "response": {
    "status": 400,
    "schema": "errorEnvelope",
    "headers": {
      "cache-control": "no-store"
    },
    "body": {
      "code": "WAKE_CHALLENGE_INVALID",
      "error": "WAKE_CHALLENGE_INVALID",
      "message": "The wake challenge does not match.",
      "requestId": "req_example"
    }
  },
  "client": {
    "surface": "host",
    "lifecycle": "UNCHANGED",
    "retry": "none",
    "guidance": "none",
    "next": "Nothing to do; the subscription is active."
  }
}
