{
  "contract": "http-wake",
  "version": 1,
  "id": "agent-status-http-wake",
  "kind": "http",
  "description": "Agent status reports wake availability and this installation's subscription additively (§1, §9). The host reads it at startup and on every safety poll (§7.4).",
  "flags": {
    "ENVOI_HTTP_WAKE_V1": true,
    "ENVOI_INSTALLATIONS_V2": true
  },
  "request": {
    "method": "GET",
    "path": "/api/agent/status",
    "auth": "agent_access",
    "headers": {
      "authorization": "Bearer envoi_agent_access_PLACEHOLDER_example"
    }
  },
  "response": {
    "status": 200,
    "schema": "agentStatusHttpWake",
    "headers": {},
    "body": {
      "state": "active",
      "agent": {
        "id": "agent_example",
        "address": "example@envoi.mail",
        "status": "active"
      },
      "inboxId": "inbox_example",
      "asOf": "2026-10-17T12:00:00.000Z",
      "presence": {
        "lastSeenAt": "2026-10-17T12:00:00.000Z",
        "lastSuccessfulRefreshAt": null,
        "lastWorkClaimAt": "2026-10-17T12:00:00.000Z",
        "lastProcessedAt": null
      },
      "installation": {
        "id": "installation_example",
        "connectionRoute": "local_helper",
        "deliveryMode": "envoi_link",
        "legacy": false
      },
      "httpWake": {
        "available": true,
        "version": 1,
        "subscription": {
          "id": "wake_sub_example",
          "status": "active",
          "endedReason": null,
          "expiresAt": "2026-11-15T12:00:10.000Z"
        }
      }
    }
  },
  "client": {
    "surface": "host",
    "lifecycle": "RUNNING",
    "retry": "none",
    "guidance": "none",
    "next": "Wake is working; replace the subscription before expiresAt (§3.4)."
  }
}
