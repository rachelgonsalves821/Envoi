{
  "contract": "http-wake",
  "version": 1,
  "id": "subscription-create-url-field-too-long",
  "kind": "http",
  "description": "A url field longer than createUrlFieldMaxLength is a body error, not a URL rule (§3.1 row 5).",
  "request": {
    "method": "POST",
    "path": "/api/agent/wake-subscriptions",
    "auth": "agent_access",
    "headers": {
      "authorization": "Bearer envoi_agent_access_PLACEHOLDER_example",
      "content-type": "application/json"
    },
    "invalidAgainst": "createRequest",
    "invalidBecause": {
      "keyword": "maxLength",
      "instancePath": "/url"
    },
    "body": {
      "url": "https://hooks.example."
    }
  },
  "response": {
    "status": 400,
    "schema": "errorEnvelope",
    "headers": {
      "cache-control": "no-store"
    },
    "body": {
      "code": "WAKE_SUBSCRIPTION_INVALID",
      "error": "WAKE_SUBSCRIPTION_INVALID",
      "message": "The wake subscription request is not valid.",
      "requestId": "req_example"
    }
  },
  "client": {
    "surface": "host",
    "lifecycle": "UNCHANGED",
    "retry": "none",
    "guidance": "update_connector",
    "next": "Fix the client."
  }
}
