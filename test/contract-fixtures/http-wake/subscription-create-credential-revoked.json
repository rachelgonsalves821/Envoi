{
  "contract": "http-wake",
  "version": 1,
  "id": "subscription-create-credential-revoked",
  "kind": "http",
  "description": "a3 CREDENTIAL_REVOKED on create (§3.1 row 4, a3 §2).",
  "request": {
    "method": "POST",
    "path": "/api/agent/wake-subscriptions",
    "auth": "agent_access",
    "headers": {
      "authorization": "Bearer envoi_agent_access_PLACEHOLDER_example",
      "content-type": "application/json"
    },
    "schema": "createRequest",
    "body": {
      "url": "https://hooks.example.com/envoi/wake"
    }
  },
  "response": {
    "status": 401,
    "schema": "errorEnvelope",
    "headers": {
      "cache-control": "no-store"
    },
    "body": {
      "code": "CREDENTIAL_REVOKED",
      "error": "CREDENTIAL_REVOKED",
      "message": "This agent credential has been revoked.",
      "requestId": "req_example",
      "reason": "revoked"
    }
  },
  "client": {
    "surface": "host",
    "lifecycle": "REVOKED",
    "retry": "none",
    "guidance": "owner_reenroll",
    "next": "Stop. The owner must enroll the agent again."
  }
}
