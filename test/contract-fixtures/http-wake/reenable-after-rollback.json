{
  "contract": "http-wake",
  "version": 1,
  "id": "reenable-after-rollback",
  "kind": "rollback",
  "description": "After a disable the wake epoch has moved (§1), so a subscription created before it that had not already ended reads as ended with feature_disabled, and the host registers and proves its URL again.",
  "flags": {
    "ENVOI_HTTP_WAKE_V1": true,
    "ENVOI_INSTALLATIONS_V2": true
  },
  "steps": [
    {
      "request": {
        "method": "GET",
        "path": "/api/agent/status",
        "auth": "agent_access",
        "headers": {
          "authorization": "Bearer envoi_agent_access_PLACEHOLDER_reenabled"
        }
      },
      "response": {
        "status": 200,
        "schema": "agentStatusHttpWake",
        "headers": {},
        "body": {
          "state": "active",
          "agent": {
            "id": "agent_example",
            "address": "example@envoi.mail",
            "status": "active"
          },
          "inboxId": "inbox_example",
          "asOf": "2026-10-17T12:00:00.000Z",
          "presence": {
            "lastSeenAt": "2026-10-17T12:00:00.000Z",
            "lastSuccessfulRefreshAt": null,
            "lastWorkClaimAt": "2026-10-17T12:00:00.000Z",
            "lastProcessedAt": null
          },
          "installation": {
            "id": "installation_example",
            "connectionRoute": "local_helper",
            "deliveryMode": "envoi_link",
            "legacy": false
          },
          "httpWake": {
            "available": true,
            "version": 1,
            "subscription": {
              "id": "wake_sub_reenabled",
              "status": "ended",
              "endedReason": "feature_disabled",
              "expiresAt": "2026-11-16T11:00:00.000Z"
            }
          }
        }
      },
      "client": {
        "surface": "host",
        "lifecycle": "RUNNING",
        "retry": "create_subscription",
        "guidance": "create_new_subscription",
        "next": "Create a new subscription."
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/agent/wake-subscriptions",
        "auth": "agent_access",
        "headers": {
          "authorization": "Bearer envoi_agent_access_PLACEHOLDER_reenabled"
        }
      },
      "response": {
        "status": 200,
        "schema": "hostSubscriptionList",
        "headers": {
          "cache-control": "no-store"
        },
        "body": {
          "installationId": "installation_reenabled",
          "subscriptions": [
            {
              "id": "wake_sub_reenabled",
              "installationId": "installation_reenabled",
              "agentId": "agent_reenabled",
              "url": "https://hooks.example.com/envoi/wake",
              "status": "ended",
              "endedReason": "feature_disabled",
              "createdAt": "2026-10-17T10:59:50.000Z",
              "activatedAt": "2026-10-17T11:00:00.000Z",
              "expiresAt": "2026-11-16T11:00:00.000Z",
              "endedAt": "2026-10-17T12:00:00.000Z",
              "challengeExpiresAt": null,
              "replacesSubscriptionId": null,
              "delivery": {
                "state": "healthy",
                "lastAttemptAt": "2026-10-17T11:00:05.000Z",
                "lastSuccessAt": "2026-10-17T11:00:05.000Z",
                "consecutiveFailures": 0,
                "lastFailureClass": null
              }
            }
          ]
        }
      },
      "client": {
        "surface": "host",
        "lifecycle": "UNCHANGED",
        "retry": "create_subscription",
        "guidance": "create_new_subscription",
        "next": "Create a new subscription."
      }
    },
    {
      "context": {
        "subscription": {
          "id": "wake_sub_reenabled",
          "url": "https://hooks.example.com/envoi/wake",
          "status": "ended",
          "endedReason": "feature_disabled"
        },
        "agentStatus": "active"
      },
      "delivery": {
        "origin": "server",
        "attempt": 1,
        "sent": false,
        "failureClass": null,
        "outcome": "not_sent",
        "notSentReason": "subscription_ended",
        "suppressed": {
          "type": "wake.work_available",
          "reason": "message_delivered"
        }
      }
    },
    {
      "context": {
        "dns": {
          "host": "hooks.example.com",
          "addresses": [
            "192.0.32.10"
          ]
        }
      },
      "request": {
        "method": "POST",
        "path": "/api/agent/wake-subscriptions",
        "auth": "agent_access",
        "headers": {
          "authorization": "Bearer envoi_agent_access_PLACEHOLDER_reenabled",
          "content-type": "application/json"
        },
        "schema": "createRequest",
        "body": {
          "url": "https://hooks.example.com/envoi/wake"
        }
      },
      "response": {
        "status": 201,
        "schema": "subscriptionResponse",
        "headers": {
          "cache-control": "no-store"
        },
        "body": {
          "subscription": {
            "id": "wake_sub_reenabled_new",
            "installationId": "installation_reenabled",
            "agentId": "agent_reenabled",
            "url": "https://hooks.example.com/envoi/wake",
            "status": "pending",
            "endedReason": null,
            "createdAt": "2026-10-17T12:01:00.000Z",
            "activatedAt": null,
            "expiresAt": null,
            "endedAt": null,
            "challengeExpiresAt": "2026-10-17T12:11:00.000Z",
            "replacesSubscriptionId": null,
            "delivery": {
              "state": "unverified",
              "lastAttemptAt": null,
              "lastSuccessAt": null,
              "consecutiveFailures": 0,
              "lastFailureClass": null
            }
          }
        }
      },
      "client": {
        "surface": "host",
        "lifecycle": "UNCHANGED",
        "retry": "none",
        "guidance": "none",
        "next": "Activate with the new challenge."
      }
    }
  ]
}
