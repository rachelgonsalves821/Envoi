{
  "contract": "http-wake",
  "version": 1,
  "id": "subscription-create-access-token-expired",
  "kind": "http",
  "description": "a3 ACCESS_TOKEN_EXPIRED on create (§3.1 row 4, a3 §2).",
  "request": {
    "method": "POST",
    "path": "/api/agent/wake-subscriptions",
    "auth": "agent_access",
    "headers": {
      "authorization": "Bearer envoi_agent_access_PLACEHOLDER_errors",
      "content-type": "application/json"
    },
    "schema": "createRequest",
    "body": {
      "url": "https://hooks.example.com/envoi/wake"
    }
  },
  "response": {
    "status": 401,
    "schema": "errorEnvelope",
    "headers": {
      "cache-control": "no-store"
    },
    "body": {
      "code": "ACCESS_TOKEN_EXPIRED",
      "error": "ACCESS_TOKEN_EXPIRED",
      "message": "The access token has expired.",
      "requestId": "req_example"
    }
  },
  "client": {
    "surface": "host",
    "lifecycle": "UNCHANGED",
    "retry": "refresh_then_retry_once",
    "guidance": "none",
    "next": "Refresh once, then retry once."
  }
}
