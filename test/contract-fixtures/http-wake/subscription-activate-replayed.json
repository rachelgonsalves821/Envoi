        "endedReason": null,
        "createdAt": "2026-10-17T12:00:00.000Z",
        "activatedAt": "2026-10-17T12:00:05.000Z",
        "expiresAt": "2026-11-16T12:00:05.000Z",
        "endedAt": null,
        "challengeExpiresAt": null,
        "replacesSubscriptionId": null,
        "delivery": {
          "state": "healthy",
          "lastAttemptAt": "2026-10-17T12:00:02.000Z",
          "lastSuccessAt": "2026-10-17T12:00:02.000Z",
          "consecutiveFailures": 0,
          "lastFailureClass": null
        }
      }
    }
  },
  "client": {
    "surface": "host",
    "lifecycle": "UNCHANGED",
    "retry": "none",
    "guidance": "none",
    "next": "Nothing changed."
  }
}
