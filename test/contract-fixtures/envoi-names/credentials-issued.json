{
  "contract": "envoi-names",
  "version": 1,
  "id": "credentials-issued",
  "description": "A refresh (and every other issuance path) returns Envoi-format credentials.",
  "kind": "http",
  "request": {
    "method": "POST",
    "path": "/api/agent-token",
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "grantType": "refresh_token",
      "agentRefreshToken": "envoi_agent_refresh_PLACEHOLDERxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "rotationId": "rotation_PLACEHOLDER_0001"
    }
  },
  "response": {
    "status": 200,
    "schema": "tokenPair",
    "body": {
      "agentApiToken": "envoi_agent_access_PLACEHOLDERxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "agentRefreshToken": "envoi_agent_refresh_PLACEHOLDERxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "agentTokenExpiresAt": "2026-10-09T12:00:00.000Z",
      "agentRefreshTokenExpiresAt": "2026-11-08T12:00:00.000Z",
      "tokenType": "Bearer"
    }
  },
  "client": {
    "lifecycle": "UNCHANGED",
    "retry": "none",
    "guidance": "none",
    "next": "Save the successor atomically (A1)."
  }
}
