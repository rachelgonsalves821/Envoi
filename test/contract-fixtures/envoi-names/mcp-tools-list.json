{
  "contract": "envoi-names",
  "version": 2,
  "id": "mcp-tools-list",
  "description": "An access token lists exactly the 22 Envoi tools; no sinaloa_* name appears.",
  "kind": "http",
  "request": {
    "method": "POST",
    "path": "/mcp",
    "headers": {
      "authorization": "Bearer envoi_agent_access_PLACEHOLDERxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "accept": "application/json, text/event-stream",
      "content-type": "application/json",
      "mcp-protocol-version": "2025-11-25"
    },
    "body": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "tools/list"
    }
  },
  "response": {
    "status": 200,
    "schema": "mcpToolsList",
    "body": {
      "jsonrpc": "2.0",
      "id": 1,
      "result": {
        "tools": [
          {
            "name": "envoi_agent_info",
            "description": "Envoi tool agent info.",
            "inputSchema": {
              "type": "object"
            }
          },
          {
            "name": "envoi_list_cases",
            "description": "Envoi tool list cases.",
            "inputSchema": {
              "type": "object"
            }
          },
          {
            "name": "envoi_read_case",
            "description": "Envoi tool read case.",
            "inputSchema": {
              "type": "object"
            }
          },
          {
            "name": "envoi_list_messages",
            "description": "Envoi tool list messages.",
            "inputSchema": {
              "type": "object"
            }
          },
          {
            "name": "envoi_start_case",
            "description": "Envoi tool start case.",
            "inputSchema": {
              "type": "object"
            }
          },
          {
            "name": "envoi_send_message",
            "description": "Envoi tool send message.",
            "inputSchema": {
              "type": "object"
            }
          },
          {
            "name": "envoi_start_group_case",
            "description": "Create a shared case with at least two other Envoi agents.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "memberAddresses": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 254,
                    "pattern": "^[^\\s<>@]+@[^\\s<>@]+\\.[^\\s<>@]+$"
                  },
                  "minItems": 2,
                  "uniqueItems": true
                },
                "idempotencyKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                }
              },
              "required": [
                "memberAddresses",
                "idempotencyKey"
              ],
              "additionalProperties": false
            }
          },
          {
            "name": "envoi_read_group_case",
            "description": "Read the roster and shared conversation of a group case you belong to.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "caseId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                }
              },
              "required": [
                "caseId"
              ],
              "additionalProperties": false
            }
          },
          {
            "name": "envoi_send_group_message",
            "description": "Post to an existing group case. Set inReplyTo to reply to a message and assigneeAgentIds to request work from specific members.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "caseId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60000
                },
                "inReplyTo": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                },
                "assigneeAgentIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                  },
                  "minItems": 0,
                  "uniqueItems": true
                },
                "idempotencyKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                }
              },
              "required": [
                "caseId",
                "text",
                "idempotencyKey"
              ],
              "additionalProperties": false
            }
          },
          {
            "name": "envoi_send_proposal",
            "description": "Envoi tool send proposal.",
            "inputSchema": {
              "type": "object"
            }
          },
          {
            "name": "envoi_send_decision",
            "description": "Envoi tool send decision.",
            "inputSchema": {
              "type": "object"
            }
          },
          {
            "name": "envoi_send_completion",
            "description": "Envoi tool send completion.",
            "inputSchema": {
              "type": "object"
            }
          },
          {
            "name": "envoi_claim_work",
            "description": "Envoi tool claim work.",
            "inputSchema": {
              "type": "object"
            }
          },
          {
            "name": "envoi_renew_work",
            "description": "Envoi tool renew work.",
            "inputSchema": {
              "type": "object"
            }
          },
          {
            "name": "envoi_acknowledge_work",
            "description": "Envoi tool acknowledge work.",
            "inputSchema": {
              "type": "object"
            }
          },
          {
            "name": "envoi_complete_work",
            "description": "Envoi tool complete work.",
            "inputSchema": {
              "type": "object"
            }
          },
          {
            "name": "envoi_fail_work",
            "description": "Envoi tool fail work.",
            "inputSchema": {
              "type": "object"
            }
          },
          {
            "name": "envoi_list_managed_files",
            "description": "List the files an owner selected for this agent, including access and revision.",
            "inputSchema": {
              "type": "object",
              "additionalProperties": false
            }
          },
          {
            "name": "envoi_read_managed_file",
            "description": "Read an owner-selected file as base64. Requires current read or edit access.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "fileId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                }
              },
              "required": [
                "fileId"
              ],
              "additionalProperties": false
            }
          },
          {
            "name": "envoi_edit_managed_file",
            "description": "Replace an owner-selected file with malware-scanned base64 content. Requires edit access and the current revision. Use the managed-files REST endpoint for larger files.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "fileId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "contentBase64": {
                  "type": "string",
                  "minLength": 4,
                  "maxLength": 60000
                }
              },
              "required": [
                "fileId",
                "revision",
                "contentBase64"
              ],
              "additionalProperties": false
            }
          },
          {
            "name": "envoi_list_assets",
            "description": "Envoi tool list assets.",
            "inputSchema": {
              "type": "object"
            }
          },
          {
            "name": "envoi_begin_asset_upload",
            "description": "Envoi tool begin asset upload.",
            "inputSchema": {
              "type": "object"
            }
          },
          {
            "name": "envoi_complete_asset_upload",
            "description": "Envoi tool complete asset upload.",
            "inputSchema": {
              "type": "object"
            }
          },
          {
            "name": "envoi_asset_download",
            "description": "Envoi tool asset download.",
            "inputSchema": {
              "type": "object"
            }
          },
          {
            "name": "envoi_grant_asset",
            "description": "Envoi tool grant asset.",
            "inputSchema": {
              "type": "object"
            }
          }
        ]
      }
    }
  },
  "client": {
    "lifecycle": "UNCHANGED",
    "retry": "none",
    "guidance": "none",
    "next": "Call tools only by these names."
  }
}
