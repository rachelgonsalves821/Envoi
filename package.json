{
  "name": "sinaloa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:web": "vite --config vite.config.ts",
    "db:migrate": "node src/migrate.js",
    "waitlist:export": "node scripts/export-waitlist.mjs",
    "build": "npm run typecheck && vite build --config vite.config.ts && npm run build:connectors",
    "build:connectors": "vite build --config integrations/openclaw/quick-connect.vite.config.ts && vite build --config integrations/connector/vite.config.ts && node scripts/package-openclaw.mjs",
    "build:openclaw": "vite build --config integrations/openclaw/quick-connect.vite.config.ts && node scripts/package-openclaw.mjs",
    "typecheck": "tsc --noEmit && tsc -p sdk/typescript/tsconfig.json && tsc -p integrations/tsconfig.json",
    "test:frontend": "vitest run --config vitest.config.ts",
    "test:sdk:typescript": "vitest run --config vitest.sdk.config.ts",
    "test:integrations": "vitest run --config integrations/vitest.config.ts",
    "test:sdk:python": "cd sdk/python && python -m unittest discover -s tests -p test_*.py",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:postgres": "node --test test/postgres-storage.test.js",
    "test:storage:live": "node --test test/object-storage-live.test.js",
    "preflight:config": "node scripts/preflight.mjs",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "cf:config-check": "node scripts/check-deployment.mjs",
    "test:cloudflare": "node --test worker/*.test.js",
    "cf:check": "npm run cf:config-check && npm run test:cloudflare && wrangler deploy --dry-run --containers-rollout=none --env staging && wrangler deploy --dry-run --containers-rollout=none --env beta && wrangler deploy --dry-run --containers-rollout=none --config scanner/wrangler.beta.jsonc",
    "cf:dev": "wrangler dev",
    "cf:deploy": "node -e \"throw new Error('Choose cf:deploy:staging or cf:deploy:beta; an unqualified deploy targets the old production Worker')\"",
    "cf:deploy:staging": "node scripts/deploy-staging.mjs",
    "cf:deploy:beta": "node scripts/deploy-beta-build.mjs",
    "cf:deploy:scanner:beta": "npm run cf:config-check && wrangler deploy --config scanner/wrangler.beta.jsonc"
  },
  "dependencies": {
    "@fontsource-variable/commissioner": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@workos-inc/node": "^10.14.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "lucide-react": "^1.48.0",
    "otplib": "^13.5.0",
    "pg": "^8.13.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.30.0"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "^5.20260927.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.144.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}
