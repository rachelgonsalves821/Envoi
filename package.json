{
  "name": "sinaloa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:web": "vite --config vite.config.ts",
    "db:migrate": "node src/migrate.js",
    "build": "npm run typecheck && vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p sdk/typescript/tsconfig.json",
    "test:frontend": "vitest run --config vitest.config.ts",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:postgres": "node --test test/postgres-storage.test.js",
    "test:cloudflare": "node --test worker/*.test.js",
    "cf:check": "npm run test:cloudflare && wrangler deploy --dry-run --containers-rollout=none",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/commissioner": "^5.3.0",
    "@workos-inc/node": "^10.14.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "lucide-react": "^1.48.0",
    "otplib": "^13.5.0",
    "pg": "^8.13.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.30.0"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "^5.20260927.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  }
}
